{
  "name": "accesibilidadprimero-web",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "description": "accesibilidadprimero.com v2 — Astro + Cloudflare Workers",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/itza.mjs && node scripts/sitemap.mjs",
    "arte": "node scripts/svg.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "a11y": "node scripts/a11y.mjs",
    "serve:dist": "node scripts/serve.mjs",
    "teclado": "node scripts/teclado.mjs",
    "contraste": "node scripts/contraste.mjs",
    "verificar": "npm run build && npm run check && npm run tipografia && npm run renglones && npm run geometria && npm run a11y && node scripts/mesa.mjs --prueba && npm run teclado && npm run aparicion && npm run movimiento && npm run formulario && npm run redirecciones && npm run contraste",
    "capturas": "node scripts/capturas.mjs",
    "tipografia": "node scripts/tipografia.mjs",
    "publicar": "npm run verificar && node scripts/publicar.mjs",
    "geometria": "node scripts/geometria.mjs",
    "aparicion": "node scripts/aparicion.mjs",
    "mesa": "node scripts/mesa.mjs",
    "redirecciones": "node scripts/redirecciones.mjs",
    "formulario": "node --experimental-strip-types --no-warnings scripts/formulario.mjs",
    "movimiento": "node scripts/movimiento.mjs",
    "renglones": "node scripts/renglones.mjs"
  },
  "dependencies": {
    "astro": "^7.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "axe-core": "^4.14.0",
    "playwright": "^1.63.0",
    "svgo": "^4.1.0",
    "typescript": "^6.0.3"
  }
}
