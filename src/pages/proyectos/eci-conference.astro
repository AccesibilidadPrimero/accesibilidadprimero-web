---
/* ---------------------------------------------------------------------------
   Caso ECI Conference Madrid 2027 · Figma `Producción · Caso ECI Conference
   2027`: Desktop 2536:2 · Tablet 2620:276 · Móvil 2624:283. Montado el
   29/10/2026.

   Maqueta propia, no la plantilla de [slug].astro: «la maquetación de cada
   caso sale de la lógica del propio proyecto» (casos-una-maqueta-por-
   proyecto). ECI va de hacer navegable lo complejo, así que el caso se
   ordena: etiqueta a la izquierda (280) y contenido a la derecha, y entre
   secciones, la web funcionando en vídeo.

   Lo que NO viene del Figma, por las reglas del sitio:
   · Cabecera, CTA, pie y márgenes: los del sitio (24 al borde, 09/10).
   · Hero: el común (HeroPagina) con la foto de Madrid (13/10 y 23/10).
   · Tipografía: un solo titular grande, el h1 (08/10). Los h2, a tamaño de
     texto. Dos colores: los pies de vídeo en gris del Figma van en negro;
     sobre la banda azul, en el Silk que declara la ficha del proyecto.
   · Accesibilidad: solo el enlace a la declaración del cliente (23/10). La
     tabla WCAG del Figma no se monta.
   · Los vídeos son grabaciones de eciconference2027.com hechas el
     29/10/2026, una por tamaño. Cada uno lleva su control (VideoPausable).
   · El primer vídeo del Figma tenía el rótulo «por confirmar»: es el
     recorrido de la portada de la web, como en Foc i Cor (Johnny, 29/10).
   --------------------------------------------------------------------------- */
import { getEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import HeroPagina from '../../components/HeroPagina.astro';
import CtaLink from '../../components/CtaLink.astro';
import VideoPausable from '../../components/VideoPausable.astro';
import { DEFAULT_LANG } from '../../i18n/config';
import hero from '../../assets/proyectos/eci-conference/hero.jpg';

const p = (await getEntry('proyectos', 'eci-conference'))!;
const d = p.data;

/* Los primeros fotogramas de cada grabación, uno por tamaño. */
const posters = import.meta.glob<{ default: ImageMetadata }>('../../assets/proyectos/eci-conference/video-*.png', { eager: true });
const video = (escena: string) => {
  const f = (formato: string) => {
    const poster = posters[`../../assets/proyectos/eci-conference/video-${escena}-${formato}.png`]?.default;
    if (!poster) throw new Error(`Caso ECI: falta el póster video-${escena}-${formato}.png`);
    return { archivo: `/video/eci-conference/${escena}-${formato}.mp4`, poster };
  };
  return { escritorio: f('escritorio'), tableta: f('tableta'), movil: f('movil') };
};
/* En tablet y móvil las grabaciones son verticales: 360 y 280 de ancho,
   centradas, como la portada de Foc i Cor. */
const vertical = { tableta: '360px', movil: '280px' };

const datos = [
  ['Fechas', '31 marzo – 2 abril 2027'],
  ['Sede', 'ICOMEM, Madrid'],
  ['Organizan', 'Eurlyaid y AEIPI'],
  ['Público', 'Profesionales, investigadores, familias'],
];
---

<Base
  lang={DEFAULT_LANG}
  current="proyectos"
  title={`${d.titulo} · Proyectos · Accesibilidad Primero`}
  description={d.resumen.replace(/\s+/g, ' ')}
  ctaTitulo={"Hacer simple lo complejo\ntambién es accesibilidad."}
>
  <div class="eci" style={`--acento: ${d.paleta.acento}; --texto-acento: ${d.paleta.textoSobreAcento}; --anillo-acento: ${d.paleta.anilloFoco};`}>
    <HeroPagina
      titulo="Hacer de la complejidad una experiencia intuitiva."
      golpes={['Hacer de la complejidad', 'una experiencia intuitiva.']}
      texto={['ECI Conference Madrid 2027 · Caso de estudio']}
      foto={hero}
    />

    {/* Los datos del congreso desde el primer scroll. El <h2> no está en el
        Figma: es invisible y solo sirve para saltar a ellos por encabezados. */}
    <section class="datos" aria-labelledby="datos">
      <h2 id="datos" class="sr-only">Datos del congreso</h2>
      <dl class="datos__lista">
        {datos.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </section>

    <section class="bloque" aria-labelledby="proyecto">
      <h2 id="proyecto" class="bloque__etiqueta">El proyecto</h2>
      <div class="bloque__contenido">
        <p>ECI Conference reúne a profesionales, investigadores y familias de Europa para compartir conocimiento y avanzar en torno a la intervención temprana en la infancia.</p>
        <p>Detrás de esos días de encuentro hay una enorme cantidad de información, decisiones y recorridos digitales.</p>
        <p>Nuestro trabajo fue convertir toda esa complejidad en un sistema claro y accesible.</p>
      </div>
    </section>

    {/* La portada de la web, recorrida de arriba abajo, sobre el rojo del
        Figma (#c0392b, 5,4:1 con el Silk del control). */}
    <div class="banda banda--roja">
      <VideoPausable
        class="video video--portada"
        {...video('portada')}
        alt="Recorrido por la portada de eciconference2027.com de arriba abajo: la foto nocturna de Madrid con el lema «Growing together: innovation, equity and community», la bienvenida al congreso, los seis motivos para asistir, las cinco líneas temáticas del programa, las ponencias principales, la trayectoria de las ediciones anteriores, las tarifas y la convocatoria de abstracts, la sede en el Colegio de Médicos de Madrid, las preguntas frecuentes y el formulario de contacto."
        nombre="portada de eciconference2027.com"
        lang={DEFAULT_LANG}
        sizes={{ escritorio: '(min-width: 1440px) 1148px, 80vw', ...vertical }}
      />
    </div>

    <section class="bloque" aria-labelledby="reto">
      <p class="bloque__etiqueta">El reto</p>
      <div class="bloque__contenido">
        <h2 id="reto">Mucha información. Muchos perfiles. Un sistema claro.</h2>
        <p>Un congreso internacional empieza mucho antes de abrir sus puertas. Hay que reunir inscripciones, tarifas, abstracts, ponencias, horarios, espacios e información práctica. Y ofrecerla a personas con perfiles y necesidades diferentes, mientras los contenidos se actualizan a medida que se acerca la fecha.</p>
        <p>El reto estaba en ayudar a cada persona a encontrar y comprender la información que necesita.</p>
        <p>Por eso empezamos por ordenar los contenidos, definir jerarquías y crear recorridos claros. Así, cada persona puede orientarse por la web y acceder a la información del congreso de forma sencilla.</p>
      </div>
    </section>

    <figure class="pieza pieza--derecha">
      <VideoPausable
        class="video"
        {...video('ponentes')}
        alt="La página de ponentes: el carrusel de las ponencias principales avanza y se abre la ficha de uno de los ponentes, con el título de su ponencia, su foto y su biografía, que se recorre antes de cerrarla."
        nombre="Keynote speakers"
        lang={DEFAULT_LANG}
        sizes={{ escritorio: '(min-width: 1440px) 660px, 46vw', ...vertical }}
      />
      <figcaption>Keynote speakers</figcaption>
    </figure>

    <figure class="pieza pieza--centro">
      <VideoPausable
        class="video"
        {...video('tracks')}
        alt="Las cinco líneas temáticas del programa en tarjetas de color. Se abre la primera, «Families, participation and natural environments», con su descripción; se cierra y se abre la tercera, «Quality, evidence and transdisciplinary practice»."
        nombre="Programme tracks"
        lang={DEFAULT_LANG}
        sizes={{ escritorio: '(min-width: 1440px) 896px, 62vw', ...vertical }}
      />
      <figcaption>Programme tracks</figcaption>
    </figure>

    <section class="bloque" aria-labelledby="simplificar">
      <p class="bloque__etiqueta">Simplificar</p>
      <div class="bloque__contenido">
        <h2 id="simplificar">La simplicidad y la complejidad se necesitan entre sí.</h2>
        <p>Revisamos el contenido, agrupamos necesidades y construimos una arquitectura que permite avanzar de lo general a lo concreto. Cada página intenta responder primero a una necesidad y después navegar al siguiente paso.</p>
        <p>La mayor parte del trabajo no estuvo en añadir. Estuvo en simplificar.</p>
      </div>
    </section>

    {/* El selector de tarifas, sobre el azul del congreso. El texto va en el
        Silk que declara la ficha (paleta.textoSobreAcento, validado en build). */}
    <div class="banda banda--acento" data-campo-color>
      <figure class="pieza pieza--banda">
        <VideoPausable
          class="video"
          {...video('tarifas')}
          alt="El selector de tarifas de la web: se elige el perfil profesional, después un país de renta alta, y aparecen solo las tarifas que corresponden, con la inscripción anticipada a 380 €, la general a 440 € y los talleres previos a 65 €."
          nombre="Conference fee"
          lang={DEFAULT_LANG}
          sizes={{ escritorio: '(min-width: 1440px) 851px, 60vw', ...vertical }}
        />
        <figcaption>Conference fee</figcaption>
      </figure>
    </div>

    <section class="bloque" aria-labelledby="tarifas">
      <p class="bloque__etiqueta">Sistema de tarifas</p>
      <div class="bloque__contenido">
        <h2 id="tarifas">En lugar de publicar los precios, el flujo comienza preguntando quién eres.</h2>
        <p>El sistema de tarifas era uno de los puntos más complejos del congreso. Las distintas combinaciones de perfiles y condiciones habían provocado dificultades en ediciones anteriores.</p>
        <p>En lugar de trasladar esa complejidad a las personas mediante una gran tabla de precios, cambiamos la lógica. A partir de una primera elección, el sistema acompaña a cada persona por las opciones que le corresponden, elimina las que no son relevantes y termina mostrando la tarifa adecuada.</p>
        <p>Una decisión aparentemente sencilla que transforma una tabla compleja en un recorrido comprensible. Cuando la persona sabe qué inscripción necesita, el proceso continúa en Weeztix para formalizarla.</p>
      </div>
    </section>


    <section class="bloque" aria-labelledby="abstracts">
      <p class="bloque__etiqueta">Abstracts</p>
      <div class="bloque__contenido">
        <h2 id="abstracts">Creamos «AA Accessible Abstracts», una plataforma accesible para enviar y gestionar los abstracts del congreso.</h2>
        <p>Enviar un abstract y seguir su proceso forma parte de la experiencia del congreso, igual que consultar el programa o comprar una entrada.</p>
        <p>Por eso desarrollamos una plataforma específica para ECI e incorporamos la accesibilidad en cada paso. Su diseño sigue la misma lógica que el resto del ecosistema: claridad, sencillez y una experiencia coherente.</p>
        <p>La accesibilidad acompaña a las personas durante todo el recorrido, también cuando pasan de la web a otra plataforma.</p>
      </div>
    </section>

    <div class="pieza pieza--ancha">
      <VideoPausable
        class="video"
        {...video('abstracts')}
        alt="La convocatoria de abstracts, con las fechas de envío y la guía para autores, y después el formulario de envío de la plataforma de abstracts recorrido de arriba abajo: título, tipo de envío, línea temática, resumen, palabras clave, autores y el botón de enviar."
        nombre="el envío de un abstract"
        lang={DEFAULT_LANG}
        sizes={{ escritorio: '(min-width: 1440px) 1392px, calc(100vw - 48px)', ...vertical }}
      />
    </div>

    <section class="bloque" aria-labelledby="modular">
      <p class="bloque__etiqueta">Un sistema modular</p>
      <div class="bloque__contenido">
        <h2 id="modular">Diseñamos para que la web pueda crecer con el congreso.</h2>
        <p>La web se publica antes de que esté disponible toda la información. Los perfiles de ponentes, los abstracts, los contenidos y el programa se incorporan a medida que se confirman.</p>
        <p>Por eso creamos un sistema modular que permite añadir y organizar nuevos contenidos sin rediseñar la web cada vez.</p>
        <p>La experiencia puede evolucionar con el congreso: acompañar a quienes empiezan a planificar su participación meses antes y adaptarse a las necesidades de quienes consultan la información durante el evento, siempre desde una misma base.</p>
      </div>
    </section>

    {/* Accesibilidad: solo el enlace a la declaración del cliente (23/10). */}
    {d.nota?.declaracion && (
      <p class="declaracion">
        <CtaLink href={d.nota.declaracion}><span class="linea">Declaración de accesibilidad</span> <span class="linea">de {d.titulo}</span></CtaLink>
      </p>
    )}
  </div>
</Base>

<style>
  p, h2, dl, dd, figure { margin: 0; }
  h2 { font-size: inherit; line-height: inherit; font-weight: 400; }

  /* ---- Datos ---- en franja, como la ficha de Foc i Cor. */
  .datos { padding: var(--space-48) var(--gutter-page); }
  .datos__lista { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-24); }
  .datos__lista > div { display: flex; flex-direction: column; gap: var(--space-4); }
  @media (min-width: 768px) { .datos__lista { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-32) var(--space-24); } }
  @media (min-width: 1024px) { .datos__lista { grid-template-columns: 293fr 233fr 252fr 494fr; } }

  /* ---- Bloques de texto ---- la etiqueta encima en tablet y móvil; desde
     1024, a la izquierda en su columna de 280 y el contenido a 96. En «El
     proyecto» no hay título, así que la etiqueta ES el h2. */
  .bloque {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-24);
    padding: var(--space-64) var(--gutter-page);
  }
  .bloque__contenido { display: flex; flex-direction: column; gap: var(--space-24); max-width: 968px; }
  @media (min-width: 768px) { .bloque { padding-block: var(--space-96); } }
  @media (min-width: 1024px) { .bloque { grid-template-columns: 280px minmax(0, 1fr); gap: var(--space-96); } }

  /* ---- Vídeos ---- */
  .eci :global(.video) { width: min(280px, 100%); }
  @media (min-width: 768px) { .eci :global(.video) { width: 360px; } }
  .pieza { display: flex; flex-direction: column; align-items: center; gap: var(--space-8); padding: var(--space-48) var(--gutter-page); }
  .pieza figcaption { display: flex; flex-direction: column; width: min(280px, 100%); }
  @media (min-width: 768px) { .pieza figcaption { width: 360px; } }
  @media (min-width: 1024px) {
    .pieza--derecha { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-24); align-items: start; }
    .pieza--derecha > :global(*) { grid-column: 2; }
    .pieza--derecha :global(.video), .pieza--derecha figcaption { width: 100%; }
    .pieza--centro :global(.video), .pieza--centro figcaption { width: min(896px, 100%); }
    .pieza--banda :global(.video), .pieza--banda figcaption { width: min(851px, 100%); }
    .pieza--ancha :global(.video) { width: 100%; }
  }

  /* Las bandas de color, de borde a borde. */
  .banda { display: grid; place-items: center; padding: var(--space-48) var(--gutter-page); }
  .banda--roja { background: #c0392b; color: var(--silk); --focus-ring: var(--silk); }
  .banda--acento { background: var(--acento); color: var(--texto-acento); --focus-ring: var(--anillo-acento); }
  .banda .pieza { padding: 0; }
  @media (min-width: 1024px) {
    .banda { padding-block: var(--space-96); }
    .banda--roja :global(.video--portada) { width: min(1148px, 85%); }
  }

  /* Centrada y en dos líneas (Johnny, 29/10/2026). */
  .declaracion { display: block; max-width: none; padding: var(--space-64) var(--gutter-page); text-align: center; }
  .declaracion :global(.linea) { display: block; }

  /* El titular en dos líneas: «Hacer de la complejidad / una experiencia
     intuitiva.» (Johnny, 29/10/2026). */
  .eci :global(.apertura__titulo .golpe:first-child) { display: block; inline-size: fit-content; }
  @media (min-width: 768px) { .declaracion { padding-block: var(--space-96); } }
</style>
