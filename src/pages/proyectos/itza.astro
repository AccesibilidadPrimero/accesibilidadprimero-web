---
/* ---------------------------------------------------------------------------
   Caso Itza · el segundo caso de un producto propio (04/11/2026)

   La misma maqueta y el mismo tono que A11y Primero y los casos de clientes
   (Johnny, 04/11/2026). El contenido sale de la landing de Itza
   (ITZA/LAnding Itza/index.html y ITZA_PROYECTO.md), reescrito en la voz de
   los casos: qué hicimos y por qué.

   Las capturas son el widget de verdad (el de la landing, con su HTML, CSS
   y JS) montado sobre esta misma web, como en A11y Primero: no se enseña la
   web de un cliente. Las respuestas del asistente son de ejemplo, servidas
   sin llamar al servicio real; las preguntas sugeridas son las que tendría
   esta web. Lo dice el propio caso.

   VÍDEOS (Johnny, 04/11/2026: «explicar bien la experiencia simulando
   consultas»): el hero, las preguntas sugeridas y el contacto al cerrar son
   grabaciones del widget con una persona ficticia (Marta) que escribe y
   pulsa. El hero arranca solo, una vez, con botón de pausa (dura 13 s); los
   otros dos, como en todos los casos, los arranca quien mira.

   Off Escuela sale nombrada, sin captura: el widget se está instalando allí
   y todavía no está activo (Johnny, 04/11/2026).
   --------------------------------------------------------------------------- */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CierreProyecto from '../../components/CierreProyecto.astro';
import Base from '../../layouts/Base.astro';
import HeroPagina from '../../components/HeroPagina.astro';
import CtaLink from '../../components/CtaLink.astro';
import { DEFAULT_LANG } from '../../i18n/config';
import VideoPausable from '../../components/VideoPausable.astro';
import movil from '../../assets/proyectos/itza/movil.jpg';
import posterHero from '../../assets/proyectos/itza/itza-hero-fotograma.png';
import posterSugerencias from '../../assets/proyectos/itza/itza-sugerencias-fotograma.png';
import posterContacto from '../../assets/proyectos/itza/itza-contacto-fotograma.png';
const video = (n: string, poster: ImageMetadata) => ({ escritorio: { archivo: `/video/itza-${n}.mp4`, poster } });

const titulo = 'Itza';
const datos = [
  ['Producto', 'Asistente accesible'],
  ['Año', '2026'],
  ['Rol', 'Desarrollo'],
  ['Estándar', 'WCAG 2.2 A/AA'],
];
const anchos = (w: number, lista: number[]) => [...lista.filter((x) => x < w), w];
---

<Base
  lang={DEFAULT_LANG}
  current="proyectos"
  title={`${titulo} · Proyectos · Accesibilidad Primero`}
  description="Itza, el asistente accesible de Accesibilidad Primero: responde las preguntas de quienes visitan la web de una organización, con teclado, voz y lector de pantalla."
>
  <div class="itza">
    <HeroPagina
      titulo="Ninguna pregunta sin respuesta."
      golpes={['Ninguna pregunta', 'sin respuesta.']}
      texto={['Itza · Caso de estudio']}
      superficie={{ fondo: 'var(--mint-video)', foco: 'var(--blue-ap)' }}
    >
      <VideoPausable
        slot="ilustracion"
        class="itza-hero"
        auto
        {...video('hero', posterHero)}
        alt="Una consulta en Itza: Marta pulsa la barra “Pregúntame lo que necesites”, se abre la ventana y el asistente le pregunta cómo llamarla. Escribe “Me llamo Marta”, elige la pregunta sugerida “¿Hacéis auditorías de accesibilidad?” y el asistente responde que auditamos la web con WCAG 2.2 y la normativa vigente, explicamos cada barrera, damos un plan para quitarlas y preparamos la declaración de accesibilidad."
        nombre="la consulta de Marta"
        lang={DEFAULT_LANG}
        sizes={{ escritorio: '400px', tableta: '330px', movil: '286px' }}
      />
    </HeroPagina>

    <section class="datos" aria-labelledby="datos">
      <h2 id="datos" class="sr-only">Datos del proyecto</h2>
      <dl class="datos__lista">
        {datos.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        <div><dt>Web</dt><dd><CtaLink href="https://itza.accesibilidadprimero.com/">Conocer Itza</CtaLink></dd></div>
      </dl>
    </section>

    <section class="bloque" aria-labelledby="proyecto">
      <h2 id="proyecto" class="bloque__etiqueta">El proyecto</h2>
      <div class="bloque__contenido">
        <p>Itza es un asistente que responde las preguntas de quienes visitan la web de una organización: qué hace, cómo apuntarse, qué horarios tiene, si quedan plazas. Atiende las 24 horas, orienta a cada persona y recoge los datos de quien quiere que le contacten.</p>
        <p>Lo pensamos para asociaciones, fundaciones, centros educativos y proyectos culturales, que suelen responder esas preguntas a mano, una a una. Ahora lo estamos instalando en Off Escuela, la escuela de artes escénicas de Off Valencia.</p>
        <p>Las capturas de esta página son Itza instalado en esta misma web, con una conversación de ejemplo.</p>
      </div>
    </section>

    <figure class="pieza pieza--derecha">
      <Picture
        src={movil}
        formats={['avif', 'webp']}
        widths={[movil.width / 2, movil.width]}
        sizes="(min-width: 768px) 360px, calc(100vw - 48px)"
        alt="La misma conversación en el móvil: la ventana de Itza ocupa casi toda la pantalla, con la respuesta sobre la auditoría, el campo para escribir y la barra con el botón de voz debajo."
        class="captura captura--movil"
        loading="lazy"
      />
      <figcaption>En el móvil</figcaption>
    </figure>

    <section class="bloque" aria-labelledby="reto">
      <p class="bloque__etiqueta">El reto</p>
      <div class="bloque__contenido">
        <h2 id="reto">Un asistente que también sea accesible.</h2>
        <p>Un chat es una ventana que se abre encima de la página. Si no se maneja con teclado, si el lector de pantalla no anuncia las respuestas o si atrapa el foco sin dejar salir, deja fuera justo a quien más ayuda necesita.</p>
        <h3>Por teclado, por voz y con lector de pantalla.</h3>
        <p>Se abre y se cierra con teclado, el foco se queda dentro mientras está abierto y vuelve a su sitio al cerrar. Cada respuesta se anuncia sola, y se puede preguntar hablando y escuchar la respuesta.</p>
      </div>
    </section>

    <figure class="pieza pieza--centro">
      <VideoPausable
        class="captura-video"
        {...video('sugerencias', posterSugerencias)}
        alt="Itza en esta web: Marta pulsa la barra del pie de la página, escribe su nombre y el asistente la saluda y le ofrece cuatro preguntas sugeridas, “¿Qué servicios ofrecéis?”, “¿Hacéis auditorías de accesibilidad?”, “¿Cómo es trabajar con vosotros?” y “Quiero contaros mi proyecto”, que el cursor recorre una a una."
        nombre="las preguntas sugeridas"
        lang={DEFAULT_LANG}
        sizes={{ escritorio: '(min-width: 1440px) 1100px, 76vw', tableta: 'calc(100vw - 48px)', movil: 'calc(100vw - 48px)' }}
      />
      <figcaption>Preguntas sugeridas</figcaption>
    </figure>

    <section class="bloque" aria-labelledby="estructura">
      <p class="bloque__etiqueta">La estructura</p>
      <div class="bloque__contenido">
        <h2 id="estructura">Una barra, una conversación y un contacto.</h2>
        <p>Itza vive en una barra al pie de la página: “Pregúntame lo que necesites”. Al pulsarla se abre la conversación. Primero pregunta cómo llamar a quien escribe y después ofrece preguntas sugeridas, las de cada organización.</p>
        <p>Responde con la información de la propia organización y tiene la instrucción de no inventar datos. Al cerrar, propone dejar nombre y correo, y se puede cerrar sin dejarlos. Si la persona envía sus datos, la conversación se guarda con ellos, para que el equipo sepa qué preguntó y pueda seguir desde ahí.</p>
      </div>
    </section>

    <figure class="pieza pieza--derecha">
      <VideoPausable
        class="captura-video captura-video--ventana"
        {...video('contacto', posterContacto)}
        alt="Al cerrar la conversación, Itza pregunta “¿Te ha sido útil? Déjanos tus datos”. Marta escribe su nombre y su correo, pulsa “Enviar y cerrar” y el asistente le da las gracias y le deja el correo del estudio. También se puede cerrar sin dejar datos."
        nombre="el contacto al cerrar"
        lang={DEFAULT_LANG}
        sizes={{ escritorio: '420px', tableta: '420px', movil: 'calc(100vw - 48px)' }}
      />
      <figcaption>Al cerrar</figcaption>
    </figure>

    <section class="bloque bloque--decisiones" aria-labelledby="decisiones">
      <div class="decisiones__enunciado">
        <h2 id="decisiones">Decisiones de diseño</h2>
        <p>Un asistente útil no sustituye al equipo: responde lo de siempre para que el equipo tenga tiempo para lo demás.</p>
      </div>
      <ul class="decisiones__lista">
        {/* Microanimaciones (Johnny, 04/11/2026): una por decisión, que la
            explica. Dibujadas en HTML y CSS, en tinta y con una sola línea.
            Arrancan al entrar en pantalla, duran menos de 5 s y van UNA vez,
            así que no necesitan botón (2.2.2). Sin JS o con «reducir
            movimiento», el estado final, quieto. `aria-hidden`: lo que
            enseñan ya lo dice el texto de al lado. */}
        <li>
          <div class="micro micro--nombre" aria-hidden="true">
            <span class="m-burbuja m-bot m-1">¿Cómo te llamo?</span>
            <span class="m-burbuja m-yo m-2"><span class="m-escribe">Marta</span></span>
            <span class="m-burbuja m-bot m-3">Hola, Marta.</span>
          </div>
          <h3>Primero, el nombre.</h3>
          <p>La conversación empieza preguntando cómo llamar a quien escribe. El tono es el de alguien de la organización, no el de un formulario.</p>
        </li>
        <li>
          <div class="micro micro--barra" aria-hidden="true">
            <span class="m-pagina"><i></i><i></i><i></i></span>
            <span class="m-boton"><span class="m-boton__texto">Pregúntame lo que necesites</span><span class="m-boton__punto"></span></span>
          </div>
          <h3>Una barra, no un botón flotante.</h3>
          <p>“Pregúntame lo que necesites” dice qué es y para qué sirve antes de pulsarla. Un icono en una esquina obliga a adivinarlo.</p>
        </li>
        <li>
          <div class="micro micro--voz" aria-hidden="true">
            <span class="m-capa m-capa--1"><span class="m-cabecera">Alba</span><span class="m-burbuja m-bot">Hola, soy Alba.</span></span>
            <span class="m-capa m-capa--2"><span class="m-cabecera">Nuri</span><span class="m-burbuja m-bot">Hola, soy Nuri.</span></span>
            <span class="m-capa m-capa--3"><span class="m-cabecera">Itza</span><span class="m-burbuja m-bot">Hola, soy Itza.</span></span>
          </div>
          <h3>Con la voz de cada organización.</h3>
          <p>El nombre del asistente, los colores y el mensaje de bienvenida se adaptan a cada web.</p>
        </li>
        <li>
          <div class="micro micro--instala" aria-hidden="true">
            <span class="m-pagina"><i></i><i></i><i></i></span>
            <span class="m-linea">En línea</span>
            <span class="m-boton m-boton--barra"><span class="m-boton__texto">Pregúntame lo que necesites</span><span class="m-boton__punto"></span></span>
          </div>
          <h3>Lo instalamos nosotros.</h3>
          <p>Sin programadores ni contratos largos: lo dejamos funcionando en la web de la organización.</p>
        </li>
      </ul>
    </section>
  </div>
  <CierreProyecto actual="itza" titulo={titulo} />
</Base>

<script>
  /* Las microanimaciones arrancan al entrar en pantalla, una vez. */
  const micros = document.querySelectorAll<HTMLElement>('.micro');
  const ver = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    // Un respiro para que termine la aparición del bloque.
    setTimeout(() => e.target.classList.add('is-vista'), 500);
    ver.unobserve(e.target);
  }), { threshold: 0.6 });
  micros.forEach((m) => ver.observe(m));
</script>

<style>
  p, h2, h3, dl, dd, figure, ul { margin: 0; }
  ul { padding: 0; list-style: none; }
  h2, h3 { font-size: inherit; line-height: inherit; font-weight: 400; }

  /* ---- Datos ---- en franja, como en los casos de clientes. */
  .datos { padding: var(--space-48) var(--gutter-page); }
  .datos__lista { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-24) var(--space-16); }
  /* En móvil, dos columnas (auditoría de usabilidad, 04/11/2026: la ficha en
     vertical retrasaba la historia). La web, que es un enlace largo, entera. */
  @media (max-width: 767px) { .datos__lista > div:has(a) { grid-column: 1 / -1; } }
  /* La web, en la misma línea base que el resto (Johnny, 05/11/2026), como en
     Foc i Cor: el enlace mide 44 de alto y se come su aire. */
  .datos__lista > div:has(a) dd { margin-block: calc(var(--aire-control) * -1); }
  .datos__lista > div { display: flex; flex-direction: column; gap: var(--space-4); }
  @media (min-width: 768px) { .datos__lista { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-32) var(--space-24); } }
  @media (min-width: 1024px) { .datos__lista { grid-template-columns: repeat(5, minmax(0, 1fr)); } }

  /* ---- Bloques de texto ---- la etiqueta en su columna de 280 desde 1024;
     encima en tablet y móvil. Distancias del 04/11/2026: 48 entre titular y
     texto, 24 entre párrafos, 72 antes de un titular dentro del texto. */
  .bloque {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-48);
    padding: var(--space-64) var(--gutter-page);
  }
  .bloque__contenido { display: flex; flex-direction: column; gap: var(--space-24); max-width: 968px; }
  .bloque__contenido > :is(h2, h3) + * { margin-block-start: var(--space-24); }
  .bloque__contenido > h3 { margin-block-start: var(--space-48); }
  @media (min-width: 768px) { .bloque { padding-block: var(--space-96); } }
  @media (min-width: 1024px) { .bloque { grid-template-columns: 280px minmax(0, 1fr); column-gap: var(--space-96); } }

  /* ---- Decisiones ---- dos columnas desde 1024, como en Izaskun. */
  .decisiones__enunciado { display: flex; flex-direction: column; gap: var(--space-24); }
  .decisiones__enunciado > h2 + * { margin-block-start: var(--space-24); }
  .decisiones__lista { display: flex; flex-direction: column; gap: var(--space-48); }
  .decisiones__lista li { display: flex; flex-direction: column; gap: var(--space-48); }
  .decisiones__lista li > .micro + h3 { margin-block-start: calc(var(--space-24) - var(--space-48)); }

  /* ---- Microanimaciones de las decisiones (04/11/2026) ----
     El estado por defecto es el FINAL: es lo que se ve sin JS y con «reducir
     movimiento». Con JS, la animación se monta en pausa (enseña su primer
     fotograma) y arranca cuando el bloque entra en pantalla. */
  .micro {
    position: relative;
    inline-size: min(100%, 400px);
    block-size: 176px;
    border: 1px solid var(--hairline);
    border-radius: var(--radio);
    overflow: hidden;
    --t: 0s;            /* retraso común, para dejar terminar la aparición */
  }
  /* `!important` en los longhand: el `animation:` de cada pieza los
     reiniciaría. */
  .micro * { animation-fill-mode: both !important; animation-play-state: paused !important; }
  :global(html:not(.js)) .micro * { animation: none !important; }
  .micro.is-vista * { animation-play-state: running !important; }
  @media (prefers-reduced-motion: reduce) { .micro * { animation: none !important; } }

  .m-burbuja {
    position: absolute;
    padding: 6px 14px;
    border-radius: 16px;
    white-space: nowrap;
  }
  .m-bot { background: var(--surface-band); }
  .m-yo { border: 1px solid var(--ink); }
  @keyframes m-entra { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  /* 1 · Primero, el nombre: pregunta, «Marta» se escribe, saludo. */
  .micro--nombre .m-1 { inset-block-start: 16px; inset-inline-start: 16px; animation: m-entra 400ms var(--ease-out) 300ms; }
  .micro--nombre .m-2 { inset-block-start: 66px; inset-inline-end: 16px; animation: m-entra 300ms var(--ease-out) 1100ms; }
  .micro--nombre .m-escribe { display: inline-block; animation: m-teclea 900ms steps(5, end) 1300ms; }
  .micro--nombre .m-3 { inset-block-start: 116px; inset-inline-start: 16px; animation: m-entra 400ms var(--ease-out) 2700ms; }
  @keyframes m-teclea { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }

  /* 2 · Una barra: el botón redondo de la esquina se estira y dice qué es. */
  .m-pagina { position: absolute; inset: 20px 20px auto 20px; display: flex; flex-direction: column; gap: 10px; }
  .m-pagina i { display: block; block-size: 8px; border-radius: 4px; background: var(--hairline); }
  .m-pagina i:nth-child(2) { inline-size: 80%; }
  .m-pagina i:nth-child(3) { inline-size: 55%; }
  .m-boton {
    position: absolute;
    inset-block-end: 16px;
    inset-inline-end: 16px;
    block-size: 44px;
    inline-size: calc(100% - 32px);
    border: 1px solid var(--ink);
    border-radius: 22px;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--white);
  }
  .m-boton__texto { position: absolute; inset-inline-start: 16px; white-space: nowrap; }
  /* El punto, centrado en el círculo de 44 y a la derecha de la barra. */
  .m-boton__punto { position: absolute; inset-inline-end: 15px; inline-size: 12px; block-size: 12px; border-radius: 50%; background: var(--ink); }
  .micro--barra .m-boton { animation: m-estira 1100ms var(--ease-out) 1200ms; }
  .micro--barra .m-boton__texto { animation: m-aparece 500ms var(--ease-out) 2100ms; }
  @keyframes m-estira { from { inline-size: 44px; } to { inline-size: calc(100% - 32px); } }
  @keyframes m-aparece { from { opacity: 0; } to { opacity: 1; } }

  /* 3 · Con la voz de cada organización: tres asistentes, el mismo widget. */
  .m-capa { position: absolute; inset: 0; display: block; }
  .m-cabecera { position: absolute; inset: 0 0 auto 0; block-size: 64px; display: flex; align-items: center; padding-inline: 16px; }
  .m-capa--1 .m-cabecera { background: var(--yellow-ap); }
  .m-capa--2 .m-cabecera { background: var(--rose-ap); }
  .m-capa--3 .m-cabecera { background: var(--mint); }
  .m-capa .m-burbuja { inset-block-start: 84px; inset-inline-start: 16px; }
  .m-capa--1, .m-capa--2 { opacity: 0; }
  .micro--voz .m-capa--1 { animation: m-turno 1500ms linear 300ms; }
  .micro--voz .m-capa--2 { animation: m-turno 1500ms linear 1700ms; }
  .micro--voz .m-capa--3 { animation: m-ultimo 400ms var(--ease-out) 3100ms; }
  @keyframes m-turno { 0% { opacity: 0; } 12% { opacity: 1; } 88% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes m-ultimo { from { opacity: 0; } to { opacity: 1; } }

  /* 4 · Lo instalamos nosotros: la barra llega a la web y queda en línea. */
  .micro--instala .m-boton { animation: m-sube 800ms var(--ease-out) 600ms; }
  .m-linea { position: absolute; inset-block-end: 70px; inset-inline-end: 20px; display: flex; align-items: center; gap: 8px; }
  .m-linea::before { content: ''; inline-size: 8px; block-size: 8px; border-radius: 50%; background: var(--ink); }
  .micro--instala .m-linea { animation: m-entra 400ms var(--ease-out) 1800ms; }
  @keyframes m-sube { from { transform: translateY(80px); } to { transform: none; } }
  @media (min-width: 1024px) {
    .bloque--decisiones { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-64); }
  }

  /* La ventana del hero, más alta que una ilustración (400): a ese tamaño
     la conversación no se leía. Cabe en lo que deja libre el titular. */
  /* Desde el 04/11/2026 es un vídeo: el ancho sale del alto (1032 × 1444). */
  .itza :global(.itza-hero) { --alto: 400px; inline-size: calc(var(--alto) * 1032 / 1444); max-inline-size: 100%; }
  @media (min-width: 768px) { .itza :global(.itza-hero) { --alto: 460px; } }
  @media (min-width: 1024px) { .itza :global(.itza-hero) { --alto: 560px; } }

  /* ---- Capturas ---- con la sombra leve de los vídeos sobre blanco. */
  .itza :global(.captura) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radio);
    box-shadow: 0 1px 3px rgb(23 23 23 / 0.08), 0 8px 24px rgb(23 23 23 / 0.08);
  }
  .pieza { display: flex; flex-direction: column; align-items: center; gap: var(--space-8); padding: var(--space-48) var(--gutter-page); }
  /* El pie, a 60 de la imagen, como en Izaskun (Johnny, 05/11/2026): allí lo
     separa el botón del vídeo; aquí, el aire. Los vídeos ya lo llevan. */
  .pieza > :not(.vp) + figcaption { margin-block-start: calc(var(--space-48) + var(--space-4)); }
  .pieza figcaption { align-self: stretch; }
  /* El móvil, a su tamaño (390 de ancho, capturado a @2x). */
  .itza :global(.captura--movil) { width: min(360px, 100%); }
  .itza :global(.captura--ventana) { width: min(420px, 100%); box-shadow: none; }
  /* Los vídeos, con la misma sombra que las capturas. */
  .itza :global(.captura-video .vp__marco) { border-radius: var(--radio); box-shadow: 0 1px 3px rgb(23 23 23 / 0.08), 0 8px 24px rgb(23 23 23 / 0.08); }
  .itza :global(.captura-video--ventana) { width: min(420px, 100%); }
  .itza :global(.captura-video--ventana .vp__marco) { box-shadow: none; }
  .pieza--derecha figcaption { width: min(420px, 100%); }
  @media (min-width: 1024px) {
    .pieza--derecha { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-24); align-items: start; }
    .pieza--derecha > :global(*) { grid-column: 2; }
    .pieza--centro { padding-inline: calc(12% + var(--gutter-page)); }
  }

</style>
