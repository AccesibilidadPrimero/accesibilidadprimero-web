---
/* ---------------------------------------------------------------------------
   Estudio · Figma `Producción · Estudio` (2674:1080):
   Desktop 2277:2 · Tablet 2657:36 · Móvil 2657:208.

   Mismo sistema que la Home y que Contacto: un cuerpo, un peso, todo en Ink,
   ritmo 128/64, la ® detrás de «Accesibilidad Primero». La única frase en
   `--display` es el titular del hero.

   Los textos son los de escritorio (Johnny, 10/10/2026), con sus
   correcciones de esa noche: «definimos un plan», comillas españolas, y
   Agaya Play fuera de la lista de la Cátedra.

   Lo que NO se ha copiado de la referencia (madebyaran.com/about): allí los
   nombres de bloque son divs; aquí son <h2>, y los servicios, <h3>. Es lo que
   permite recorrer la página por encabezados.
   --------------------------------------------------------------------------- */
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HeroPagina from '../components/HeroPagina.astro';
import Bloque from '../components/Bloque.astro';
import CtaLink from '../components/CtaLink.astro';
import Redes from '../components/Redes.astro';
import { DEFAULT_LANG } from '../i18n/config';
import { conMarca } from '../i18n/marca';
import { CORREO_ESTUDIO } from '../data/contacto';
/* Las dos las compila `npm run arte` desde arte/estudio/. */
import SimboloAnimado from '../components/SimboloAnimado.astro';
import Microanimacion from '../components/Microanimacion.astro';
import type { Tipo } from '../components/Microanimacion.astro';
import retrato from '../assets/estudio/johnny-vigas.jpg';

const lang = DEFAULT_LANG;

const SERVICIOS = [
  {
    nombre: 'Diseño y desarrollo web accesible.',
    mic: 'medida' as Tipo,
    color: 'rosa' as const,
    texto: 'Diseñamos y desarrollamos webs del concepto al código, con WCAG 2.2 AA como referencia mínima. Es lo que hacemos cada día.',
  },
  {
    nombre: 'Auditorías de accesibilidad.',
    mic: 'jerarquia' as Tipo,
    color: 'amarillo' as const,
    texto: 'Analizamos tu web, identificamos las barreras, te las explicamos y definimos un plan para aplicar las mejoras. Es el primer paso si quieres que tu web actual sea accesible sin diseñarla desde cero.',
  },
  {
    nombre: 'Formación y consultoría.',
    mic: 'dia' as Tipo,
    color: 'verde' as const,
    texto: 'Ayudamos a tu equipo a crear y mantener contenidos y servicios digitales accesibles. Creamos un protocolo para que cada contenido nuevo de tu web sea accesible.',
  },
  {
    nombre: 'Documentos y comunicación inclusiva.',
    mic: 'declaracion' as Tipo,
    color: 'rosa' as const,
    texto: 'Creamos y adaptamos presentaciones y documentos PDF accesibles. Ayudamos a cumplir los requisitos de accesibilidad aplicables a administraciones y proyectos con financiación pública.',
  },
];

/* La barra y el año van pegados a la última palabra con espacios que no se
   parten (U+00A0): en móvil el año bajaba solo al renglón siguiente y la
   barra se quedaba colgando al final del anterior. */
const CATEDRA = [
  ['Exposición “Arte y Metaverso”', 2024],
  ['Aplicación MUCAES UPV', 2025],
  ['Protocolo de actuación ante una emergencia para personas con discapacidad', 2025],
  ['MOOC “Introducción a la IA en la creación artística para personas con discapacidad”', 2026],
  ['Hackathon accesible UPV', 2026],
].map(([t, a]) => `${t}\u00a0|\u00a0${a}`);

/* Organización y, cuando lo hay, el proyecto que hicimos con ella. Sin
   enlaces: no están en el Figma (AGENTS.md §1). */
const ORGANIZACIONES: { nombre: string; proyecto?: string }[] = [
  { nombre: 'CESAL', proyecto: 'Foc i Cor, restaurante escuela en Catarroja' },
  { nombre: 'AEIPI y Eurlyaid', proyecto: 'ECI Conference Madrid 2027' },
  { nombre: 'Izaskun Etxebarria' },
  { nombre: 'Elogio de la línea' },
  { nombre: 'WKND', proyecto: 'GUS, el perro guía' },
];
/* Los productos, nombre y una frase (Johnny, 05/11/2026). */
const PRODUCTOS_ESTUDIO = [
  { nombre: 'Itza', descripcion: 'Un asistente accesible para la web de cada organización.' },
  { nombre: 'A11y Primero', descripcion: 'Una extensión de Chrome que evalúa la accesibilidad de una página.' },
  { nombre: 'Accesible Abstracts', descripcion: 'Una plataforma para gestionar los abstracts de un congreso.' },
];
---

<Base
  lang={lang}
  current="estudio"
  title="Estudio · Accesibilidad Primero"
  description="Estudio de diseño que crea webs y aplicaciones que funcionan, se entienden y representan los valores de quienes están detrás."
>
  <!-- El símbolo de AP, con los cuadrados chispeando una vez (Johnny,
       13/10/2026; antes, la casa). Mismo alto que las ilustraciones de la Home:
       400 · 320 · 240. Decorativo: ver SimboloAnimado.astro. -->
  <HeroPagina
    titulo="Código, diseño y palabra."
    golpes={['Código, diseño', 'y palabra.']}
    enParrafos
    texto={[
      'La forma en que comunicamos construye realidades.',
    ]}
  >
    <SimboloAnimado slot="ilustracion" class="apertura__ilustracion" />
  </HeroPagina>

  <Bloque id="estudio" titulo="Estudio">
    <div class="pila">
      <p>Creamos webs y aplicaciones que funcionan, se entienden y representan los valores de quienes están detrás.</p>
      <p set:html={conMarca('Accesibilidad Primero. Siempre.')} />
      <p>Cada decisión de diseño facilita el acceso o levanta una barrera; invita a participar o excluye. La accesibilidad no es una capa que añadimos al final, sino el principio desde el que pensamos cada proyecto.</p>
    </div>
  </Bloque>

  {/* Sin la banda rosa (03/11/2026): con las microanimaciones, el rosa
      competía con el detalle de diseño y era la única banda de color. */}
  <Bloque id="servicios" titulo="Servicios">
    <ul class="servicios">
      {
        SERVICIOS.map((s) => (
          <li>
            {/* Las microanimaciones de Servicios (03/11/2026), con el color
                de cada servicio. */}
            <Microanimacion tipo={s.mic} color={s.color} />
            <h3 class="servicio__nombre">{s.nombre}</h3>
            <p>{s.texto}</p>
          </li>
        ))
      }
    </ul>
  </Bloque>

  <Bloque id="equipo" titulo="Equipo">
    <div class="pila">
      <p class="equipo__texto" set:html={conMarca('Accesibilidad Primero nació en marzo de 2026. Somos un estudio pequeño: hablas directamente con quien diseña y desarrolla tu web.')} />
      <div class="persona">
        <!-- El nombre va al lado, así que el `alt` no lo repite: dice lo que
             la foto añade. -->
        <Picture
          src={retrato}
          formats={['avif', 'webp']}
          widths={[178, 356]}
          sizes="178px"
          width={178}
          height={206}
          alt="Retrato: sonríe a cámara, con gafas de pasta negras, barba y chaqueta oscura, ante un fondo gris azulado."
          class="persona__foto"
        />
        {/* `libre`: al lado de la foto, a 320 px la columna mide unos 70 px y
            ni «Johnny Vigas» ni «y director creativo.» caben unidos
            (src/lib/particulas.ts). */}
        <div class="persona__datos" data-renglones="libre">
          <p>Johnny Vigas</p>
          <p><span class="linea">Fundador</span> <span class="linea">y director creativo.</span></p>
        </div>
      </div>
    </div>
  </Bloque>

  <Bloque id="catedra" titulo="Cátedra dicaTIC">
    <div class="pila">
      <p>Participamos en la dirección de la Cátedra dicaTIC de Brecha Digital y Discapacidad de la Universitat Politècnica de València. Desde allí impulsamos proyectos de diseño, tecnología y accesibilidad digital como estos:</p>
      <ul class="filas">
        {CATEDRA.map((p) => <li class="fila">{p}</li>)}
      </ul>
    </div>
  </Bloque>

  <Bloque id="organizaciones" titulo="Organizaciones y proyectos" fondo="gris">
    <ul class="filas filas--cerradas">
      {
        ORGANIZACIONES.map((o) => (
          <li class="fila fila--organizacion">
            <span>{o.nombre}</span>
            {o.proyecto && <span>{o.proyecto}</span>}
          </li>
        ))
      }
    </ul>
    {/* Los productos del estudio, con la misma fila (Johnny, 05/11/2026). */}
    <h3 class="organizaciones__subtitulo">Productos</h3>
    <ul class="filas filas--cerradas">
      {
        PRODUCTOS_ESTUDIO.map((o) => (
          <li class="fila fila--organizacion">
            <span>{o.nombre}</span>
            <span>{o.descripcion}</span>
          </li>
        ))
      }
    </ul>
  </Bloque>

  <Bloque id="contacto-estudio" titulo="Contacto">
    <div class="pila pila--contacto">
      {/* El <wbr> deja partir el correo después de la arroba: sin espacios, a
          320 no cabe en una línea (1.4.10). */}
      <CtaLink href={`mailto:${CORREO_ESTUDIO}`}>proyectos@<wbr>accesibilidadprimero.com</CtaLink>
      <Redes />
    </div>
  </Bloque>
</Base>

<style>
  /* «Productos» dentro de Organizaciones: 72 antes de un titular dentro del
     texto y 24 hasta la lista (el ritmo de Estudio). */
  .organizaciones__subtitulo { margin: calc(var(--space-48) + var(--space-24)) 0 var(--space-24); font-size: inherit; line-height: inherit; font-weight: 400; }
  /* El correo, en la misma línea base que «Contacto» (Johnny, 04/11/2026). El
     enlace mide 44 de alto (zona táctil) con el texto centrado, así que su
     renglón caía 10 px más abajo que el del título. Se sube esa diferencia;
     la zona táctil no cambia. En móvil van apilados y no hace falta. */
  @media (min-width: 1024px) {
    .pila--contacto > :global(.cta:first-child) { margin-block-start: calc((var(--texto-leading) - var(--touch-min)) / 2); }
  }
  /* El titular: en una línea en escritorio y tableta; en móvil, partido
     antes de «y palabra» (Johnny, 03/11/2026). El golpe lo declara
     HeroPagina, de ahí el :global (AGENTS.md §6). */
  @media (max-width: 767px) {
    :global(.apertura__titulo .golpe:first-child) { display: block; inline-size: fit-content; }
  }
  p { margin: 0; }
  ul { margin: 0; padding: 0; list-style: none; }
  .linea { display: block; }

  /* Párrafos y piezas de un bloque: 24 entre ellos (Figma, «Contenido»). */
  .pila { display: flex; flex-direction: column; gap: var(--space-24); max-width: 888px; }
  .pila--contacto { align-items: flex-start; }

  /* Servicios: 16 entre su nombre y su texto, 48 entre servicio y servicio
     (Johnny, 14/10/2026). El nombre va al mismo cuerpo que el texto, así que
     lo separa el espacio: 16 se nota frente al interlineado y el de fuera es
     el triple, para que cada nombre se lea pegado a su texto (AGENTS.md §4).
     Se probó 32 / 64 y el nombre se quedaba suelto: la lista se leía como
     ocho trozos y no como cuatro servicios.
     El nombre es un <h3> pintado como el cuerpo: el nivel lo da el marcado. */
  /* Intermedio (Johnny, 04/11/2026): 24 del nombre a su texto (era 16) y 72
     entre punto y punto (era 48): el triple, la regla de proximidad
     (AGENTS.md §4). En los casos es 48; aquí los puntos son cortos y 48 los
     partía en dos. */
  .servicios { display: flex; flex-direction: column; gap: calc(var(--space-24) * 3); max-width: 888px; }
  .servicios li { display: flex; flex-direction: column; gap: var(--space-24); }
  .servicio__nombre { margin: 0; font-size: inherit; line-height: inherit; font-weight: 400; }

  /* Equipo: el texto a la medida común (52ch; 718 en el Figma) y la persona 24 más abajo (48 en total, como en
     el Figma). Foto de 178 × 206 y, 24 a su derecha, nombre y cargo. */
  .equipo__texto { max-width: var(--measure); }   /* antes 718 (Figma); la medida común manda, 14/10 */
  .persona { display: flex; align-items: flex-start; gap: var(--space-24); padding-block-start: var(--space-24); }
  .persona__datos { display: flex; flex-direction: column; gap: var(--space-8); }
  /* El hijo flex es el <picture> que pone Astro, no el <img>: sin esto se
     encoge y a 390 la foto se quedaba en 176 de ancho. */
  .persona :global(picture) { flex: 0 0 auto; }
  .persona :global(.persona__foto) {
    display: block;
    inline-size: 178px;
    block-size: 206px;
    flex: 0 0 auto;
    object-fit: cover;
    border: 1px solid var(--rule);
  }

  /* Listas con filete: 16 arriba y abajo, filete fino encima de cada fila
     (decorativo: la lista ya la anuncia el marcado). La de organizaciones
     cierra también por abajo. */
  .fila { padding-block: var(--space-16); border-block-start: 1px solid var(--rule); }
  .filas--cerradas .fila:last-child { border-block-end: 1px solid var(--rule); }

  /* Organizaciones: nombre y proyecto en dos columnas alineadas (296 en
     escritorio, 240 en tableta); en móvil, uno debajo del otro. */
  .fila--organizacion { display: grid; grid-template-columns: minmax(0, 1fr); row-gap: var(--space-4); max-width: 888px; }
  @media (min-width: 768px) {
    .fila--organizacion { grid-template-columns: 240px minmax(0, 1fr); column-gap: var(--space-24); }
  }
  @media (min-width: 1024px) {
    .fila--organizacion { grid-template-columns: 296px minmax(0, 1fr); }
  }
</style>
