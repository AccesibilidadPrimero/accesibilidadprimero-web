---
/* ---------------------------------------------------------------------------
   Artículo del Blog · Figma `Producción · Blog · Artículo` (3334:200):
   Desktop 3334:323 · Tablet 3334:559 · Móvil 3334:786.

   El sistema de la Home: un cuerpo, un peso, todo en Ink. Los h2 y h3 del
   artículo van a cuerpo de texto y se separan por espacio (64 antes de cada
   h2, 32 antes de cada h3): la jerarquía la lleva el marcado.

   Desde escritorio el texto va en la columna de contenido de Bloque (a 456
   de 1392 del margen, 888 de ancho), para que el artículo caiga en la misma
   rejilla que Estudio y las legales.

   Los enlaces DENTRO de un párrafo son la única excepción a los 44 px de la
   web: un enlace en mitad de una frase mide lo que mide la línea. Es la
   excepción «en línea» de 2.5.8, y `npm run a11y` la aplica solo dentro de
   `.prosa` y solo a enlaces en línea (AGENTS.md §4).
   --------------------------------------------------------------------------- */
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import HeroPagina from '../../components/HeroPagina.astro';
import TarjetaArticulo from '../../components/TarjetaArticulo.astro';
import { DEFAULT_LANG } from '../../i18n/config';
import { CATEGORIAS, fechaLarga } from '../../data/blog';

export async function getStaticPaths() {
  const todos = (await getCollection('blog')).sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());
  return todos.map((articulo) => {
    /* «Sigue leyendo»: tres, primero los que comparten categoría, después los
       más recientes. Siempre tres distintos y nunca el propio. */
    const otros = todos.filter((a) => a.id !== articulo.id);
    const comparten = otros.filter((a) => a.data.categorias.some((c) => articulo.data.categorias.includes(c)));
    const relacionados = [...comparten, ...otros.filter((a) => !comparten.includes(a))].slice(0, 3);
    return { params: { slug: articulo.id }, props: { articulo, relacionados } };
  });
}

const { articulo, relacionados } = Astro.props;
const { Content } = await render(articulo);
const d = articulo.data;
const nota = `${fechaLarga(d.fecha)} · ${d.categorias.map((c) => CATEGORIAS[c]).join(', ')}`;
---

<Base
  lang={DEFAULT_LANG}
  current="blog"
  title={`${d.tituloSeo ?? d.titulo} · Accesibilidad Primero`}
  description={d.descripcion}
>
  <HeroPagina volver={{ href: '/blog/', texto: 'Volver al Blog' }} titulo={d.titulo} texto={[d.descripcion]} nota={nota} />

  <div class="articulo">
    <div class="articulo__columna">
      <Picture
        src={d.imagen}
        alt={d.imagenAlt}
        formats={['avif', 'webp']}
        widths={[400, 900, 1800]}
        sizes="(min-width: 1440px) 888px, (min-width: 1024px) 62vw, 100vw"
        class="articulo__portada"
      />
      <div class="prosa">
        <Content />
      </div>
    </div>
  </div>

  <section class="sigue" aria-labelledby="sigue-titulo">
    <h2 id="sigue-titulo" class="sigue__titulo">Sigue leyendo</h2>
    <ul class="sigue__rejilla">
      {relacionados.map((a) => (
        <li>
          <TarjetaArticulo href={`/blog/${a.id}/`} titulo={a.data.titulo} fecha={a.data.fecha} imagen={a.data.imagen} nivel={3} />
        </li>
      ))}
    </ul>
  </section>
</Base>

<script>
  import '../../scripts/demos';
</script>

<style>
  .articulo { padding: var(--ritmo-seccion) var(--gutter-page) 0; }
  .articulo__columna { display: flex; flex-direction: column; gap: var(--space-64); }
  @media (min-width: 1024px) {
    .articulo__columna { margin-inline-start: calc(456 / 1392 * 100%); max-width: 888px; }
  }
  .articulo :global(.articulo__portada) {
    display: block; width: 100%; height: auto; aspect-ratio: 2 / 1; object-fit: cover; border-radius: var(--radio);
  }

  /* ---- El texto del artículo (viene del Markdown: de ahí los :global) ---- */
  .prosa { display: flex; flex-direction: column; gap: var(--space-24); }
  .prosa :global(:is(h2, h3, h4)) { margin: 0; font-size: var(--texto-size); line-height: var(--texto-leading); font-weight: 400; }
  /* EL TEXTO, CENTRADO BAJO LA IMAGEN (Johnny, 14/10/2026). La columna mide
     888 y la llenan la portada, las imágenes, las tablas y las
     demostraciones; el texto se para en la medida de lectura (52ch) y va
     centrado en ella, con el mismo borde izquierdo en párrafos, títulos y
     listas. `inline-size: 100%`: en una columna flex, el margen automático
     sin ancho haría que cada párrafo midiera lo que su texto. */
  .prosa > :global(:is(p:not(:has(> img, > picture, > video)), h2, h3, h4, ul, ol, blockquote)) {
    inline-size: 100%; max-inline-size: var(--measure); margin-inline: auto;
  }
  .prosa :global(h2) { margin-block-start: calc(var(--space-64) - var(--space-24)); }
  .prosa :global(:is(h3, h4)) { margin-block-start: calc(var(--space-32) - var(--space-24)); }
  .prosa :global(:is(p, ul, ol, blockquote, figure, table)) { margin: 0; }
  .prosa :global(:is(ul, ol)) { padding-inline-start: var(--space-24); display: flex; flex-direction: column; gap: var(--space-8); }
  .prosa :global(blockquote) { padding-inline-start: var(--space-24); border-inline-start: 1px solid var(--text); }
  .prosa :global(code) { font: inherit; }
  .prosa :global(img) { display: block; width: 100%; height: auto; border-radius: var(--radio); }
  /* Un enlace dentro de una frase: subrayado siempre (no es la navegación). */
  .prosa :global(p a) { overflow-wrap: anywhere; }

  .prosa :global(table) { width: 100%; border-collapse: collapse; }
  .prosa :global(:is(th, td)) {
    text-align: start; vertical-align: top; font-weight: 400;
    padding: var(--space-16) var(--space-16) var(--space-16) 0;
    border-block-start: 1px solid var(--rule); overflow-wrap: anywhere;
  }
  .prosa :global(tr:last-child td) { border-block-end: 1px solid var(--rule); }

  /* ---- Demostraciones (artículo de tipografía) ----
     Fondo Silk, como en el Figma. Lo que lleva `data-ejemplo` se pinta a
     propósito con otro tamaño o con otro color: es la muestra. tipografia,
     contraste y a11y lo saben y lo saltan (AGENTS.md §4); lo que explica la
     muestra va siempre en Ink y a cuerpo de texto, y eso sí se mide. */
  .prosa :global(.demo) {
    display: flex; flex-direction: column; gap: var(--space-24);
    padding: var(--space-24); border-radius: var(--radio); background: var(--silk);
  }
  .prosa :global(.demo__columnas) { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-24); }
  @media (min-width: 768px) {
    .prosa :global(.demo__columnas) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .prosa :global(.demo__caja) {
    display: flex; flex-direction: column; gap: var(--space-16);
    padding: var(--space-16); border-radius: var(--radio); background: var(--surface);
  }
  .prosa :global(.demo__lista) { list-style: none; padding: 0; gap: var(--space-16); }
  .prosa :global(.demo__lista li) { display: flex; flex-direction: column; gap: var(--space-4); }
  .prosa :global(.demo__columnas > div > p) { margin-block-end: var(--space-16); }

  .prosa :global(.demo__control) { display: flex; flex-direction: column; gap: var(--space-8); }
  .prosa :global(.demo__control input) { width: 100%; min-height: var(--touch-min); accent-color: var(--text); margin: 0; }

  .prosa :global(.demo__muestra--px) { font-size: 16px; line-height: 1.5; }
  .prosa :global(.demo__muestra--rem) { font-size: 1rem; line-height: 1.5; }
  .prosa :global(.demo__t32) { font-size: 2rem; line-height: 1.2; }
  .prosa :global(.demo__t24) { font-size: 1.5rem; line-height: 1.3; }
  .prosa :global(.demo__t20) { font-size: 1.25rem; line-height: 1.4; }
  .prosa :global(.demo__t16) { font-size: 1rem; line-height: 1.6; }
  .prosa :global(.demo__t14) { font-size: 0.875rem; line-height: 1.5; }
  .prosa :global(.demo__t13) { font-size: 13px; line-height: 1.2; }
  .prosa :global(.demo__t12) { font-size: 12px; line-height: 1.3; }
  .prosa :global(.demo__t11) { font-size: 11px; line-height: 1.4; }
  .prosa :global(.demo__t10) { font-size: 10px; line-height: 1.4; }
  .prosa :global(.demo__c1a1a1a) { color: #1a1a1a; }
  .prosa :global(.demo__c595959) { color: #595959; }
  .prosa :global(.demo__caaaaaa) { color: #aaaaaa; }
  .prosa :global(.demo__cc0c0c0) { color: #c0c0c0; }
  /* En alto contraste del sistema, los grises de muestra se los come el
     navegador: que se vean como lo que son, texto. */
  @media (forced-colors: active) {
    .prosa :global([data-ejemplo]) { color: CanvasText; }
  }

  /* ---- Sigue leyendo ---- */
  .sigue { display: flex; flex-direction: column; gap: var(--ritmo-intro); padding: var(--ritmo-seccion) var(--gutter-page) 0; }
  .sigue__titulo { margin: 0; font-size: var(--texto-size); line-height: var(--texto-leading); font-weight: 400; }
  .sigue__rejilla { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-64) var(--space-24); }
  @media (min-width: 768px) {
    .sigue__rejilla { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* En tableta caben dos: la tercera sobra (Figma 3334:559). */
    .sigue__rejilla > li:nth-child(3) { display: none; }
  }
  @media (min-width: 1024px) {
    .sigue__rejilla { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .sigue__rejilla > li:nth-child(3) { display: block; }
  }
</style>
