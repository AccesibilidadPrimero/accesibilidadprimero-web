---
/* ---------------------------------------------------------------------------
   Una página en lectura fácil. Los textos, en src/data/lectura-facil.ts.

   Revisión 2 (Johnny, 07/11/2026): es el CONTENIDO de la web en lectura
   fácil, no una página sobre la lectura fácil. Como las webs de referencia
   (PAGe, GOV.UK y Mencap en Easy Read):
   · El título dice lo importante y la entrada lo cuenta en 3 a 5 frases.
   · Una frase por párrafo, una sola columna de lectura e interlineado 1,5.
   · La imagen va AL LADO del texto que explica (fila imagen | texto desde
     768; encima, en móvil), nunca de adorno.
   · Los enlaces, en su propia línea (44 px). Al final, las otras páginas y
     la misma página en la web completa.
   · Sin hero a pantalla entera, sin cierre de contacto ni banda de la guía.
   --------------------------------------------------------------------------- */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import CtaLink from '../components/CtaLink.astro';
import { path } from '../i18n/config';
import { idiomaDe } from '../i18n/idioma';
import { PAGINAS_LF, SLUG_LF, UI_LF, EQUIVALENTE, CORREO, type IdLF, type LangLF, type EnlaceLF, type ImagenLF } from '../data/lectura-facil';
import johnny from '../assets/estudio/johnny-vigas.jpg';
import foc from '../assets/proyectos/foc-1.png';
import eci from '../assets/proyectos/eci-1.png';
import izaskun from '../assets/proyectos/izaskun-1.png';
import itza from '../assets/productos/itza.webp';
import a11y from '../assets/productos/a11y-primero.webp';
import abstracts from '../assets/productos/accesible-abstracts.webp';

const IMAGENES: Record<ImagenLF, ImageMetadata> = { johnny, foc, eci, izaskun, itza, a11y, abstracts };

interface Props { id: IdLF }
const { id } = Astro.props;
const lang = idiomaDe(Astro.url) as LangLF;
const ui = UI_LF[lang];
const paginas = PAGINAS_LF[lang];
const pagina = paginas.find((p) => p.id === id)!;
const hrefLF = (i: IdLF) => path('lecturaFacil', lang, SLUG_LF[i][lang]);
const hrefDe = (e: EnlaceLF) => ('lf' in e ? hrefLF(e.lf) : 'ruta' in e ? path(e.ruta, lang) : e.url);

/* Un correo no cabe a 320 sin partirse: puede cortar detrás de la arroba.
   Los nombres en catalán dentro del castellano llevan su idioma (3.1.2). */
const EN_CATALAN = ['Universitat Politècnica de València', 'Foc i Cor'];
const escapar = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const frase = (s: string) => {
  let h = escapar(s).replace('@', '@<wbr>');
  if (lang !== 'ca') for (const n of EN_CATALAN) h = h.replaceAll(n, `<span lang="ca">${n}</span>`);
  if (lang === 'en') h = h.replaceAll('Cátedra dicaTIC', '<span lang="es">Cátedra dicaTIC</span>');
  return h;
};
const ANCHOS = [320, 480, 640, 800];
---

<Base
  lang={lang}
  current="lecturaFacil"
  slug={SLUG_LF[id]}
  conCta={false}
  title={`${pagina.nombre} · ${ui.enlace} · Accesibilidad Primero`}
  description={pagina.descripcion}
>
  <div class="lf">
    <header class="lf__cabeza">
      <h1 class="lf__titulo" set:html={frase(pagina.titulo)} />
      <div class="lf__texto">
        {pagina.entrada.map((t) => t === CORREO
          ? <p class="lf__correo" data-renglones="libre" set:html={frase(t)} />
          : <p set:html={frase(t)} />)}
        {pagina.entradaLista && <ul class="lf__lista">{pagina.entradaLista.map((t) => <li set:html={frase(t)} />)}</ul>}
        {pagina.entradaEnlaces && (
          <ul class="lf__enlaces">
            {pagina.entradaEnlaces.map((e) => <li><CtaLink href={hrefDe(e)}>{e.texto}</CtaLink></li>)}
          </ul>
        )}
      </div>
    </header>

    {
      pagina.bloques.map((b) => {
        const cuerpo = (
          <div class="lf__texto">
            {b.frases?.map((t) => <p set:html={frase(t)} />)}
            {b.lista && <ul class="lf__lista">{b.lista.map((t) => <li set:html={frase(t)} />)}</ul>}
            {b.despues?.map((t) => <p set:html={frase(t)} />)}
            {b.enlaces && (
              <ul class="lf__enlaces">
                {b.enlaces.map((e) => <li><CtaLink href={hrefDe(e)}>{e.texto}</CtaLink></li>)}
              </ul>
            )}
          </div>
        );
        return (
          <section class="lf__bloque">
            {b.titulo && <h2 class="lf__h2" set:html={frase(b.titulo)} />}
            {b.imagen ? (
              <div class="lf__fila">
                <Picture class="lf__img" src={IMAGENES[b.imagen.archivo]} alt={b.imagen.alt} widths={ANCHOS} sizes="(min-width: 768px) 280px, 100vw" formats={['avif', 'webp']} />
                {cuerpo}
              </div>
            ) : cuerpo}
            {b.tarjetas && (
              <ul class="lf__tarjetas">
                {b.tarjetas.map((t) => (
                  <li class="lf__fila">
                    <Picture class="lf__img" src={IMAGENES[t.imagen]} alt={t.alt} widths={ANCHOS} sizes="(min-width: 768px) 280px, 100vw" formats={['avif', 'webp']} />
                    <div class="lf__texto">
                      <h3 class="lf__h3" set:html={frase(t.titulo)} />
                      {t.frases.map((f) => <p set:html={frase(f)} />)}
                    </div>
                  </li>
                ))}
              </ul>
            )}
          </section>
        );
      })
    }

    <nav class="lf__pie" aria-labelledby="lf-otras">
      <h2 id="lf-otras" class="lf__h2">{ui.otras}</h2>
      <ul class="lf__enlaces">
        {paginas.filter((p) => p.id !== id).map((p) => <li><CtaLink href={hrefLF(p.id)}>{p.nombre}</CtaLink></li>)}
      </ul>
      <CtaLink href={path(EQUIVALENTE[id], lang)}>{ui.completa}</CtaLink>
    </nav>
  </div>
</Base>

<style>
  .lf {
    padding: calc(var(--space-48) * 2) var(--gutter-page) var(--ritmo-seccion);
    display: flex;
    flex-direction: column;
    gap: calc(var(--space-24) * 3);
    /* Interlineado 1,5: lo pide la norma de lectura fácil. */
    --lf-leading: 1.5;
    /* Columna de imagen y de texto, iguales en todas las filas. */
    --lf-img: 280px;
  }
  .lf p, .lf li { margin: 0; max-inline-size: var(--measure); line-height: var(--lf-leading); }
  /* Los títulos, en el tamaño grande: la norma pide distinguirlos del texto
     por el tamaño. */
  .lf__titulo, .lf__h2 { margin: 0; font-size: var(--display-size); line-height: var(--display-leading); font-weight: 400; max-inline-size: var(--measure); }
  .lf__h3 { margin: 0; font-size: var(--texto-size); line-height: var(--lf-leading); font-weight: 400; }

  .lf__cabeza, .lf__bloque, .lf__pie { display: flex; flex-direction: column; gap: var(--space-32); }
  .lf__texto { display: flex; flex-direction: column; gap: var(--space-12); min-width: 0; }
  /* El nombre de un proyecto se separa de su texto por el espacio (§4). */
  .lf__h3 { margin-block-end: var(--space-4); }

  .lf__lista { margin: 0; padding-inline-start: 1.2em; display: flex; flex-direction: column; gap: var(--space-8); }
  .lf__enlaces { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-8); }
  .lf__tarjetas { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-48); }

  /* Imagen | texto. En móvil, la imagen encima y a un ancho que no ocupa la
     pantalla entera. */
  .lf__fila { display: flex; flex-direction: column; gap: var(--space-16); position: relative; }
  .lf__fila :global(.lf__img) { display: block; inline-size: min(100%, var(--lf-img)); block-size: auto; border-radius: var(--radio); }
  @media (min-width: 768px) {
    .lf__fila { display: grid; grid-template-columns: var(--lf-img) minmax(0, 1fr); gap: var(--space-32); align-items: start; }
    .lf__fila :global(.lf__img) { inline-size: 100%; }
  }
</style>
