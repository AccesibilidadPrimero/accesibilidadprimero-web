---
/* ---------------------------------------------------------------------------
   Una página en lectura fácil (Johnny, 07/11/2026). Los textos, en
   src/data/lectura-facil.ts, con las reglas de la norma UNE 153101.

   La maqueta también sigue la norma, y por eso se aparta del resto de la web:
   · Sin hero a pantalla entera ni ilustraciones: el título y el texto, lo
     primero que se ve. Es la excepción declarada a los heros (AGENTS.md).
   · Una sola columna, alineada a la izquierda y con interlineado 1,5.
   · Una frase por párrafo: cada una empieza en su propia línea.
   · Las palabras difíciles, al principio, en un recuadro: la palabra en el
     tamaño grande y su explicación con un ejemplo debajo. Sin negrita, que
     la web no tiene (un solo peso).
   · Los enlaces, en su propia línea (44 px), y el índice de las cinco
     páginas al final de cada una, con la actual marcada.
   · Sin el cierre de contacto ni la banda de la guía: aquí serían publicidad
     en medio de un texto que tiene que ser corto.
   --------------------------------------------------------------------------- */
import Base from '../layouts/Base.astro';
import CtaLink from '../components/CtaLink.astro';
import { path } from '../i18n/config';
import { idiomaDe } from '../i18n/idioma';
import { PAGINAS_LF, SLUG_LF, UI_LF, EQUIVALENTE, CORREO, type IdLF, type LangLF, type EnlaceLF } from '../data/lectura-facil';

interface Props { id: IdLF }
const { id } = Astro.props;
const lang = idiomaDe(Astro.url) as LangLF;
const ui = UI_LF[lang];
const paginas = PAGINAS_LF[lang];
const pagina = paginas.find((p) => p.id === id)!;
const slug = SLUG_LF[id];
const hrefLF = (i: IdLF) => path('lecturaFacil', lang, SLUG_LF[i][lang]);
const hrefDe = (e: EnlaceLF) =>
  'lf' in e ? hrefLF(e.lf) : 'ruta' in e ? `${path(e.ruta, lang)}${e.ancla ? `#${e.ancla}` : ''}` : e.url;

/* Un correo no cabe a 320 sin partirse: puede cortar detrás de la arroba. */
const escapar = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
/* Los nombres en catalán dentro del texto castellano llevan su idioma, para
   que el lector de pantalla los pronuncie bien (3.1.2). */
const EN_CATALAN = ['Universitat Politècnica de València', 'Foc i Cor'];
const frase = (s: string) => {
  let h = escapar(s).replace('@', '@<wbr>');
  if (lang === 'es') for (const n of EN_CATALAN) h = h.replace(n, `<span lang="ca">${n}</span>`);
  return h;
};
---

<Base
  lang={lang}
  current="lecturaFacil"
  slug={slug}
  conCta={false}
  title={`${pagina.nombre} · ${ui.enlace} · Accesibilidad Primero`}
  description={pagina.descripcion}
>
  <div class="lf">
    <h1 class="lf__titulo">{pagina.titulo}</h1>

    <div class="lf__aviso">
      {ui.aviso.map((t) => <p>{t}</p>)}
    </div>

    {
      pagina.glosario && (
        <section class="lf__glosario" aria-labelledby="lf-glosario">
          <h2 id="lf-glosario" class="lf__h2">{ui.glosario}</h2>
          <dl>
            {pagina.glosario.map((g) => (
              <div class="lf__termino">
                <dt>{g.palabra}</dt>
                {g.explicacion.map((t) => <dd>{t}</dd>)}
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      pagina.bloques.map((b, i) => (
        <section class="lf__bloque" aria-labelledby={`lf-${i}`}>
          <h2 id={`lf-${i}`} class="lf__h2">{b.titulo}</h2>
          {/* La dirección de correo va sola en su línea; a 320 se parte tras
              la arroba, así que el reparto de renglones no se le aplica. */}
          {b.frases?.map((t) => t === CORREO
            ? <p class="lf__correo" data-renglones="libre" set:html={frase(t)} />
            : <p set:html={frase(t)} />)}
          {b.lista && <ul class="lf__lista">{b.lista.map((t) => <li set:html={frase(t)} />)}</ul>}
          {b.despues?.map((t) => <p set:html={frase(t)} />)}
          {b.enlaces && (
            <ul class="lf__enlaces">
              {b.enlaces.map((e) => <li><CtaLink href={hrefDe(e)}>{e.texto}</CtaLink></li>)}
            </ul>
          )}
        </section>
      ))
    }

    <nav class="lf__indice" aria-labelledby="lf-indice">
      <h2 id="lf-indice" class="lf__h2">{ui.indice}</h2>
      <ul class="lf__enlaces">
        {paginas.map((p) => (
          <li>
            {p.id === id
              ? <a href={hrefLF(p.id)} class="lf__actual" aria-current="page">{p.nombre}</a>
              : <CtaLink href={hrefLF(p.id)}>{p.nombre}</CtaLink>}
          </li>
        ))}
      </ul>
      <CtaLink href={path(EQUIVALENTE[id], lang)}>{id === 'inicio' ? ui.completaInicio : ui.completa}</CtaLink>
    </nav>
  </div>
</Base>

<style>
  .lf {
    padding: calc(var(--space-48) * 2) var(--gutter-page) var(--ritmo-seccion);
    display: flex;
    flex-direction: column;
    gap: var(--space-64);
    /* Interlineado 1,5: lo pide la norma de lectura fácil. */
    --lf-leading: 1.5;
  }
  .lf p, .lf dd, .lf li { margin: 0; max-inline-size: var(--measure); line-height: var(--lf-leading); }
  .lf__titulo, .lf__h2 { margin: 0; font-size: var(--display-size); line-height: var(--display-leading); font-weight: 400; max-inline-size: var(--measure); }
  /* Los títulos, en el tamaño grande: la norma pide que se distingan del
     texto por el tamaño, no solo por el espacio. */

  /* El aviso, en su recuadro: dice qué es esta página antes de empezar. */
  .lf__aviso, .lf__glosario {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding: var(--space-24);
    background: var(--surface-band);
    border-radius: var(--radio);
    max-inline-size: calc(var(--measure) + var(--space-48));
  }
  .lf__glosario { gap: var(--space-32); }
  .lf__glosario dl { margin: 0; display: flex; flex-direction: column; gap: var(--space-32); }
  .lf__termino { display: flex; flex-direction: column; gap: var(--space-8); }
  /* La palabra, más grande que su explicación (la norma: negrita o tamaño
     mayor; aquí, tamaño). */
  .lf__termino dt { font-size: var(--display-size); line-height: var(--display-leading); }

  .lf__bloque, .lf__indice { display: flex; flex-direction: column; gap: var(--space-16); }
  .lf__bloque > .lf__h2, .lf__indice > .lf__h2 { margin-block-end: var(--space-8); }
  .lf__lista { margin: 0; padding-inline-start: 1.2em; display: flex; flex-direction: column; gap: var(--space-8); }
  .lf__enlaces { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-8); }
  /* La página en la que estás: subrayada y sin flecha, como el idioma actual. */
  .lf__actual {
    display: inline-flex; align-items: center; min-block-size: var(--touch-min);
    text-decoration: underline; text-decoration-thickness: var(--underline-rest); text-underline-offset: 5px;
  }

  @media (forced-colors: active) {
    .lf__aviso, .lf__glosario { border: 1px solid CanvasText; }
  }
</style>
