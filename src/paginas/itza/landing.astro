---
/* ---------------------------------------------------------------------------
   Itza · landing de producto en itza.accesibilidadprimero.eu (Johnny,
   07/11/2026).

   Cómo se publica: estas páginas se construyen con la web (src/pages/itza/),
   y `scripts/itza.mjs` las saca de dist/ a dist-itza/, que sirve su propio
   Worker (wrangler.itza.toml + itza-worker/index.ts). En la web de AP no
   existen: /itza/ no se publica.

   SISTEMA DE PRODUCTO, NO EL DE AP (Johnny, 07/11/2026: «la landing de Itza
   es más comercial, de diseño de producto»; dirección A, «Noche menta», con
   un gris oscuro sedoso en lugar de negro). Lo que cambia respecto a la web:
   · fondo #282B2A (casi negro, no negro) y el menta del logo, #C7EAE4;
   · dos pesos, 400 y 500 (la tipografía servida llega a 500: un 600 sería
     negrita sintética) y una escala de producto de cinco tamaños;
   · botones con fondo para la acción principal;
   · la demo de Itza en el hero: el producto es la portada.
   Lo que NO cambia: contraste AA medido (menta sobre el gris, 11:1; el texto
   secundario #D3DCD9, 10:1), objetivos de 44 px, foco visible en menta,
   reducir movimiento, sin texto en imágenes salvo el logo, y la firma de
   Accesibilidad Primero. Es la base de las landings de los tres productos.

   La demo es Itza de verdad, en línea dentro del hero
   (src/scripts/itza-demo.ts): habla con /api/chat, que el Worker pasa a la
   API de Anthropic. Sin JavaScript no hay demo, y se dice.
   --------------------------------------------------------------------------- */
import '../../styles/fonts.css';
import '../../styles/tokens.css';
import '../../styles/base.css';
import logoItza from '../../assets/productos/itza-logo.png';
import logoMenta from '../../assets/productos/itza-logo-menta.png';
import { LANGS, LANG_CODE, LANG_NAME, path, type Lang } from '../../i18n/config';
import { SITIO, INDEXABLE, DOMINIO } from '../../data/sitio';
import { CORREO_ESTUDIO } from '../../data/contacto';
import { ITZA } from './textos';

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = ITZA[lang];

/* Las direcciones de la landing, en su propio dominio. */
const ORIGEN = `https://itza.${DOMINIO}`;
const raiz = (l: Lang) => (l === 'es' ? '/' : `/${l}/`);
const ap = (r: Parameters<typeof path>[0], slug?: string) => new URL(path(r, lang, slug), SITIO).href;

const datos = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Itza',
    description: T.description,
    url: new URL(raiz(lang), ORIGEN).href,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'WordPress',
    inLanguage: lang,
    offers: { '@type': 'Offer', price: '36', priceCurrency: 'EUR', description: `${T.precio} ${T.precioUnidad} ${T.precioIva}` },
    creator: { '@id': `${SITIO}/#estudio`, '@type': 'ProfessionalService', name: 'Accesibilidad Primero' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: lang,
    mainEntity: T.faq.map((q) => ({ '@type': 'Question', name: q.pregunta, acceptedAnswer: { '@type': 'Answer', text: q.respuesta } })),
  },
]).replace(/</g, '\\u003c');

/* EL LOGO CADA VEZ QUE SE NOMBRA ITZA (Johnny, 07/11/2026). Va dentro de la
   frase, a la altura de la letra, con alt="Itza": el lector de pantalla lee
   la frase entera y al ampliar crece con el texto (va en em). Un logotipo es
   la excepción de 1.4.5, la única imagen con letras que entra en la web. El
   logo trae su propia marca (el corazón CC), así que el ® del texto sobra.
   Dos versiones en arte/productos/: en menta sobre el fondo oscuro y en Ink
   sobre el menta y el blanco (la caja del precio y la demo). */
const ALTO_LOGO = 341, ANCHO_LOGO = 968;
const logo = (alt = 'Itza', claro = false) => `<img class="logo-itza" src="${(claro ? logoItza : logoMenta).src}" alt="${alt}" width="${ANCHO_LOGO}" height="${ALTO_LOGO}" />`;
const marca = (s: string) => s.replace(/Itza®?/g, () => logo());
const marcaClara = (s: string) => s.replace(/Itza®?/g, () => logo('Itza', true));
const chat = JSON.stringify({ ...T.chat, lang, voz: lang === 'es' });
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{T.title}</title>
    <meta name="description" content={T.description} />
    {INDEXABLE ? <link rel="canonical" href={new URL(raiz(lang), ORIGEN).href} /> : <meta name="robots" content="noindex" />}
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(raiz(l), ORIGEN).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/', ORIGEN).href} />
    <script type="application/ld+json" set:html={datos} />
    <meta name="color-scheme" content="dark" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="saltar" href="#contenido">{T.saltar}</a>

    <header class="cabeza">
      <a class="cabeza__marca" href={raiz(lang)} set:html={logo(T.inicio)} />
      <div class="cabeza__derecha">
        <nav class="cabeza__idiomas" aria-label={T.idioma}>
          <ul>
            {LANGS.map((l) => (
              <li>
                <a href={raiz(l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>
                  <span aria-hidden="true">{LANG_CODE[l]}</span><span class="sr-only">{LANG_NAME[l]}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <a class="boton boton--menta boton--pequeno" href="#contacto">{T.pedir}</a>
      </div>
    </header>

    <main id="contenido" tabindex="-1">
      <section class="hero" aria-labelledby="hero-titulo">
        <div class="hero__texto">
          <h1 id="hero-titulo" class="t-hero"><span set:html={marca(T.heroL1)} /> <span class="menta" set:html={marca(T.heroL2)} /></h1>
          <p class="suave" set:html={marca(T.heroTexto)} />
          <ul class="botones">
            <li><a class="boton boton--menta" href="#demo" set:html={marcaClara(T.probar)} /></li>
            <li><a class="boton boton--borde" href="#precio">{T.verPrecio}</a></li>
          </ul>
          <p class="firma">{T.firma}</p>
        </div>

        {/* La demo, en línea: el producto es la portada. Sin JS, la página
            explica cómo ver Itza y la caja no se pinta. */}
        <section id="demo" class="demo" aria-labelledby="demo-titulo" data-itza-chat={chat}>
          <div class="demo__cabeza">
            <h2 id="demo-titulo"><span set:html={logo('Itza', true)} /><span class="sr-only">{T.demoTitulo}</span></h2>
            <span class="demo__estado"><span class="demo__punto" aria-hidden="true"></span>{T.chat.enLinea}</span>
          </div>
          <div class="demo__log" role="log" aria-label={T.chat.conversacion} tabindex="0" data-itza-log></div>
          {/* role="log": lo que entra se anuncia solo, sin mover el foco (4.1.3).
              tabindex="0": la conversación se desplaza, y con teclado también
              tiene que poder leerse hacia atrás (2.1.1). */}
          <div class="demo__sugerencias" data-itza-sugerencias hidden>
            <p id="chat-sugeridas" class="sr-only">{T.chat.sugerencias}</p>
            <ul aria-labelledby="chat-sugeridas">
              {T.chat.sugeridas.map((q) => <li><button type="button" class="sugerencia" data-texto={q} set:html={marcaClara(q)} /></li>)}
            </ul>
          </div>
          <form class="demo__form" data-itza-form>
            <label for="chat-mensaje">{T.chat.etiqueta}</label>
            <div class="demo__fila">
              <textarea id="chat-mensaje" rows="1" maxlength="500" autocomplete="off"></textarea>
              <button type="submit" class="boton boton--oscuro">{T.chat.enviar}</button>
            </div>
            <div class="demo__voz">
              <button type="button" class="sugerencia" data-itza-hablar hidden>{T.chat.hablar}</button>
              <button type="button" class="sugerencia" data-itza-leer aria-pressed="false" hidden>{T.chat.leer}</button>
            </div>
          </form>
          <p class="demo__nota" set:html={marcaClara(T.demoPrivacidad)} />
        </section>
        <div class="sin-js">
          <p set:html={marca(T.demoSinJs)} />
          <a class="boton boton--borde" href={ap('proyectos', 'itza')} set:html={marca(T.demoCaso)} />
        </div>
      </section>

      <dl class="datos">
        {T.cifras.map(([cifra, texto]) => <div><dt class="t-dato">{cifra}</dt><dd class="suave">{texto}</dd></div>)}
      </dl>

      <section class="seccion" aria-labelledby="preguntas-titulo">
        <div class="seccion__cabeza">
          <h2 id="preguntas-titulo" class="t-titulo" set:html={marca(T.preguntasTitulo)} />
          <p class="suave" set:html={marca(T.preguntasIntro)} />
        </div>
        <ul class="burbujas">{T.preguntas.map((q) => <li>{q.replace(/\.$/, '')}</li>)}</ul>
        <p class="suave seccion__pie" set:html={marca(T.preguntasCierre)} />
      </section>

      <section class="seccion seccion--superficie" aria-labelledby="que-titulo">
        <div class="seccion__cabeza">
          <h2 id="que-titulo" class="t-titulo" set:html={marca(T.queTitulo)} />
          <p class="suave" set:html={marca(T.paraTexto)} />
        </div>
        <ul class="tarjetas">
          {T.que.map((b) => (
            <li><h3 class="t-sub menta" set:html={marca(b.titulo.replace(/\.$/, ''))} /><p class="suave" set:html={marca(b.texto)} /></li>
          ))}
        </ul>
      </section>

      <section class="seccion" aria-labelledby="acc-titulo">
        <div class="seccion__cabeza">
          <h2 id="acc-titulo" class="t-titulo" set:html={marca(T.accTitulo)} />
          <p class="suave" set:html={marca(T.accTexto)} />
        </div>
        <ul class="checks">{T.acc.map((a) => <li set:html={marca(a)} />)}</ul>
      </section>

      <section id="precio" class="seccion precio" aria-labelledby="precio-titulo">
        <div class="seccion__cabeza">
          <h2 id="precio-titulo" class="t-titulo" set:html={marca(T.precioTitulo)} />
          <p class="suave">{T.permanencia} {T.precioNota}</p>
        </div>
        <div class="precio__caja">
          <p class="precio__cifra"><span class="t-precio">{T.precio}</span> <span>{T.precioUnidad} {T.precioIva}</span></p>
          <p>{T.instalacion}</p>
          <h3 class="t-sub">{T.incluyeTitulo}</h3>
          <ul class="checks checks--oscuro">{T.incluye.map((i) => <li set:html={marcaClara(i)} />)}</ul>
          <a class="boton boton--oscuro boton--ancho" href="#contacto">{T.pedir}</a>
        </div>
      </section>

      <section class="seccion seccion--superficie" aria-labelledby="como-titulo">
        <h2 id="como-titulo" class="t-titulo" set:html={marca(T.comoTitulo)} />
        <ol class="pasos">
          {T.como.map((b) => <li><h3 class="t-sub" set:html={marca(b.titulo)} /><p class="suave" set:html={marca(b.texto)} /></li>)}
        </ol>
      </section>

      <section class="seccion" aria-labelledby="faq-titulo">
        <h2 id="faq-titulo" class="t-titulo">{T.faqTitulo}</h2>
        <div class="faq">
          {T.faq.map((q) => (
            <div class="faq__item"><h3 class="t-sub" set:html={marca(q.pregunta)} /><p class="suave" set:html={marca(q.respuesta)} /></div>
          ))}
        </div>
      </section>

      <section id="contacto" class="cierre" aria-labelledby="cierre-titulo">
        <h2 id="cierre-titulo" class="t-titulo" set:html={marca(T.cierreTitulo)} />
        <p class="suave">{T.cierreTexto}</p>
        <ul class="botones">
          <li><a class="boton boton--menta" href={ap('contacto')}>{T.escribenos}</a></li>
          <li><a class="boton boton--borde" href={`mailto:${CORREO_ESTUDIO}`}>{T.correo.split('@')[0]}@<wbr />{T.correo.split('@')[1]}</a></li>
        </ul>
      </section>
    </main>

    <footer class="pie">
      <p set:html={marca(T.pieProducto)} />
      <nav aria-label="Accesibilidad Primero">
        <ul>
          <li><a href={ap('home')}>{T.pieAp}</a></li>
          <li><a href={ap('proyectos', 'itza')}>{T.pieCaso}</a></li>
          <li><a href={ap('privacidad')}>{T.piePrivacidad}</a></li>
          <li><a href={ap('accesibilidad')}>{T.pieAccesibilidad}</a></li>
        </ul>
      </nav>
    </footer>

    <script>
      import '../../scripts/itza-demo';
    </script>
  </body>
</html>

<style>
  /* ---- Tokens del sistema de producto (ver la cabecera) ---- */
  :root {
    --p-fondo: #282B2A;       /* gris oscuro sedoso, casi negro */
    --p-superficie: #313534;
    --p-linea: #444A48;       /* decorativa: filetes y bordes de tarjeta */
    --p-menta: #C7EAE4;
    --p-texto: #F2F7F5;       /* 13,2:1 sobre el fondo */
    --p-suave: #D3DCD9;       /* 10,2:1 sobre el fondo, 8,9:1 sobre la superficie */
    --p-blanco: #FFFFFF;
    --p-gris-claro: #F2F4F3;
    --p-ancho: 1200px;
    --p-margen: clamp(24px, 4vw, 48px);
    --p-radio: 16px;
  }
  :global(html), :global(body) { background: var(--p-fondo); color: var(--p-texto); }
  :global(body) { font-size: 18px; line-height: 1.5; }
  @media (min-width: 1024px) { :global(body) { font-size: 20px; } }
  /* El foco, en menta sobre el fondo oscuro y en Ink sobre lo claro. */
  :global(:focus-visible) { outline: 3px solid var(--p-menta); outline-offset: 3px; }
  .demo :global(:focus-visible), .precio__caja :global(:focus-visible) { outline-color: var(--p-fondo); }
  main:focus { outline: none; }
  :global(.sr-only) { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .saltar {
    position: absolute; inset-block-start: 8px; inset-inline-start: 8px; z-index: 200;
    transform: translateY(calc(-100% - 16px));
    display: inline-flex; align-items: center; min-height: 44px; padding: 12px 16px;
    background: var(--p-menta); color: var(--p-fondo);
  }
  .saltar:focus { transform: none; }

  h1, h2, h3, p, ul, ol, dl, dd { margin: 0; }
  /* base.css pinta los encabezados y los enlaces en Ink: aquí heredan. */
  h1, h2, h3, dt { color: inherit; }
  ul, ol { padding: 0; list-style: none; }
  p, li, dd { max-inline-size: 62ch; }
  .menta { color: var(--p-menta); }
  .suave { color: var(--p-suave); }
  a { color: inherit; }
  .demo__log :global(p) { color: var(--p-fondo); }

  /* ---- Escala de producto: cinco tamaños, dos pesos ---- */
  .t-hero { font-size: clamp(40px, 5.2vw, 72px); line-height: 1.04; font-weight: 500; letter-spacing: -0.02em; max-inline-size: 15ch; text-wrap: balance; }
  .t-titulo { font-size: clamp(32px, 3.4vw, 48px); line-height: 1.1; font-weight: 500; letter-spacing: -0.01em; max-inline-size: 22ch; text-wrap: balance; }
  .t-dato { font-size: clamp(28px, 2.8vw, 40px); line-height: 1.1; font-weight: 500; color: var(--p-menta); }
  .t-sub { font-size: 1.1em; line-height: 1.3; font-weight: 500; }
  .t-precio { font-size: clamp(56px, 5vw, 72px); line-height: 1; font-weight: 500; }
  .firma { font-size: 16px; color: var(--p-suave); }

  /* El logo, a la altura de la letra en cualquier tamaño. */
  :global(.logo-itza) { display: inline-block; block-size: 0.95em; inline-size: auto; vertical-align: -0.1em; }
  .cabeza__marca :global(.logo-itza) { block-size: 32px; }
  .demo__cabeza :global(.logo-itza) { block-size: 24px; vertical-align: middle; }

  /* ---- Botones: la acción principal con fondo ---- */
  .botones { display: flex; flex-wrap: wrap; gap: 16px; }
  .boton {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.3em;
    min-height: 56px; padding: 0 28px; border-radius: 999px; border: 1px solid transparent;
    font: inherit; font-weight: 500; text-decoration: none; cursor: pointer; text-align: center;
  }
  .boton--pequeno { min-height: 44px; padding: 0 20px; font-size: 16px; }
  .boton--menta { background: var(--p-menta); color: var(--p-fondo); }
  .boton--borde { border-color: var(--p-menta); color: var(--p-menta); }
  .boton--oscuro { background: var(--p-fondo); color: var(--p-blanco); }
  .boton--ancho { inline-size: 100%; box-sizing: border-box; }
  .boton:hover { text-decoration: underline; text-underline-offset: 0.2em; }

  /* ---- Cabecera ---- */
  .cabeza {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px;
    padding: 12px var(--p-margen); border-block-end: 1px solid var(--p-linea);
  }
  .cabeza__marca { display: inline-flex; align-items: center; min-height: 44px; }
  .cabeza__derecha { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; }
  .cabeza__idiomas ul { display: flex; gap: 4px; font-size: 16px; }
  .cabeza__idiomas a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 10px; text-decoration: none; }
  .cabeza__idiomas a:hover, .cabeza__idiomas a[aria-current] { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }

  /* ---- Hero con la demo ---- */
  .hero {
    max-inline-size: var(--p-ancho); margin-inline: auto; box-sizing: content-box;
    padding: clamp(48px, 7vw, 96px) var(--p-margen) clamp(48px, 6vw, 80px);
    display: flex; flex-wrap: wrap; align-items: center; gap: 48px 64px;
  }
  .hero__texto { flex: 999 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 28px; }
  .demo {
    flex: 1 1 340px; min-width: 0; max-inline-size: 460px;
    display: none; flex-direction: column; border-radius: 20px; background: var(--p-blanco); color: var(--p-fondo);
    overflow: hidden;
  }
  :global(html.js) .demo { display: flex; }
  :global(html.js) .sin-js { display: none; }
  .sin-js { display: flex; flex-direction: column; gap: 16px; flex: 1 1 340px; }
  .demo__cabeza { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; padding: 12px 16px; background: var(--p-menta); }
  .demo__cabeza h2 { font-size: 1em; display: inline-flex; align-items: center; min-height: 44px; }
  .demo__estado { display: inline-flex; align-items: center; gap: 8px; font-size: 15px; }
  .demo__punto { inline-size: 10px; block-size: 10px; border-radius: 50%; background: var(--p-fondo); }
  .demo__log {
    display: flex; flex-direction: column; gap: 10px; padding: 16px;
    block-size: 240px; overflow-y: auto; font-size: 17px;
  }
  .demo__log :global(p) { max-inline-size: 85%; padding: 10px 14px; border-radius: 14px; background: var(--p-gris-claro); }
  .demo__log :global(p.tu) { align-self: flex-end; background: var(--p-menta); }
  .demo__log :global(.logo-itza) { block-size: 0.9em; }
  .demo__sugerencias { padding: 0 16px 12px; }
  .demo__sugerencias ul, .demo__voz { display: flex; flex-wrap: wrap; gap: 8px; }
  .sugerencia {
    display: inline-flex; align-items: center; gap: 0.25em; min-height: 44px; padding: 0 14px;
    border: 1px solid var(--p-fondo); border-radius: 999px; background: var(--p-blanco); color: var(--p-fondo);
    font: inherit; font-size: 16px; cursor: pointer; text-align: start;
  }
  .sugerencia:hover { background: var(--p-gris-claro); }
  .sugerencia[aria-pressed='true'] { background: var(--p-menta); }
  .demo__form { display: flex; flex-direction: column; gap: 8px; padding: 12px 16px 16px; border-block-start: 1px solid #E3E3E3; font-size: 16px; }
  .demo__fila { display: flex; gap: 8px; align-items: stretch; }
  .demo__fila textarea {
    flex: 1 1 auto; min-width: 0; min-height: 44px; box-sizing: border-box; padding: 10px 12px;
    border: 1px solid var(--p-fondo); border-radius: 10px; font: inherit; color: var(--p-fondo); resize: vertical;
    /* La página es oscura (color-scheme: dark): el campo, dentro de la caja
       blanca, se pinta claro a propósito. */
    background: var(--p-blanco); color-scheme: light;
  }
  .demo__fila .boton { min-height: 44px; padding: 0 18px; }
  .demo__voz:has(> :not([hidden])) { padding-block-start: 4px; }
  .demo__nota { padding: 0 16px 16px; font-size: 14px; line-height: 1.45; color: var(--p-fondo); }

  /* ---- Datos ---- */
  .datos {
    max-inline-size: var(--p-ancho); margin-inline: auto; box-sizing: content-box;
    padding: 0 var(--p-margen) clamp(64px, 8vw, 112px);
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 24px;
  }
  @media (min-width: 1024px) { .datos { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .datos div { padding-block-start: 16px; border-block-start: 1px solid var(--p-menta); display: flex; flex-direction: column; gap: 8px; }
  .datos dd { font-size: 16px; }

