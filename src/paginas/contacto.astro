    errorEnvio: 'No l’hem pogut enviar. Torna-ho a provar o escriu-nos a',
    resumen: 'No l’hem pogut enviar. Revisa això:',
    nombre: { etiqueta: 'Nom', ayuda: 'Quin nom prefereixes que fem servir quan et responguem?', marcador: 'El nom que prefereixis', falta: 'Escriu el teu nom.' },
    correo: { etiqueta: 'Correu electrònic', ayuda: 'Per exemple: nom@correu.cat', marcador: 'nom@correu.cat', falta: 'Escriu el teu correu electrònic.', formato: 'Revisa el correu: ha de portar @ i un domini, com nom@correu.cat.' },
