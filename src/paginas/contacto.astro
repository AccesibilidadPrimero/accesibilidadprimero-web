/* «Itza», con su logo cada vez que se nombra (Johnny, 07/11/2026). En Ink
   sobre el blanco de la página. Un logotipo es la excepción de 1.4.5. */
const LOGO_ITZA = `<img class="logo-itza" src="${logoItza.src}" alt="Itza" width="968" height="341" />`;
const conLogo = (s: string) => s.replace(/Itza/g, LOGO_ITZA);

const CAMPOS = [
  {
    id: 'nombre',
    etiqueta: T.nombre.etiqueta,
    ayuda: T.nombre.ayuda,
    /* Dentro de la casilla, más claro (Johnny, 03/11/2026). Un placeholder
       se borra al escribir y no lo leen todos los lectores, así que la ayuda
       sigue en el HTML para `aria-describedby`, oculta a la vista (sr-only).
       El gris es Ink / Secondary: 5,60:1 sobre el blanco de la casilla. */
    dentro: true,
    /* La frase entera no cabe en la casilla a 390 (se cortaba en «al re…»):
       dentro va corta y la ayuda completa la oye el lector. */
    marcador: T.nombre.marcador,
    tipo: 'text',
    autocomplete: 'name',
    obligatorio: true,
    falta: T.nombre.falta,
  },
  {
    id: 'correo',
    etiqueta: T.correo.etiqueta,
    ayuda: T.correo.ayuda,
    /* Dentro de la casilla, como el nombre (03/11/2026). */
    dentro: true,
    marcador: T.correo.marcador,
    tipo: 'email',
    autocomplete: 'email',
    obligatorio: true,
    falta: T.correo.falta,
    formato: T.correo.formato,
  },
  {
    id: 'organizacion',
    etiqueta: T.organizacion,
    tipo: 'text',
    autocomplete: 'organization',
    obligatorio: false,
  },
] as const;
---

<Base
  lang={lang}
  current="contacto"
  conCta={false}
  title={T.title}
  description={T.description}
>
  {/* SIN HERO desde el 04/11/2026 (auditoría de usabilidad: quien llega aquí
      ya quiere escribir y la primera pantalla era una presentación). El
      titular, a tamaño de texto en la columna de los rótulos, como un bloque
      más; la introducción, el correo y el formulario, juntos en la otra. */}
  {/* ITZA EN CONTACTO (Johnny, 08/11/2026: «Itza tiene que poder hacer todo
      el proceso y sustituir el formulario»; «sin texto de introducción, debe
      ser un ejemplo de lo increíble que funciona Itza»). La página en menta,
      la pastilla de Itza y, al desplegarla, la conversación: Itza pregunta
      por el proyecto, pide nombre y correo (estos sin pasar por la IA),
      enseña el mensaje y lo envía por /api/contacto.
      Solo con JS (html.js). Si el Worker dice que Itza no está configurada
      (GET /api/itza-contacto) o la API falla, src/scripts/itza-contacto.ts
      pone html.sin-itza y vuelve la página de siempre, con su formulario:
      es el respaldo. Sin JS, también la de siempre. */}
  <section class="itza" data-itza-contacto={JSON.stringify({ ...T.itza, lang })} data-sitekey={TURNSTILE_SITEKEY} data-accion={TURNSTILE_ACCION}>
    {/* Itza con SU interfaz, no la de AP (Johnny, 08/11/2026: «Itza tiene su
        propia interfaz y estilos, hay que mantener su singularidad
        visual»): la barra oscura, la ventana con cabecera, «En línea», las
        burbujas en morado y la firma. Los mismos colores que el plugin
        (ap-chat-widget.php): #1a1a2e, #5b4fcf, #3d33a0.
        Hero a pantalla entera en menta con la barra abajo; la ventana, al
        preguntar. */}
    {/* El h1, para quien navega por encabezados; a la vista, la barra ya
        dice dónde está. */}
    <h1 class="sr-only">{T.titulo}</h1>

    <div id="itza-panel" class="itza-chat" hidden>
      <div class="itza-chat__cabeza">
        {/* Solo el emblema de AP y «En línea» (Johnny, 08/11/2026). Decorativo:
            quién habla lo dice cada mensaje al lector de pantalla. */}
        <span class="itza-chat__icono"><img src={iconoAP.src} width={iconoAP.width} height={iconoAP.height} alt="" /></span>
        <div class="itza-chat__info">
          <p class="itza-chat__estado"><span class="itza-chat__punto"></span>{T.itza.enLinea}</p>
        </div>
        <button type="button" class="itza-chat__cerrar" data-itza-cerrar>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
          <span class="sr-only">{T.itza.cerrar}</span>
        </button>
      </div>

      {/* role="log": lo que entra se anuncia solo sin mover el foco (4.1.3);
          tabindex="0": se desplaza, y con teclado también se tiene que
          poder leer hacia atrás (2.1.1). */}
      <div class="itza-chat__mensajes" role="log" aria-label={T.itza.conversacion} tabindex="0" data-itza-log></div>

      {/* Las respuestas rápidas que propone Itza (sí / no, o una lista
          corta): se pulsan en vez de escribir (Johnny, 08/11/2026: «que las
          personas tengan que escribir lo mínimo»). Fuera del role="log": son
          controles, no mensajes. Se vacían al responder. */}
      <div class="itza-chat__rapidas" data-itza-rapidas hidden></div>

      {/* 1. La charla. La etiqueta, oculta como en el plugin: la pregunta de
          Itza, justo encima, ya dice qué escribir. */}
      <form class="itza-chat__fila" data-paso="charla" novalidate>
        <label for="itza-mensaje" class="sr-only">{T.itza.etiqueta}</label>
        <input id="itza-mensaje" type="text" maxlength="1200" autocomplete="off" placeholder={T.itza.escribe} class="itza-chat__entrada" />
        {/* El micrófono, como en el plugin. Sale `hidden` y solo lo enseña
            el script si el navegador sabe reconocer la voz (§5). */}
        <button type="button" class="itza-voz" data-itza-voz hidden>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" /></svg>
          <span class="sr-only" data-itza-voz-texto>{T.itza.hablar}</span>
        </button>
        <button type="submit" class="itza-chat__enviar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" aria-hidden="true"><path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z" /></svg>
          <span class="sr-only">{T.itza.responder}</span>
        </button>
      </form>

      {/* 2. Los datos y enviar, en un paso (Johnny, 08/11/2026: «cuando da el
          mail, que aparezca enviar, no hace falta el resumen»). Nombre y
          correo los pide la página, no la IA. Aquí las etiquetas sí se
          ven: son datos. */}
      <form class="itza-chat__datos" data-paso="datos" novalidate hidden>
        <label for="itza-nombre">{T.itza.nombre}</label>
        <p id="itza-nombre-error" class="itza-chat__error" hidden />
        <input id="itza-nombre" type="text" autocomplete="name" maxlength="200" aria-describedby="itza-nombre-error" />
        <label for="itza-correo">{T.itza.correo}</label>
        <p id="itza-correo-error" class="itza-chat__error" hidden />
        <input id="itza-correo" type="email" autocomplete="email" maxlength="254" aria-describedby="itza-correo-error" />
        <div data-itza-turnstile></div>
        <p class="itza-chat__error-envio" tabindex="-1" data-itza-error-envio hidden>
          {T.itza.errorEnvio} <a href={`mailto:${CORREO}`}>{CORREO}</a>.
        </p>
        <button type="submit" class="itza-chat__boton">{T.itza.enviar}</button>
      </form>

      <p class="itza-chat__hecho" tabindex="-1" data-itza-hecho hidden></p>
      <p class="itza-chat__firma" set:html={conLogo(T.itza.marca)} />
    </div>

    {/* Las opciones, como las preguntas sugeridas del plugin: cada una
        empieza la conversación con esa respuesta ya dada. «Contactar por
        email» no pregunta nada: abre el correo de quien visita con nuestra
        dirección (Johnny, 08/11/2026). Se retiran al empezar a hablar. */}
    <ul class="itza-opciones" data-itza-opciones>
      {T.itza.opciones.map((o) => (
        <li><button type="button" class="itza-opcion" data-texto={o}>{o}</button></li>
      ))}
      <li><a class="itza-opcion" href={`mailto:${CORREO}`}>{T.itza.porCorreo}</a></li>
    </ul>

    {/* La barra, como la del plugin: es un campo. La conversación no sale
        hasta que se pregunta algo (Johnny, 08/11/2026). La etiqueta va
        oculta y repite lo que dice la barra: el texto de la barra es lo
        que se ve, y desaparece al escribir, así que el nombre del campo no
        puede depender de él. */}
    <form class="itza-barra" data-itza-barra novalidate>
      {/* La carita es decoración, como en el plugin. */}
      <span class="itza-barra__icono" aria-hidden="true">🙂</span>
      <label for="itza-pregunta" class="sr-only">{T.itza.pildora}</label>
      <input id="itza-pregunta" type="text" maxlength="1200" autocomplete="off" placeholder={T.itza.pildora} class="itza-barra__entrada" />
      <button type="button" class="itza-voz itza-voz--barra" data-itza-voz hidden>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" /></svg>
        <span class="sr-only" data-itza-voz-texto>{T.itza.hablar}</span>
      </button>
      <button type="submit" class="itza-barra__enviar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" aria-hidden="true"><path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z" /></svg>
        <span class="sr-only">{T.itza.responder}</span>
      </button>
    </form>
  </section>

  <section class="pagina-contacto" aria-labelledby="contacto-titulo">
    <div class="pagina-contacto__cabeza">
      <h1 id="contacto-titulo" class="pagina-contacto__titulo">{T.titulo}</h1>
      {/* El lápiz del hero que había (05/11/2026), pequeño y sin ocupar
          pantalla: devuelve el carácter a la página. Decorativo. */}
      <img src={lapiz.src} width={lapiz.width} height={lapiz.height} alt="" class="pagina-contacto__lapiz" />
    </div>
    <div class="pagina-contacto__contenido">
      <div class="pagina-contacto__intro">
        <p>{T.intro1}</p>
        <p>{T.intro2}</p>
        {/* El correo, ANTES del formulario: es la otra forma de empezar. */}
        <div class="directo__correo">
          <p>{T.porCorreo}</p>
          <CtaLink href={`mailto:${CORREO}`}>proyectos@<wbr>accesibilidadprimero.com</CtaLink>
        </div>
      </div>

      <h2 class="sr-only">{T.escribenos}</h2>
      <!-- Los obligatorios no llevan marca: el único que no lo es lo dice en
           su etiqueta, «(opcional)». Así no hace falta explicar qué significa
           un asterisco (3.3.2), y el lector de pantalla no lo lee en cada
           etiqueta. -->
      <noscript>
        <p>{T.noscript} <a href={`mailto:${CORREO}`}>{CORREO}</a>.</p>
      </noscript>
      <form
        id="formulario"
        class="formulario"
        action="/api/contacto"
        method="post"
        data-formulario
        data-sitekey={TURNSTILE_SITEKEY}
        data-accion={TURNSTILE_ACCION}
        hidden
      >
        <!-- Si el envío falla (red, verificación o correo), esto sustituye al
             resumen de errores: no es culpa de quien escribe, así que no
             señala ningún campo y le da el correo como salida. -->
        <div class="resumen" data-error-envio hidden>
          <p class="resumen__titulo" tabindex="-1">
            {T.errorEnvio} <a href={`mailto:${CORREO}`}>{CORREO}</a>.
          </p>
        </div>

        <!-- El resumen de errores. Oculto hasta que falla un envío; entonces
             el script rellena la lista y pone el foco en su titular, que por
             eso lleva tabindex="-1". Es un <h3> porque cuelga de
             «Escríbenos» (h2). Sin ARIA: el foco en un encabezado ya se lee. -->
        <div class="resumen" data-resumen hidden>
          <h3 class="resumen__titulo" tabindex="-1">{T.resumen}</h3>
          <ul class="resumen__lista"></ul>
        </div>

        {
          CAMPOS.map((c) => (
            <div class="campo">
              <label for={c.id}>{c.etiqueta}</label>
              {'ayuda' in c && <p id={`${c.id}-ayuda`} class:list={['campo__ayuda', 'dentro' in c && 'sr-only']}>{c.ayuda}</p>}
              <p id={`${c.id}-error`} class="campo__error" hidden />
              <input
                id={c.id}
                name={c.id}
                type={c.tipo}
                autocomplete={c.autocomplete}
                placeholder={'marcador' in c ? c.marcador : undefined}
                required={c.obligatorio}
                aria-describedby={['ayuda' in c ? `${c.id}-ayuda` : '', `${c.id}-error`].filter(Boolean).join(' ')}
                data-validar
                data-falta-msg={'falta' in c ? c.falta : undefined}
                data-formato-msg={'formato' in c ? c.formato : undefined}
                class="campo__entrada"
              />
            </div>
          ))
        }

        <div class="campo">
          <label for="mensaje">{T.mensaje}</label>
          <p id="mensaje-ayuda" class="campo__ayuda">
            {T.mensajeAyuda}
          </p>
          <p id="mensaje-error" class="campo__error" hidden />
          <textarea
            id="mensaje"
            name="mensaje"
            rows="6"
            required
            aria-describedby="mensaje-ayuda mensaje-error"
            data-validar
            data-falta-msg={T.mensajeFalta}
            class="campo__entrada campo__entrada--area"></textarea>
        </div>

        <div class="consentimiento">
          <p id="consentimiento-error" class="campo__error" hidden />
          <div class="consentimiento__fila">
            <input
              id="consentimiento"
              name="consentimiento"
              type="checkbox"
              required
              aria-describedby="consentimiento-error"
              data-validar
              data-falta-msg={T.consentimientoFalta}
              class="consentimiento__casilla"
            />
            <label for="consentimiento">
              {T.consentimiento}
            </label>
          </div>
        </div>

        <!-- La política a la que se refiere la casilla. En su propia línea, no
             dentro de la etiqueta: un enlace dentro de un <label> se lleva
             el clic que debería marcar la casilla, y en un renglón mide 23
             px (la regla del repo son 44). Figma: `CTA · Política de
             privacidad`, 11/10/2026. -->
        <CtaLink href={path('privacidad', lang)}>{T.politica}</CtaLink>

        <!-- Turnstile en modo invisible: no dibuja nada ni pide nada. Su
             script se carga al empezar a rellenar el formulario, no al abrir
             la página. -->
        <div data-turnstile></div>

        <button type="submit" class="boton">{T.enviar}</button>
      </form>

      <!-- Confirmación. Al enviarse, el formulario desaparece y el foco viene
           aquí (tabindex="-1"): si no, se quedaría en un botón que ya no
           existe y quien usa lector de pantalla no sabría qué ha pasado. Al
           llevar el foco no hace falta role="status": se lee al llegar. -->
      <p class="confirmacion" data-confirmacion tabindex="-1" hidden>
        {T.gracias} <span data-confirmacion-correo></span>.
      </p>
    </div>
  </section>

  {/* Sin el título visible «También puedes escribirnos directamente»
      (Johnny, 03/11/2026). El h2 sigue para quien salta por encabezados. */}
  <Bloque id="directamente" titulo={T.redes} tituloOculto>
    <div class="directo">
      {/* La frase es de Johnny (10/10). El correo iba dentro de ella, pero un
          enlace en un renglón de texto mide 23 px de alto y la regla del
          repo son 44 en todo lo que se pulsa (AGENTS.md §4; WCAG lo
          perdona en una frase, AP no). Así que el correo sale a su línea,
          como enlace suelto con su flecha. El <wbr> deja partir la dirección
          después de la arroba: sin espacios, a 320 no cabe (1.4.10). */}
      {/* Ordenado (Johnny, 03/11/2026): la frase y el correo en una sola
          línea, y las redes debajo en tres columnas. */}
      {/* El correo subió arriba, junto al formulario (04/11/2026). */}
      <Redes columnas />
    </div>
  </Bloque>
</Base>

<script>
  import '../scripts/formulario';
  import '../scripts/itza-contacto';
</script>

<style>
  /* La cabecera de la página: el ritmo de los bloques (Bloque.astro), con el
     titular en la columna de los rótulos y a 64 de la cabecera, como el
     listado de Proyectos. */
  .pagina-contacto { padding: var(--ritmo-intro) var(--gutter-page) 0; display: flex; flex-direction: column; gap: var(--space-24); }
  .pagina-contacto__titulo { margin: 0; font-size: inherit; line-height: inherit; font-weight: 400; }
  .pagina-contacto__cabeza { display: flex; flex-direction: column; gap: var(--space-24); }
  .pagina-contacto__lapiz { display: block; inline-size: auto; block-size: 96px; max-inline-size: 100%; }
  @media (min-width: 1024px) { .pagina-contacto__lapiz { block-size: 160px; } }
  .pagina-contacto__contenido { display: flex; flex-direction: column; gap: var(--space-48); min-width: 0; }
  .pagina-contacto__intro { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-24); max-width: 560px; }
  .pagina-contacto__intro p { margin: 0; }
  @media (min-width: 1024px) {
    .pagina-contacto { display: grid; grid-template-columns: calc(456 / 1392 * 100%) minmax(0, 1fr); gap: 0; }
    .pagina-contacto__cabeza { max-width: 204px; }
  }

  .directo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-32);
  }
  .directo p { margin: 0; }
  /* La frase y su correo en una línea; si no caben (móvil), el correo baja
     entero, con su flecha. */
  /* El título del bloque está oculto, así que el contenido caía en la
     primera columna (456 px a 1440) y las redes se salían. Va en la columna
     del formulario, a plomo con él (03/11/2026). */
  :global(.bloque__contenido:has(> .directo)) { grid-column: -2 / -1; min-width: 0; }
  .directo__correo { display: flex; flex-wrap: wrap; align-items: center; column-gap: var(--space-12); row-gap: var(--space-8); }

  /* ----- Formulario ----------------------------------------------------
     Campos de 560 como máximo; 32 entre ellos; 6 dentro de cada uno. */
  .formulario {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-32);
    max-width: 560px;
    position: relative;
  }
  /* El contenedor de Turnstile no pinta nada (modo invisible), pero como hijo
     del flex sumaba un hueco más: 64 en vez de 32 hasta el botón. Fuera del
     flujo deja de ocupar sitio y Turnstile sigue teniendo dónde montarse. */
  .formulario [data-turnstile] { position: absolute; inset-block-start: 0; inset-inline-start: 0; }
  .campo {
    display: flex;
    flex-direction: column;
    gap: 6px;
    inline-size: 100%;
  }
  .campo__ayuda, .campo__error { margin: 0; }
  .campo__entrada::placeholder { color: var(--grey); opacity: 1; }

  /* Borde Ink / Secondary de 1,5: 5,60:1 sobre blanco, por encima del 3:1
     que pide 1.4.11 para el contorno de un control. */
  .campo__entrada {
    box-sizing: border-box;
    inline-size: 100%;
    min-block-size: 56px;
    padding: 14px 16px;
    border: 1.5px solid var(--grey);
    border-radius: 3px;
    background: var(--white);
    color: var(--text);
    font: inherit;
  }
  .campo__entrada--area { min-block-size: 180px; resize: vertical; }

  /* Error: el mensaje escrito encima del campo y el borde en Ink y al doble.
     Nunca solo color (1.4.1). Con `forced-colors` la sombra desaparece, pero
     el mensaje sigue ahí. */
  [aria-invalid='true'] {
    border-color: var(--ink);
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }

  /* Casilla de 24 (Figma 2284:45) y 12 hasta su texto. La etiqueta entera
     responde al toque, así que la zona útil es la fila completa y supera los
     44 de la regla de AP. */
  .consentimiento { display: flex; flex-direction: column; gap: 6px; }
  .consentimiento__fila {
    display: flex;
    align-items: flex-start;
    gap: var(--space-12);
  }
  .consentimiento__casilla {
    flex: 0 0 auto;
    inline-size: 24px;
    block-size: 24px;
    margin: 0;
    accent-color: var(--ink);
  }
  .consentimiento label { min-block-size: var(--touch-min); }

  /* Botón: Ink con texto blanco, 16 · 32 de relleno, radio 3 (Figma 2284:47).
     Al pasar, subrayado: el estado va en una línea, no en un cambio de color. */
  .boton {
    min-block-size: var(--touch-min);
    padding: var(--space-16) var(--space-32);
    border: 0;
    border-radius: 3px;
    background: var(--ink);
    color: var(--white);
    cursor: pointer;
  }
  .boton:hover {
    text-decoration: underline;
    text-decoration-thickness: var(--underline-rest);
    text-underline-offset: var(--underline-offset);
  }
  @media (forced-colors: active) {
    .boton { border: 1.5px solid ButtonText; }
  }

  /* Resumen de errores: un recuadro de tinta, el mismo grosor que el campo
     en error. */
  .resumen {
    inline-size: 100%;
    box-sizing: border-box;
    padding: var(--space-16) var(--space-24);
    border: 3px solid var(--ink);
    border-radius: 3px;
  }
  .resumen[hidden], .formulario[hidden] { display: none; }
  .confirmacion { margin: 0; max-width: 560px; }
  .resumen__titulo { margin: 0; font-size: inherit; line-height: inherit; font-weight: 400; }
  .resumen__lista { margin: var(--space-8) 0 0; padding-inline-start: 1.2em; }
  .resumen__lista a { display: inline-block; min-block-size: var(--touch-min); padding-block: var(--aire-control); }

  /* ----- Itza en Contacto (08/11/2026) -----------------------------------
     La página en menta; Itza, con su propia interfaz (la del plugin: barra
     #1a1a2e, acento #5b4fcf, oscuro #3d33a0). Contrastes medidos: blanco
     sobre #1a1a2e 17:1, blanco sobre #5b4fcf 6,1:1, #222 sobre la burbuja
     de Itza 13:1, el verde de «En línea» sobre #1a1a2e 11:1.
     Con Itza, la página de siempre no se pinta; sin Itza (html.sin-itza) o
     sin JS, al revés. */
  .itza {
    display: none;
    --itza-fondo: #1a1a2e; --itza-acento: #5b4fcf; --itza-acento-oscuro: #3d33a0;
    --itza-burbuja: #efedfa; --itza-texto: #222; --itza-suave: #555;
  }
  /* Un hero a pantalla entera, como los demás (HeroPagina): sube por
     debajo de la cabecera y deja la barra abajo, a 24 del borde. La
     ventana, al abrirse, sale encima de la barra, como en el plugin. */
  :global(html.js:not(.sin-itza)) .itza {
    display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: var(--space-16);
    min-block-size: 100svh; box-sizing: border-box;
    margin-block-start: calc(var(--header-height) * -1);
    padding: var(--header-height) var(--gutter-page) var(--space-24);
  }
  @supports (height: 100lvh) {
    :global(html.js:not(.sin-itza)) .itza { min-block-size: 100lvh; padding-block-end: calc(var(--space-24) + 100lvh - 100svh); }
  }
  :global(html.js:not(.sin-itza)) .pagina-contacto { display: none; }
  :global(html.js:not(.sin-itza) body) { background: var(--mint); }

  .itza p { margin: 0; }
  .itza :global(.logo-itza) { display: inline-block; block-size: 0.95em; inline-size: auto; vertical-align: -0.1em; }
  /* Las opciones: las píldoras del plugin (aro y texto en el morado, 6,1:1
     sobre el blanco). */
  .itza-opciones {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 8px;
    inline-size: 100%; max-inline-size: 560px; margin: 0; padding: 0; list-style: none;
  }
  .itza-opciones[hidden] { display: none; }
  .itza-opcion {
    display: inline-flex; align-items: center; min-block-size: var(--touch-min); box-sizing: border-box;
    padding: 6px 16px; border: 1.5px solid var(--itza-acento); border-radius: 999px; background: #fff;
    color: var(--itza-acento-oscuro); font: inherit; font-size: 16px; line-height: 1.3; text-decoration: none; cursor: pointer;
  }
  .itza-opcion:hover { background: var(--itza-acento); color: #fff; }
  .itza-opcion:focus-visible { outline: 2px solid var(--itza-fondo); outline-offset: 2px; }

  /* La barra: la del plugin, más corta que la columna. */
  .itza-barra {
    display: flex; align-items: center; gap: 10px; inline-size: 100%; max-inline-size: 560px; box-sizing: border-box;
    padding: 8px 8px 8px 20px; border-radius: 999px; background: var(--itza-fondo);
    box-shadow: 0 8px 28px rgba(26, 26, 46, 0.28);
  }
  .itza-barra[hidden] { display: none; }
  .itza-barra:focus-within { outline: 3px solid var(--itza-fondo); outline-offset: 4px; }
  .itza-barra__icono { flex: none; font-size: 1.6rem; line-height: 1; }
  .itza-barra__entrada {
    flex: 1; min-inline-size: 0; min-block-size: var(--touch-min); padding: 0 4px; border: 0; background: none;
    color: #fff; font: inherit; font-size: 18px;
  }
  /* El texto de la barra: 9,6:1 sobre #1a1a2e. */
  .itza-barra__entrada::placeholder { color: rgba(255, 255, 255, 0.72); opacity: 1; }
  /* El foco lo dibuja la barra entera (:focus-within): un aro dentro de un
     campo sin borde no se veía. */
  .itza-barra__entrada:focus { outline: none; }
  .itza-barra__enviar {
    flex: none; display: grid; place-items: center; inline-size: 52px; block-size: 52px; padding: 0; border: 0; border-radius: 50%;
    background: var(--itza-acento); color: #fff; cursor: pointer;
  }
  .itza-barra__enviar:hover { background: var(--itza-acento-oscuro); }
  .itza-barra__enviar:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  /* En el móvil, la pregunta tiene que leerse entera: botones de 44, sin
     huecos de más y la carita más pequeña. 16 px es el mínimo para que el
     iPhone no amplíe la página al tocar el campo. */
  @media (max-width: 479px) {
    .itza-barra { gap: 6px; padding: 6px 6px 6px 12px; }
    .itza-barra__icono { font-size: 1.25rem; }
    .itza-barra__entrada { font-size: 16px; padding: 0 2px; }
    .itza-barra__enviar, .itza-voz--barra { inline-size: var(--touch-min); block-size: var(--touch-min); }
  }
  @media (max-width: 359px) {
    .itza-barra__icono { display: none; }
    .itza-barra { padding-inline-start: 16px; }
    /* A 320 no cabe a 16: el texto de la barra baja a 15 (el campo sigue a
       16, que es lo que mira el iPhone para no ampliar). */
    .itza-barra__entrada::placeholder { font-size: 15px; }
  }
  /* Como en el plugin y en los chats del móvil: con la barra vacía, el
     micrófono; al escribir, enviar. Así cabe la pregunta entera. Sin
     micrófono (el navegador no reconoce la voz), enviar siempre. */
  .itza-barra.con-voz:not(.con-texto) .itza-barra__enviar,
  .itza-barra.con-texto .itza-voz--barra { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .itza-barra { transition: transform 0.2s, box-shadow 0.2s; }
    .itza-barra:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(26, 26, 46, 0.32); }
  }

  /* La ventana. */
  .itza-chat {
    display: flex; flex-direction: column; inline-size: 100%; max-inline-size: 560px; box-sizing: border-box;
    background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 12px 48px rgba(0, 0, 0, 0.18);
    color: var(--itza-texto); font-size: 16px; line-height: 1.5;
  }
  .itza-chat[hidden] { display: none; }
  .itza-chat__cabeza { display: flex; align-items: center; gap: 12px; padding: 14px 16px; background: var(--itza-fondo); color: #fff; }
  .itza-chat__icono { flex: none; display: grid; place-items: center; inline-size: 40px; block-size: 40px; border-radius: 50%; background: #fff; }
  .itza-chat__icono img { inline-size: 26px; block-size: auto; }
  .itza-chat__info { flex: 1; display: flex; flex-direction: column; gap: 2px; }
  .itza-chat__estado { display: flex; align-items: center; gap: 8px; color: #8ff0b4; font-size: 16px; }
  .itza-chat__punto { inline-size: 10px; block-size: 10px; border-radius: 50%; background: #8ff0b4; }
  .itza-chat__cerrar {
    flex: none; display: grid; place-items: center; inline-size: var(--touch-min); block-size: var(--touch-min);
    padding: 0; border: 0; border-radius: 8px; background: none; color: #fff; cursor: pointer;
  }
  .itza-chat__cerrar:hover { background: rgba(255, 255, 255, 0.12); }
  .itza-chat__cerrar:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

  .itza-chat__mensajes {
    display: flex; flex-direction: column; gap: 10px; padding: 16px;
    min-block-size: 160px; max-block-size: 50svh; overflow-y: auto;
  }
  .itza-chat__mensajes:focus-visible { outline: 2px solid var(--itza-acento); outline-offset: -2px; }
  /* En una columna flex con alto máximo, los hijos encogen: sin esto el
     último mensaje se aplastaba en vez de desplazarse. */
  .itza-chat__mensajes > :global(*) { flex-shrink: 0; }
  .itza-chat__mensajes :global(p) {
    margin: 0; max-inline-size: 82%; padding: 10px 14px; border-radius: 12px; overflow-wrap: anywhere;
    background: var(--itza-burbuja); color: var(--itza-texto); border: 1px solid rgba(0, 0, 0, 0.06); border-end-start-radius: 4px;
  }
  .itza-chat__mensajes :global(p.tu) {
    align-self: flex-end; background: var(--itza-acento); color: #fff; border-color: transparent;
    border-end-start-radius: 12px; border-end-end-radius: 4px;
  }
  .itza-chat__mensajes :global(.logo-itza) { block-size: 0.9em; }
  /* «Itza está escribiendo»: los tres puntos del plugin; el texto, para el
     lector de pantalla. */
  .itza-chat__mensajes :global(p.escribiendo) { display: flex; gap: 5px; align-items: center; padding: 14px 16px; }
  .itza-chat__mensajes :global(.punto) { inline-size: 7px; block-size: 7px; border-radius: 50%; background: #767676; }
  @media (prefers-reduced-motion: no-preference) {
    .itza-chat__mensajes :global(.punto) { animation: itza-salto 0.9s infinite; }
    .itza-chat__mensajes :global(.punto:nth-of-type(2)) { animation-delay: 0.15s; }
    .itza-chat__mensajes :global(.punto:nth-of-type(3)) { animation-delay: 0.3s; }
  }
  @keyframes itza-salto { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(-5px); } }

  .itza-chat__rapidas { display: flex; flex-wrap: wrap; gap: 8px; padding: 0 16px 12px; }
  .itza-chat__rapidas[hidden] { display: none; }
  /* Los botones los crea el script: sin :global no les llega el estilo. */
  .itza-chat__rapidas :global(button) {
    min-block-size: var(--touch-min); padding: 6px 16px; border: 1.5px solid var(--itza-acento); border-radius: 999px;
    background: #fff; color: var(--itza-acento-oscuro); font: inherit; font-size: 16px; cursor: pointer;
  }
  .itza-chat__rapidas :global(button:hover) { background: var(--itza-acento); color: #fff; }
  .itza-chat__rapidas :global(button:focus-visible) { outline: 2px solid var(--itza-acento-oscuro); outline-offset: 2px; }
  .itza-chat__fila { display: flex; gap: 8px; align-items: center; padding: 10px 12px; border-block-start: 1px solid #eee; }
  .itza-chat__fila[hidden], .itza-chat__datos[hidden], .itza-chat__hecho[hidden],
  .itza-chat__error[hidden], .itza-chat__error-envio[hidden] { display: none; }
  .itza-chat__entrada {
    flex: 1; min-inline-size: 0; min-block-size: var(--touch-min); box-sizing: border-box;
    padding: 9px 16px; border: 1px solid #8a8a8a; border-radius: 999px; font: inherit; color: var(--itza-texto); background: #fff;
  }
  .itza-chat__entrada::placeholder { color: #6b6b6b; }
  .itza-chat__entrada:focus { outline: 2px solid var(--itza-acento); outline-offset: 1px; border-color: var(--itza-acento); }
  .itza-chat__enviar {
    flex: none; display: grid; place-items: center; inline-size: var(--touch-min); block-size: var(--touch-min);
    padding: 0; border: 0; border-radius: 50%; background: var(--itza-acento); color: #fff; cursor: pointer;
