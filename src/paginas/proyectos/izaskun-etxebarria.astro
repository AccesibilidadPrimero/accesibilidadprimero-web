import hero from '../../assets/proyectos/izaskun-etxebarria/hero.jpg';
import retrato from '../../assets/proyectos/izaskun-etxebarria/retrato.jpg';

const p = (await getEntry('proyectos', 'izaskun-etxebarria'))!;
const d = localizar(p.data, lang);

/* Los primeros fotogramas de cada grabación, uno por tamaño. */
const posters = import.meta.glob<{ default: ImageMetadata }>('../../assets/proyectos/izaskun-etxebarria/video-*.png', { eager: true });
const video = (escena: string) => {
  const f = (formato: string) => {
    const poster = posters[`../../assets/proyectos/izaskun-etxebarria/video-${escena}-${formato}.png`]?.default;
    if (!poster) throw new Error(`Caso Izaskun: falta el póster video-${escena}-${formato}.png`);
    return { archivo: `/video/izaskun-etxebarria/${escena}-${formato}.mp4`, poster };
  };
  /* Desde el 03/11/2026 el móvil usa la de tableta (VideoPausable): las
     grabaciones nuevas ya no llevan versión de móvil. */
  const conMovil = posters[`../../assets/proyectos/izaskun-etxebarria/video-${escena}-movil.png`];
  return { escritorio: f('escritorio'), tableta: f('tableta'), ...(conMovil ? { movil: f('movil') } : {}) };
};
const vertical = { tableta: '360px', movil: '280px' };
const dominio = d.web ? new URL(d.web).hostname.replace(/^www\./, '') : null;

const datos = [
  [T.cliente, 'Izaskun Etxebarria'],
  [T.anio, '2026'],
  [T.rol, T.rolV],
  [T.estandar, T.estandarV],
];
---

<Base
  lang={lang}
  current="proyectos"
  title={`${d.titulo} · ${T.seccion} · Accesibilidad Primero`}
  description={d.resumen.replace(/\s+/g, ' ')}
>
  <div class="izaskun" style={`--acento: ${d.paleta.acento}; --texto-acento: ${d.paleta.textoSobreAcento}; --anillo-acento: ${d.paleta.anilloFoco};`}>
    <HeroPagina
      titulo={T.titulo}
      golpes={[T.golpe1, T.golpe2]}
      texto={[T.heroTexto]}
      foto={hero}
    />

    <section class="datos" aria-labelledby="datos">
      <h2 id="datos" class="sr-only">{T.datos}</h2>
      <dl class="datos__lista">
        {datos.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        {d.web && dominio && <div><dt>Web</dt><dd><CtaLink href={d.web}>{dominio}</CtaLink></dd></div>}
      </dl>
    </section>

    {/* La portada de la web, recorrida de arriba abajo, sobre el carmesí del
        proyecto (Silk encima, validado en el build). */}
    <div class="banda banda--acento">
      <VideoPausable
        class="video video--portada"
        {...video('portada')}
        alt={T.portadaAlt}
        nombre={T.portadaNombre}
        lang={lang}
        sizes={{ escritorio: '(min-width: 1440px) 1148px, 80vw', ...vertical }}
      />
    </div>

    <section class="bloque" aria-labelledby="proyecto">
      <h2 id="proyecto" class="bloque__etiqueta">{T.proyecto}</h2>
      <div class="bloque__contenido">
        <p>{T.proyectoP}</p>
      </div>
    </section>

    <section class="bloque" aria-labelledby="reto">
      <p class="bloque__etiqueta">{T.reto}</p>
      <div class="bloque__contenido">
        <h2 id="reto">{T.retoH}</h2>
        <p>{T.retoP}</p>
        <h3>{T.presenciaH}</h3>
        <p>{T.presenciaP}</p>
      </div>
    </section>

    <figure class="pieza pieza--derecha">
      <VideoPausable
        class="video"
        {...video('bide-zabalak')}
        alt={T.bideAlt}
        nombre="Bide-zabalak"
        lang={lang}
        sizes={{ escritorio: '(min-width: 1440px) 660px, 46vw', ...vertical }}
      />
      <figcaption>Bide-zabalak</figcaption>
    </figure>

    <section class="bloque" aria-labelledby="estructura">
      <p class="bloque__etiqueta">{T.estructura}</p>
      <div class="bloque__contenido">
        <h2 id="estructura">{T.estructuraH}</h2>
        <p>{T.estructuraP1}</p>
        <p>{T.estructuraP2}</p>
      </div>
    </section>

    <figure class="pieza pieza--centro">
      <VideoPausable
        class="video"
        {...video('panoramicas')}
        alt={T.panoAlt}
        nombre="Agujeros de tiempo"
        lang={lang}
        sizes={{ escritorio: '(min-width: 1440px) 896px, 62vw', ...vertical }}
      />
      <figcaption>Agujeros de tiempo</figcaption>
    </figure>

    {/* Decisiones de diseño, con la microanimación de la retícula: en
        escritorio, en la columna del enunciado; en tablet y móvil, entre el
        enunciado y las decisiones. */}
    <section class="bloque bloque--decisiones" aria-labelledby="decisiones">
      <div class="decisiones__enunciado">
        <h2 id="decisiones">{T.decisiones}</h2>
        <p>{T.decisionesP}</p>
        <ReticulaEditorial acento={d.paleta.acento} />
      </div>
      <ul class="decisiones__lista">
        <li>
          <h3>{T.d1H}</h3>
          <p>{T.d1P}</p>
        </li>
        <li>
          <h3>{T.d2H}</h3>
          <p>{T.d2P}</p>
        </li>
        <li>
          <h3>{T.d3H}</h3>
          <p>{T.d3P}</p>
        </li>
      </ul>
    </section>

    {/* Testimonio de Izaskun (03/11/2026), sobre el carmesí: la foto a la
        izquierda y el texto a la derecha (en tablet y móvil, uno encima de
        otro). Sustituye a la foto de sala. La cita va literal. */}
    <section class="banda banda--acento banda--testimonio" aria-labelledby="testimonio" data-campo-color>
      <Picture
        src={retrato}
        formats={['avif', 'webp']}
        widths={[300, retrato.width].filter((w, i, a) => w <= retrato.width && a.indexOf(w) === i)}
        sizes="(min-width: 1024px) 420px, calc(100vw - 48px)"
        alt={T.retratoAlt}
        class="foto foto--retrato"
        loading="lazy"
      />
      <figure class="testimonio">
        <h2 id="testimonio">{T.testimonio}</h2>
        <blockquote>
          <p>{T.cita1}</p>
          <p>{T.cita2}</p>
        </blockquote>
        <figcaption>{T.firma}{T.notaTraduccion && <> <span class="nota-traduccion">{T.notaTraduccion}</span></>}</figcaption>
      </figure>
    </section>

  </div>
  <CierreProyecto actual="izaskun-etxebarria" declaracion={d.nota?.declaracion} titulo={d.titulo} />
</Base>

<style>
  p, h2, h3, dl, dd, figure, ul { margin: 0; }
  ul { padding: 0; list-style: none; }
  h2, h3 { font-size: inherit; line-height: inherit; font-weight: 400; }

  /* ---- Datos ---- en franja, como en ECI. */
  .datos { padding: var(--space-48) var(--gutter-page); }
  .datos__lista { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-24) var(--space-16); }
  /* En móvil, dos columnas (auditoría de usabilidad, 04/11/2026: la ficha en
     vertical retrasaba la historia). La web, que es un enlace largo, entera. */
  @media (max-width: 767px) { .datos__lista > div:has(a) { grid-column: 1 / -1; } }
  /* La web, en la misma línea base que el resto (Johnny, 05/11/2026), como en
     Foc i Cor: el enlace mide 44 de alto y se come su aire. */
  .datos__lista > div:has(a) dd { margin-block: calc(var(--aire-control) * -1); }
  .datos__lista > div { display: flex; flex-direction: column; gap: var(--space-4); }
  @media (min-width: 768px) { .datos__lista { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-32) var(--space-24); } }
  @media (min-width: 1024px) { .datos__lista { grid-template-columns: repeat(5, minmax(0, 1fr)); } }

  /* ---- Bloques de texto ---- como en ECI: la etiqueta en su columna de
     280 desde 1024; encima en tablet y móvil. */
  .bloque {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-24);
    padding: var(--space-64) var(--gutter-page);
  }
  .bloque__contenido { display: flex; flex-direction: column; gap: var(--space-24); max-width: 968px; }
  /* El h3 al cuerpo del texto: lo separa el aire de antes (AGENTS.md §4). */
  .bloque__contenido h3 { margin-block-start: var(--space-24); }
  @media (min-width: 768px) { .bloque { padding-block: var(--space-96); } }
  @media (min-width: 1024px) { .bloque { grid-template-columns: 280px minmax(0, 1fr); gap: var(--space-96); } }

  /* ---- Decisiones ---- dos columnas desde 1024, como en el Figma: el
     enunciado y la retícula a la izquierda, las tres decisiones a la
     derecha (16 entre nombre y texto, 48 entre decisiones). */
  .bloque--decisiones { gap: var(--space-48); }
  .decisiones__enunciado { display: flex; flex-direction: column; gap: var(--space-24); }
  .decisiones__enunciado :global(.reticula) { margin-block-start: var(--space-24); }
