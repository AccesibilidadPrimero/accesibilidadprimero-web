import CtaLink from '../../components/CtaLink.astro';
import VideoPausable from '../../components/VideoPausable.astro';
import Testimonio from '../../components/Testimonio.astro';
import { path } from '../../i18n/config';
import { idiomaDe, localizar } from '../../i18n/idioma';
const lang = idiomaDe(Astro.url);
/* Los textos de la página en los tres idiomas (05/11/2026). */
