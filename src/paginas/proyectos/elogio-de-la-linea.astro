import fraseFinal from '../../assets/proyectos/elogio-de-la-linea/hero-frase.png';

const p = (await getEntry('proyectos', 'elogio-de-la-linea'))!;
const d = localizar(p.data, lang);

const posters = import.meta.glob<{ default: ImageMetadata }>('../../assets/proyectos/elogio-de-la-linea/video-*.png', { eager: true });
const video = (escena: string) => {
  const f = (formato: string) => {
    const poster = posters[`../../assets/proyectos/elogio-de-la-linea/video-${escena}-${formato}.png`]?.default;
    if (!poster) throw new Error(`Caso Elogio: falta el póster video-${escena}-${formato}.png`);
    return { archivo: `/video/elogio-de-la-linea/${escena}-${formato}.mp4`, poster };
  };
  /* Desde el 03/11/2026 el móvil usa la de tableta (VideoPausable). */
  return { escritorio: f('escritorio'), tableta: f('tableta') };
};
const poster = await getImage({ src: fraseFinal, width: 1280, format: 'webp', quality: 'high' });
const vertical = { tableta: '360px', movil: '280px' };
const dominio = d.web ? new URL(d.web).hostname.replace(/^www\./, '') : null;

const datos = [
  [T.cliente, T.clienteV],
  [T.anio, '2026'],
  [T.rol, T.rolV],
  [T.estandar, T.estandarV],
];
const cifras = [T.c1, T.c2, T.c3];
---

<Base
  lang={lang}
  current="proyectos"
  title={`${d.titulo} · ${T.seccion} · Accesibilidad Primero`}
  description={d.resumen.replace(/\s+/g, ' ')}
>
  <script>
    /* El hero: el fragmento se reproduce una vez, solo con JS y sin
       «reducir movimiento». Se queda en el último fotograma: la frase. */
    const v = document.querySelector<HTMLVideoElement>('[data-hero-frase]');
    if (v && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) v.play().catch(() => {});
  </script>
  <div class="elogio" style={`--acento: ${d.paleta.acento}; --texto-acento: ${d.paleta.textoSobreAcento}; --anillo-acento: ${d.paleta.anilloFoco};`}>
    <HeroPagina
      titulo="Elogio de la línea"
      golpes={['Elogio', 'de la línea']}
      texto={[T.heroTexto]}
      superficie={{ fondo: 'var(--white)', foco: 'var(--blue-ap)' }}
    >
      {/* aria-hidden: dibuja con la línea el mismo titular que dice el h1. */}
      <video slot="ilustracion" class="apertura__ilustracion hero-frase" data-hero-frase
             src="/video/elogio-de-la-linea/hero-frase.mp4" poster={poster.src}
             width="1280" height="720" muted playsinline preload="auto" aria-hidden="true"></video>
    </HeroPagina>

    <section class="datos" aria-labelledby="datos">
      <h2 id="datos" class="sr-only">{T.datos}</h2>
      <dl class="datos__lista">
        {datos.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        {d.web && dominio && <div><dt>Web</dt><dd><CtaLink href={d.web}>{dominio}</CtaLink></dd></div>}
      </dl>
    </section>

    {/* La portada: el nombre escrito con una línea y los proyectos como
        dibujos sueltos, sobre la banda Ink. */}
    <div class="banda banda--acento">
      <VideoPausable
        class="video video--portada"
        {...video('portada')}
        alt={T.portadaAlt}
        nombre={T.portadaNombre}
        lang={lang}
        sizes={{ escritorio: '(min-width: 1440px) 1148px, 80vw', ...vertical }}
      />
    </div>

    <section class="bloque" aria-labelledby="proyecto">
      <h2 id="proyecto" class="bloque__etiqueta">{T.proyecto}</h2>
      <div class="bloque__contenido">
        <p>{T.proyectoP}</p>
        <dl class="cifras">
          {cifras.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
      </div>
    </section>

    <section class="bloque" aria-labelledby="reto">
      <p class="bloque__etiqueta">{T.reto}</p>
      <div class="bloque__contenido">
        <h2 id="reto">{T.retoH}</h2>
        <p>{T.retoP}</p>
        <h3>{T.r1H}</h3>
        <p>{T.r1P}</p>
        <h3>{T.r2H}</h3>
        <p>{T.r2P}</p>
      </div>
    </section>

    <figure class="pieza pieza--centro">
      <VideoPausable
        class="video"
        {...video('ajedrez')}
        alt={T.ajedrezAlt}
        nombre={T.ajedrezNombre}
        lang={lang}
        sizes={{ escritorio: '(min-width: 1440px) 1100px, 76vw', ...vertical }}
      />
      <figcaption>{T.ajedrezPie}</figcaption>
    </figure>

    <section class="bloque bloque--decisiones" aria-labelledby="decisiones">
      <div class="decisiones__enunciado">
        <h2 id="decisiones">{T.decisiones}</h2>
        <p>{T.decisionesP}</p>
      </div>
      <ul class="decisiones__lista">
        <li>
          <h3>{T.d1H}</h3>
          <p>{T.d1P}</p>
        </li>
        <li>
          <h3>{T.d2H}</h3>
          <p>{T.d2P}</p>
        </li>
        <li>
          <h3>{T.d3H}</h3>
          <p>{T.d3P}</p>
        </li>
        <li>
          <h3>{T.d4H}</h3>
          <p>{T.d4P}</p>
        </li>
      </ul>
    </section>

    <figure class="pieza pieza--derecha">
      <VideoPausable
        class="video"
        {...video('silla')}
        alt={T.sillaAlt}
        nombre={T.sillaNombre}
        lang={lang}
        sizes={{ escritorio: '(min-width: 1440px) 660px, 46vw', ...vertical }}
      />
      <figcaption>{T.sillaPie}</figcaption>
    </figure>

    {/* La serie de porcelana recorrida, sobre la banda negra (03/11/2026):
        sustituye a la foto de la silla. */}
    <div class="banda banda--acento">
      <VideoPausable
        class="video video--portada"
        {...video('porcelana')}
        alt={T.porcelanaAlt}
        nombre={T.porcelanaNombre}
        lang={lang}
        sizes={{ escritorio: '(min-width: 1440px) 1148px, 80vw', ...vertical }}
      />
    </div>

    {/* «Desde el otro lado»: el testimonio de Pau, en borrador hasta que lo
        mande (solo se ve en `npm run dev`). Un testimonio inventado no se
        publica (AGENTS.md §8). */}
    <Testimonio
      borrador
      cita="Texto del testimonio pendiente de recibir de Pau Jordà. Lo dejamos con su extensión aproximada, unas treinta palabras, para ver cómo respira el bloque en la página."
      nombre="Pau Jordà Sanmartín"
      cargo="Arquitecto"
      fondo={d.paleta.acento}
      texto={d.paleta.textoSobreAcento}
      foco={d.paleta.anilloFoco}
    />
  </div>
  <CierreProyecto actual="elogio-de-la-linea" titulo={d.titulo} />
</Base>

<style>
  p, h2, h3, dl, dd, figure, ul { margin: 0; }
  ul { padding: 0; list-style: none; }
  h2, h3 { font-size: inherit; line-height: inherit; font-weight: 400; }

  /* ---- Datos ---- en franja, como en ECI. */
  .datos { padding: var(--space-48) var(--gutter-page); }
  .datos__lista { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-24) var(--space-16); }
  /* En móvil, dos columnas (auditoría de usabilidad, 04/11/2026: la ficha en
     vertical retrasaba la historia). La web, que es un enlace largo, entera. */
  @media (max-width: 767px) { .datos__lista > div:has(a) { grid-column: 1 / -1; } }
  /* La web, en la misma línea base que el resto (Johnny, 05/11/2026), como en
     Foc i Cor: el enlace mide 44 de alto y se come su aire. */
  .datos__lista > div:has(a) dd { margin-block: calc(var(--aire-control) * -1); }
  .datos__lista > div { display: flex; flex-direction: column; gap: var(--space-4); }
  @media (min-width: 768px) { .datos__lista { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-32) var(--space-24); } }
  @media (min-width: 1024px) { .datos__lista { grid-template-columns: repeat(5, minmax(0, 1fr)); } }

  /* ---- Bloques de texto ---- como en ECI: la etiqueta en su columna de
     280 desde 1024; encima en tablet y móvil. */
  .bloque {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-24);
    padding: var(--space-64) var(--gutter-page);
  }
