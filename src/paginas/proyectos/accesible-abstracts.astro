import hero from '../../assets/proyectos/accesible-abstracts/hero.jpg';
import envioMovil from '../../assets/proyectos/accesible-abstracts/envio-movil.jpg';
import envio from '../../assets/proyectos/accesible-abstracts/envio.jpg';
import evaluacion from '../../assets/proyectos/accesible-abstracts/evaluacion.jpg';
/* Las versiones para móvil (04/11/2026): la misma aplicación a 390. */
import CapturaArte from '../../components/CapturaArte.astro';
import heroM from '../../assets/proyectos/accesible-abstracts/hero-m.jpg';
import envioM from '../../assets/proyectos/accesible-abstracts/envio-m.jpg';
import evaluacionM from '../../assets/proyectos/accesible-abstracts/evaluacion-m.jpg';

const titulo = 'Accesible Abstracts';
const datos = [
  [T.producto, T.productoValor],
  [T.anio, '2026'],
  [T.rol, T.rolValor],
  [T.estandar, 'WCAG 2.2 A/AA'],
];
const anchos = (w: number, lista: number[]) => [...lista.filter((x) => x < w), w];
const centro = '(min-width: 1440px) 1100px, (min-width: 1024px) 76vw, calc(100vw - 48px)';
---

<Base
  lang={lang}
  current="proyectos"
  title={`${titulo} · ${T.seccion} · Accesibilidad Primero`}
  description={T.descripcion}
>
  <div class="aa">
    <HeroPagina
      titulo={T.heroTitulo}
      golpes={[T.heroGolpe1, T.heroGolpe2]}
      texto={[T.heroTexto]}
      superficie={{ fondo: 'var(--rose-ap)', foco: 'var(--blue-ap)' }}
    >
      <CapturaArte
        slot="ilustracion"
        class="apertura__ilustracion"
        src={hero}
        movil={heroM}
        sizes="(min-width: 1440px) 1100px, calc(100vw - 48px)"
        loading="eager"
        alt={T.altHero}
      />
    </HeroPagina>

    <section class="datos" aria-labelledby="datos">
      <h2 id="datos" class="sr-only">{T.datos}</h2>
      <dl class="datos__lista">
        {datos.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        <div><dt>{T.web}</dt><dd><CtaLink href="https://aa.accesibilidadprimero.com/">{T.conocer}</CtaLink></dd></div>
      </dl>
    </section>

    <section class="bloque" aria-labelledby="proyecto">
      <h2 id="proyecto" class="bloque__etiqueta">{T.proyecto}</h2>
      <div class="bloque__contenido">
        <p>{T.proyecto1}</p>
        <p>{T.proyecto2}</p>
        <p>{T.proyecto3}</p>
        <CtaLink href={path('proyectos', lang, 'eci-conference')}>{T.verECI}</CtaLink>
      </div>
    </section>

    <figure class="pieza pieza--derecha">
      <Picture
        src={envioMovil}
        formats={['avif', 'webp']}
        widths={[envioMovil.width / 2, envioMovil.width]}
        sizes="(min-width: 768px) 360px, calc(100vw - 48px)"
        alt={T.altEnvioMovil}
        class="captura captura--movil"
        loading="lazy"
      />
      <figcaption>{T.pieEnvioMovil}</figcaption>
    </figure>

    <section class="bloque" aria-labelledby="reto">
      <p class="bloque__etiqueta">{T.reto}</p>
      <div class="bloque__contenido">
        <h2 id="reto">{T.retoTitulo}</h2>
        <p>{T.reto1}</p>
        <h3>{T.reto2}</h3>
        <p>{T.reto3}</p>
      </div>
    </section>

    <figure class="pieza pieza--centro">
      <CapturaArte
        src={envio}
        movil={envioM}
        sizes={centro}
        alt={T.altEnvio}
        class="captura"
      />
      <figcaption>{T.pieEnvio}</figcaption>
    </figure>

    <section class="bloque" aria-labelledby="estructura">
      <p class="bloque__etiqueta">{T.estructura}</p>
      <div class="bloque__contenido">
        <h2 id="estructura">{T.estructuraTitulo}</h2>
        <p>{T.estructura1}</p>
        <p>{T.estructura2}</p>
      </div>
    </section>

    <figure class="pieza pieza--centro">
      <CapturaArte
        src={evaluacion}
        movil={evaluacionM}
        sizes={centro}
        alt={T.altEvaluacion}
        class="captura"
      />
      <figcaption>{T.pieEvaluacion}</figcaption>
    </figure>

    {/* Sin la captura del comité (05/11/2026): el caso era muy largo y la
        evaluación ya enseña la revisión. */}
    <section class="bloque" aria-labelledby="aprendido">
      <p class="bloque__etiqueta">{T.aprendido}</p>
      <div class="bloque__contenido">
        <h2 id="aprendido">{T.aprendidoTitulo}</h2>
        <p>{T.aprendido1}</p>
        <p>{T.aprendido2}</p>
        <p>{T.aprendido3}</p>
      </div>
    </section>

    <section class="bloque bloque--decisiones" aria-labelledby="decisiones">
      <div class="decisiones__enunciado">
        <h2 id="decisiones">{T.decisiones}</h2>
        <p>{T.decisionesIntro}</p>
      </div>
      <ul class="decisiones__lista">
        <li>
          <MicroDecision tipo="ciego">
            <span class="m-ficha">
              <span>ABS-0142</span>
