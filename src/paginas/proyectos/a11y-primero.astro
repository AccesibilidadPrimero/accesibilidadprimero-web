  :global(.micro--sello) .m-mano--2 { inset-block-start: 128px; animation-delay: 2400ms; }
  @keyframes m-llena { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  /* 2 · Una puntuación que se puede explicar: 100, lo que resta cada fallo y el resultado. */
  :global(.micro--resta) .m-f1 { inset-block-start: 16px; }
  :global(.micro--resta) .m-f2 { inset-block-start: 52px; animation: m-entra 400ms var(--ease-out) 700ms; }
  :global(.micro--resta) .m-f3 { inset-block-start: 88px; animation: m-entra 400ms var(--ease-out) 1400ms; }
  :global(.micro--resta) .m-linea { position: absolute; inset-inline: 16px; inset-block-start: 126px; border-block-start: 1px solid var(--ink); animation: m-aparece 300ms linear 2100ms; }
  :global(.micro--resta) .m-f4 { inset-block-start: 132px; animation: m-entra 400ms var(--ease-out) 2300ms; }

  /* 3 · Los datos se quedan en el navegador: el informe se hace dentro de la ventana. */
  .m-ventana { position: absolute; inset: 16px 16px 16px 16px; border: 1px solid var(--ink); border-radius: 8px; }
  .m-ventana::before { content: ''; position: absolute; inset-block-start: 10px; inset-inline-start: 12px; inline-size: 36px; block-size: 6px;
    background: radial-gradient(circle, var(--ink) 2.5px, transparent 3px) 0 0 / 12px 6px repeat-x; }
  .m-ventana .m-barra { inset-inline: 16px; }
  .m-ventana .m-barra i { animation: m-llena 600ms var(--ease-out) both; }
  .m-ventana .m-b1 { inset-block-start: 36px; } .m-ventana .m-b1 i { animation-delay: 400ms; }
  .m-ventana .m-b2 { inset-block-start: 54px; inset-inline-end: 80px; } .m-ventana .m-b2 i { animation-delay: 800ms; }
  .m-ventana .m-b3 { inset-block-start: 72px; inset-inline-end: 140px; } .m-ventana .m-b3 i { animation-delay: 1200ms; }
  :global(.micro--equipo) .m-fila { inset-block-end: 14px; inset-inline: 16px; animation: m-entra 400ms var(--ease-out) 2000ms; }

  /* 4 · En tres idiomas: el mismo botón en castellano, catalán e inglés. */
  :global(.micro--idiomas) .m-capa--1, .micro--idiomas .m-capa--2 { opacity: 0; }
  :global(.micro--idiomas) .m-capa--1 { animation: m-turno 1300ms linear 300ms; }
  :global(.micro--idiomas) .m-capa--2 { animation: m-turno 1300ms linear 1600ms; }
  :global(.micro--idiomas) .m-capa--3 { animation: m-aparece 400ms var(--ease-out) 2900ms; }
  :global(.micro--idiomas) .m-boton { inset-block-start: 66px; inset-inline-start: 16px; }
  :global(.micro--idiomas) .m-etiqueta { position: absolute; inset-block-start: 20px; inset-inline-start: 16px; }
  @keyframes m-turno { 0% { opacity: 0; } 12% { opacity: 1; } 88% { opacity: 1; } 100% { opacity: 0; } }

  @media (min-width: 1024px) {
