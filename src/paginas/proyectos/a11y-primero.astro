import hero from '../../assets/proyectos/a11y-primero/hero.jpg';
import panelWcag from '../../assets/proyectos/a11y-primero/panel-wcag.png';
import wcag from '../../assets/proyectos/a11y-primero/wcag.jpg';
import verComo from '../../assets/proyectos/a11y-primero/ver-como.jpg';

const titulo = 'A11y Primero';
const datos = [
  [T.producto, T.productoValor],
  [T.anio, '2026'],
  [T.rol, T.rolValor],
  [T.estandar, 'WCAG 2.2 A/AA'],
  /* Su estado, a la vista (auditoría de usabilidad, 04/11/2026). */
  [T.estado, T.estadoValor],
];
const anchos = (w: number, lista: number[]) => [...lista.filter((x) => x < w), w];
---

<Base
  lang={lang}
  current="proyectos"
  title={`${titulo} · ${T.seccion} · Accesibilidad Primero`}
  description={T.descripcion}
>
  <div class="a11y" style="--acento: var(--yellow-ap); --texto-acento: var(--ink);">
    <HeroPagina
      titulo={T.heroTitulo}
      golpes={[T.heroGolpe1, T.heroGolpe2]}
      texto={[T.heroTexto]}
      superficie={{ fondo: 'var(--yellow-ap)', foco: 'var(--blue-ap)' }}
      ilustracion={hero}
      alt={T.altHero}
    />

    <section class="datos" aria-labelledby="datos">
      <h2 id="datos" class="sr-only">{T.datos}</h2>
      <dl class="datos__lista">
        {datos.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </section>

    <section class="bloque" aria-labelledby="proyecto">
      <h2 id="proyecto" class="bloque__etiqueta">{T.proyecto}</h2>
      <div class="bloque__contenido">
        <p>{T.proyecto1}</p>
        <p>{T.proyecto2}</p>
        <p>{T.proyecto3}</p>
        {/* El siguiente paso (auditoría de usabilidad, 04/11/2026): todavía
            no se puede instalar, así que no se promete una descarga. */}
        <p>{T.proyecto4}</p>
        <CtaLink href={path('contacto', lang)}>{T.probar}</CtaLink>
      </div>
    </section>

    <figure class="pieza pieza--derecha">
      <Picture
        src={panelWcag}
        formats={['avif', 'webp']}
        widths={[panelWcag.width / 2, panelWcag.width]}
        sizes="(min-width: 768px) 300px, calc(100vw - 48px)"
        alt={T.altPanel}
        class="captura captura--panel"
        loading="lazy"
      />
      <figcaption>WCAG</figcaption>
    </figure>

    <section class="bloque" aria-labelledby="reto">
      <p class="bloque__etiqueta">{T.reto}</p>
      <div class="bloque__contenido">
        <h2 id="reto">{T.retoTitulo}</h2>
        <p>{T.reto1}</p>
        <h3>{T.reto2}</h3>
        <p>{T.reto3}</p>
      </div>
    </section>

    <figure class="pieza pieza--centro">
      <Picture
        src={wcag}
        formats={['avif', 'webp']}
        widths={anchos(wcag.width, [640, 1100, 1600, 2200])}
        sizes="(min-width: 1440px) 1100px, (min-width: 1024px) 76vw, calc(100vw - 48px)"
        alt={T.altWcag}
        class="captura"
        loading="lazy"
      />
      <figcaption>{T.pieWcag}</figcaption>
    </figure>

    <section class="bloque" aria-labelledby="estructura">
      <p class="bloque__etiqueta">{T.estructura}</p>
      <div class="bloque__contenido">
        <h2 id="estructura">{T.estructuraTitulo}</h2>
        <p>{T.estructura1}</p>
        <p>{T.estructura2}</p>
        <p>{T.estructura3}</p>
      </div>
    </section>

    <figure class="pieza pieza--centro">
      <Picture
        src={verComo}
        formats={['avif', 'webp']}
        widths={anchos(verComo.width, [640, 1100, 1600, 2200])}
        sizes="(min-width: 1440px) 1100px, (min-width: 1024px) 76vw, calc(100vw - 48px)"
        alt={T.altVerComo}
        class="captura"
        loading="lazy"
      />
      <figcaption>{T.pieVerComo}</figcaption>
    </figure>

    <section class="bloque bloque--decisiones" aria-labelledby="decisiones">
      <div class="decisiones__enunciado">
        <h2 id="decisiones">{T.decisiones}</h2>
        <p>{T.decisionesIntro}</p>
      </div>
      <ul class="decisiones__lista">
        <li>
          <MicroDecision tipo="sello">
            <span class="m-fila m-fila--nota"><span>{T.mPuntuacion}</span><span>100</span></span>
            <span class="m-barra"><i></i></span>
            <span class="m-fila m-mano"><span>{T.mMano}</span><span>2</span></span>
          </MicroDecision>
          <h3>{T.selloTitulo}</h3>
          <p>{T.sello}</p>
        </li>
        <li>
          <MicroDecision tipo="resta">
            <span class="m-fila m-f1"><span>{T.mParte}</span><span>100</span></span>
            <span class="m-fila m-f2"><span>{T.mGrave}</span><span>-7</span></span>
            <span class="m-fila m-f3"><span>{T.mModerado}</span><span>-3</span></span>
            <span class="m-linea"></span>
            <span class="m-fila m-f4"><span>{T.mResultado}</span><span>90</span></span>
          </MicroDecision>
          <h3>{T.restaTitulo}</h3>
          <p>{T.resta}</p>
        </li>
        <li>
          <MicroDecision tipo="equipo">
            <span class="m-ventana">
              <span class="m-barra m-b1"><i></i></span>
              <span class="m-barra m-b2"><i></i></span>
              <span class="m-barra m-b3"><i></i></span>
              <span class="m-fila"><span>{T.mInforme}</span></span>
            </span>
          </MicroDecision>
          <h3>{T.equipoTitulo}</h3>
          <p>{T.equipo}</p>
        </li>
        <li>
          <MicroDecision tipo="idiomas">
            <span class="m-capa m-capa--1"><span class="m-etiqueta">Castellano</span><span class="m-boton">Evaluar</span></span>
            <span class="m-capa m-capa--2"><span class="m-etiqueta">Català</span><span class="m-boton">Avaluar</span></span>
            <span class="m-capa m-capa--3"><span class="m-etiqueta">English</span><span class="m-boton">Evaluate</span></span>
          </MicroDecision>
          <h3>{T.idiomasTitulo}</h3>
