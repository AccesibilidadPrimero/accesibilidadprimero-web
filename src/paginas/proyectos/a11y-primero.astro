  .decisiones__lista li { display: flex; flex-direction: column; gap: var(--space-48); }
  /* La microanimación, a 24 de su titular (05/11/2026). */
  .decisiones__lista li > :global(.micro) + h3 { margin-block-start: calc(var(--space-24) - var(--space-48)); }

  /* ---- Microanimaciones de las decisiones (05/11/2026) ----
     MicroDecision.astro pone el marco y las reglas (estado final por defecto,
     arranque al entrar en pantalla, una vez). Aquí, las piezas. */
  @keyframes m-entra { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes m-aparece { from { opacity: 0; } to { opacity: 1; } }
  @keyframes m-sale { from { opacity: 1; } to { opacity: 0; } }
  .m-fila { position: absolute; inset-inline: 16px; display: flex; justify-content: space-between; align-items: baseline; gap: 16px; white-space: nowrap; }
  .m-barra { position: absolute; inset-inline: 16px; block-size: 8px; border-radius: 4px; background: var(--hairline); overflow: hidden; }
  .m-barra i { display: block; block-size: 100%; inline-size: 100%; background: var(--ink); transform-origin: left center; }
  .m-boton { position: absolute; display: inline-flex; align-items: center; justify-content: center; block-size: 44px; padding-inline: 16px; border: 1px solid var(--ink); border-radius: 22px; white-space: nowrap; background: var(--white); }
  .m-capa { position: absolute; inset: 0; }

  /* 1 · Un 100 no es un sello: la nota llega a 100 y, debajo, lo que queda por mirar a mano. */
  :global(.micro--sello) .m-fila--nota { inset-block-start: 20px; }
