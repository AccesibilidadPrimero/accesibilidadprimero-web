}[lang];
import VideoPausable from '../../components/VideoPausable.astro';
import movil from '../../assets/proyectos/itza/movil.jpg';
import posterHero from '../../assets/proyectos/itza/itza-hero-fotograma.png';
import posterSugerencias from '../../assets/proyectos/itza/itza-sugerencias-fotograma.png';
import posterContacto from '../../assets/proyectos/itza/itza-contacto-fotograma.png';
const video = (n: string, poster: ImageMetadata) => ({ escritorio: { archivo: `/video/itza-${n}.mp4`, poster } });

const titulo = 'Itza';
const datos = [
  [T.producto, T.productoValor],
  [T.anio, '2026'],
  [T.rol, T.rolValor],
  [T.estandar, 'WCAG 2.2 A/AA'],
];
const anchos = (w: number, lista: number[]) => [...lista.filter((x) => x < w), w];
---

<Base
  lang={lang}
  current="proyectos"
  title={`${titulo} · ${T.seccion} · Accesibilidad Primero`}
  description={T.descripcion}
>
  <div class="itza">
    <HeroPagina
      titulo={T.heroTitulo}
      golpes={[T.heroGolpe1, T.heroGolpe2]}
      texto={[T.heroTexto]}
      superficie={{ fondo: 'var(--mint-video)', foco: 'var(--blue-ap)' }}
    >
      <VideoPausable
        slot="ilustracion"
        class="itza-hero"
        auto
        {...video('hero', posterHero)}
        alt={T.altHero}
        nombre={T.nombreHero}
        lang={lang}
        sizes={{ escritorio: '400px', tableta: '330px', movil: '286px' }}
      />
    </HeroPagina>

    <section class="datos" aria-labelledby="datos">
      <h2 id="datos" class="sr-only">{T.datos}</h2>
      <dl class="datos__lista">
        {datos.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        <div><dt>{T.web}</dt><dd><CtaLink href="https://itza.accesibilidadprimero.com/">{T.conocer}</CtaLink></dd></div>
      </dl>
    </section>

    <section class="bloque" aria-labelledby="proyecto">
      <h2 id="proyecto" class="bloque__etiqueta">{T.proyecto}</h2>
      <div class="bloque__contenido">
        <p>{T.proyecto1}</p>
        <p>{T.proyecto2}</p>
        <p>{T.proyecto3}</p>
      </div>
    </section>

    <figure class="pieza pieza--derecha">
      <Picture
        src={movil}
        formats={['avif', 'webp']}
        widths={[movil.width / 2, movil.width]}
        sizes="(min-width: 768px) 360px, calc(100vw - 48px)"
        alt={T.altMovil}
        class="captura captura--movil"
        loading="lazy"
      />
      <figcaption>{T.pieMovil}</figcaption>
    </figure>

    <section class="bloque" aria-labelledby="reto">
      <p class="bloque__etiqueta">{T.reto}</p>
      <div class="bloque__contenido">
        <h2 id="reto">{T.retoTitulo}</h2>
        <p>{T.reto1}</p>
        <h3>{T.reto2}</h3>
        <p>{T.reto3}</p>
      </div>
    </section>

    <figure class="pieza pieza--centro">
      <VideoPausable
        class="captura-video"
        {...video('sugerencias', posterSugerencias)}
        alt={T.altSugerencias}
        nombre={T.nombreSugerencias}
        lang={lang}
        sizes={{ escritorio: '(min-width: 1440px) 1100px, 76vw', tableta: 'calc(100vw - 48px)', movil: 'calc(100vw - 48px)' }}
      />
      <figcaption>{T.pieSugerencias}</figcaption>
    </figure>

    <section class="bloque" aria-labelledby="estructura">
      <p class="bloque__etiqueta">{T.estructura}</p>
      <div class="bloque__contenido">
        <h2 id="estructura">{T.estructuraTitulo}</h2>
        <p>{T.estructura1}</p>
        <p>{T.estructura2}</p>
      </div>
    </section>

    <figure class="pieza pieza--derecha">
      <VideoPausable
        class="captura-video captura-video--ventana"
        {...video('contacto', posterContacto)}
        alt={T.altContacto}
        nombre={T.nombreContacto}
        lang={lang}
        sizes={{ escritorio: '420px', tableta: '420px', movil: 'calc(100vw - 48px)' }}
      />
      <figcaption>{T.pieContacto}</figcaption>
    </figure>

    <section class="bloque bloque--decisiones" aria-labelledby="decisiones">
      <div class="decisiones__enunciado">
        <h2 id="decisiones">{T.decisiones}</h2>
        <p>{T.decisionesIntro}</p>
      </div>
      <ul class="decisiones__lista">
        {/* Microanimaciones (Johnny, 04/11/2026): una por decisión, que la
            explica. Dibujadas en HTML y CSS, en tinta y con una sola línea.
            Arrancan al entrar en pantalla, duran menos de 5 s y van UNA vez,
            así que no necesitan botón (2.2.2). Sin JS o con «reducir
            movimiento», el estado final, quieto. `aria-hidden`: lo que
            enseñan ya lo dice el texto de al lado. */}
        <li>
          <div class="micro micro--nombre" aria-hidden="true">
            <span class="m-burbuja m-bot m-1">{T.mComo}</span>
            <span class="m-burbuja m-yo m-2"><span class="m-escribe">Marta</span></span>
            <span class="m-burbuja m-bot m-3">{T.mHola}</span>
          </div>
          <h3>{T.nombreTitulo}</h3>
          <p>{T.nombre}</p>
        </li>
        <li>
          <div class="micro micro--barra" aria-hidden="true">
            <span class="m-pagina"><i></i><i></i><i></i></span>
            <span class="m-boton"><span class="m-boton__texto">{T.mBarra}</span><span class="m-boton__punto"></span></span>
          </div>
          <h3>{T.barraTitulo}</h3>
          <p>{T.barra}</p>
        </li>
        <li>
          <div class="micro micro--voz" aria-hidden="true">
            <span class="m-capa m-capa--1"><span class="m-cabecera">Alba</span><span class="m-burbuja m-bot">{T.mAlba}</span></span>
            <span class="m-capa m-capa--2"><span class="m-cabecera">Nuri</span><span class="m-burbuja m-bot">{T.mNuri}</span></span>
            <span class="m-capa m-capa--3"><span class="m-cabecera">Itza</span><span class="m-burbuja m-bot">{T.mItza}</span></span>
          </div>
          <h3>{T.vozTitulo}</h3>
          <p>{T.voz}</p>
        </li>
        <li>
          <div class="micro micro--instala" aria-hidden="true">
            <span class="m-pagina"><i></i><i></i><i></i></span>
            <span class="m-linea">{T.mEnLinea}</span>
            <span class="m-boton m-boton--barra"><span class="m-boton__texto">{T.mBarra}</span><span class="m-boton__punto"></span></span>
          </div>
          <h3>{T.instalaTitulo}</h3>
          <p>{T.instala}</p>
        </li>
      </ul>
    </section>
  </div>
  <CierreProyecto actual="itza" titulo={titulo} />
</Base>

<script>
  /* Las microanimaciones arrancan al entrar en pantalla, una vez. */
  const micros = document.querySelectorAll<HTMLElement>('.micro');
  const ver = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    // Un respiro para que termine la aparición del bloque.
    setTimeout(() => e.target.classList.add('is-vista'), 500);
    ver.unobserve(e.target);
  }), { threshold: 0.6 });
  micros.forEach((m) => ver.observe(m));
</script>

<style>
