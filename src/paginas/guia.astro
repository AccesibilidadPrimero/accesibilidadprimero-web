/* ---------------------------------------------------------------------------
   ¿Qué hace que tu web sea o no accesible? Landing propia dentro de la web
   (Johnny, 06/11/2026): la página de referencia que acompaña el lanzamiento.
   Información de valor, no una pieza de venta: el vídeo, la pauta explicada,
   y qué son la WCAG, las leyes europeas y las palabras que salen. La
   conversión llega sola, al final de cada pauta y en el cierre de contacto.
   Estilo del vídeo: claude/video-esquematico-estilo-2026-11-05.md.

   ESTRUCTURA
   · Hero: el titular y el carrusel de vídeos a las tres columnas, con su
     contador (1 / 23). Un vídeo por punto; cada uno con su botón de
     reproducir y pausar (VideoPausable: empieza en pausa, nada se descarga
     hasta que se pulsa, y se para solo al salir de la vista o del carrusel).
   · Debajo, la pauta del vídeo que se está viendo: qué falla, cómo se
     arregla y cómo comprobarlo. Cambia con el vídeo.
   · Tres columnas fijas con «Leer más»: qué es la WCAG, las políticas
     europeas y el glosario.

   ACCESIBILIDAD
   · Los vídeos no tienen sonido y lo que enseñan lo enseñan con imagen. Su
     alternativa (1.2.1, solo vídeo) es doble: el `alt` de la imagen fija
     cuenta el vídeo entero y la pauta lo explica por escrito.
   · Sin JS no hay carrusel: se ven todos los vídeos y todas las pautas,
     uno debajo de otro, y los botones de navegación no se pintan (§5).
   · Con JS, los vídeos que no se ven y sus pautas llevan `hidden`, así que
     no se leen ni se tabulan. El carrusel NO avanza solo: lo mueve la
     persona, así que no hay nada que pausar (2.2.2).
   · Cada punto tiene su dirección (#punto-2-4-9): se puede compartir y
     abrir directamente en él. Es lo que enlazarán los Reels.
   · Al cambiar de vídeo, un aviso `aria-live="polite"` dice cuál es: el foco
     se queda en el botón y quien no ve tiene que saber que algo cambió.
     ARIA justificada (AGENTS.md §1): es la única forma de anunciar un
     cambio que no mueve el foco.

   AÑADIR UN PUNTO: una entrada en src/data/guia-puntos.ts, con sus vídeos en
   public/video/guia/{web,movil}/{es,ca,en}/ y sus imágenes fijas en
   arte/guia/{web,movil}/{es,ca,en}/ (npm run arte). La forma obliga a
   escribirlo en los tres idiomas, y el build se para si falta un póster.
   --------------------------------------------------------------------------- */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Bloque from '../components/Bloque.astro';
import CtaLink from '../components/CtaLink.astro';
import Disclosure from '../components/Disclosure.astro';
import VideoPausable from '../components/VideoPausable.astro';
import { path, type Lang } from '../i18n/config';
import { idiomaDe } from '../i18n/idioma';
import { PUNTOS_GUIA } from '../data/guia-puntos';
import { PREGUNTAS, ACTUALIZADO, type Pregunta } from '../data/preguntas';

const lang = idiomaDe(Astro.url);

/* Los 23 puntos, sus textos en los tres idiomas, en src/data/guia-puntos.ts.
   Vídeo y póster, en el idioma de la página y en dos formatos: 16:9 desde
   768 y 4:5 por debajo (los vídeos se hicieron así, 06/11/2026). */
const posters = import.meta.glob<{ default: ImageMetadata }>('../assets/guia/*/*/*.jpg', { eager: true });
const poster = (formato: 'web' | 'movil', archivo: string) => {
  const img = posters[`../assets/guia/${formato}/${lang}/${archivo}.jpg`];
  if (!img) throw new Error(`Falta el póster ${formato}/${lang}/${archivo}.jpg en arte/guia/ (npm run arte)`);
  return img.default;
};
const PUNTOS = PUNTOS_GUIA.map((p) => ({
  id: p.id,
  ...p.texto[lang],
  web: { archivo: `/video/guia/web/${lang}/${p.archivo}.mp4`, poster: poster('web', p.archivo) },
  movil: { archivo: `/video/guia/movil/${lang}/${p.archivo}.mp4`, poster: poster('movil', p.archivo) },
}));

