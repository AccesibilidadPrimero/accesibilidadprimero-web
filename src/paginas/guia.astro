const total = PUNTOS.length;

/* Preguntas frecuentes (06/11/2026): datos en src/data/preguntas.ts. El blog
   solo existe en castellano, así que su enlace va siempre a /blog/. */
const preguntas = PREGUNTAS[lang];
const hrefDe = (e: NonNullable<Pregunta['enlace']>) => e.url
  ?? `${path(e.ruta!, e.ruta === 'blog' ? 'es' : lang, e.slug)}${e.ancla ? `#${e.ancla}` : ''}`;
/* Para los buscadores: las mismas preguntas en datos estructurados. Google ya
   no las enseña como resultado enriquecido salvo en webs oficiales y de
   salud, pero los buscadores con IA sí las leen. */
const datosPreguntas = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: preguntas.map((q) => ({
    '@type': 'Question',
    name: q.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: [q.corta, ...q.detalle].join(' ') },
  })),
});
const imagenSocial = (await getImage({ src: PUNTOS[0].web.poster, width: 1200, height: 675, fit: 'cover', format: 'jpg', quality: 'high' })).src;
const anchoVideo = { escritorio: 'calc(min(100vw, 1440px) - 48px)', tableta: 'calc(100vw - 48px)', movil: 'calc(100vw - 48px)' };
/* El `alt` de la imagen fija: qué es el vídeo. Lo que enseña, paso a paso,
   ya lo cuenta la pauta de debajo, y no se repite. */
const altDe = (p: (typeof PUNTOS)[number]) => T.alt(p.titulo, p.frase);
---
<Base lang={lang} current="guia" title={T.title} description={T.description} imagen={imagenSocial}>
  <section class="guia-hero" aria-labelledby="guia-titulo">
    <div class="guia-hero__texto">
      <h1 id="guia-titulo" class="guia-hero__titulo">{T.titulo}</h1>
      <p>{T.texto}</p>
    </div>

    <section class="carrusel" aria-label={T.carrusel} data-carrusel>
      <ol class="carrusel__lista">
        {PUNTOS.map((p, i) => (
          <li class="carrusel__video" id={p.id} data-carrusel-video={i}>
            <VideoPausable
              escritorio={p.web}
              movil={p.movil}
              movilPropio
              alt={altDe(p)}
              nombre={p.titulo}
              lang={lang}
              sizes={anchoVideo}
            />
          </li>
        ))}
      </ol>
      <div class="carrusel__nav" data-carrusel-nav hidden>
        <button type="button" class="carrusel__boton" data-carrusel-anterior>
          <svg aria-hidden="true" focusable="false" viewBox="0 0 8 14" width="8" height="14"><path d="M7 1 1 7l6 6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
          <span class="sr-only">{T.anterior}</span>
        </button>
        <p class="carrusel__contador"><span class="sr-only">{T.video} </span><span data-carrusel-actual>1</span><span aria-hidden="true"> / </span><span class="sr-only"> {T.de} </span>{total}</p>
        <button type="button" class="carrusel__boton" data-carrusel-siguiente>
          <svg aria-hidden="true" focusable="false" viewBox="0 0 8 14" width="8" height="14"><path d="M1 1l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
          <span class="sr-only">{T.siguiente}</span>
        </button>
      </div>
      <p class="sr-only" aria-live="polite" data-carrusel-aviso></p>
    </section>
  </section>

  <Bloque id="pauta" titulo={T.hPauta}>
    {PUNTOS.map((p, i) => {
      const x = p;
      return (
        <article class="pauta" data-carrusel-pauta={i} aria-labelledby={`${p.id}-titulo`}>
          <h2 class="pauta__titulo" id={`${p.id}-titulo`}>{x.titulo}</h2>
          <div class="pauta__grupo">
            <p>{x.frase}</p>
            <p>{x.referencia}</p>
          </div>
          <div class="pauta__grupo">
            <h3 class="pauta__sub">{T.falla}</h3>
            <p>{x.falla}</p>
          </div>
          <div class="pauta__grupo">
            <h3 class="pauta__sub">{T.arreglo}</h3>
            <p>{x.arreglo}</p>
            {x.nota && <p>{x.nota}</p>}
          </div>
          <div class="pauta__grupo">
            <h3 class="pauta__sub">{T.comprobar}</h3>
            <p>{x.comprobar}</p>
          </div>
          <div class="pauta__grupo">
            <p>{T.conversion}</p>
            <CtaLink href={`${path('servicios', lang)}#auditoria`}>{T.verAuditoria}</CtaLink>
          </div>
        </article>
      );
    })}
  </Bloque>

  <section class="info" aria-labelledby="info-titulo">
    <h2 id="info-titulo" class="sr-only">{T.hInfo}</h2>
    <ul class="info__columnas">
      {COLUMNAS[lang].map((c) => (
        <li class="info__columna">
          <h3 class="info__titulo">{c.titulo}</h3>
          <p>{c.resumen}</p>
          <Disclosure id={`info-${c.id}`} contexto={c.titulo} lang={lang}>
            {c.parrafos?.map((t) => <p>{t}</p>)}
            {c.glosario && (
              <dl class="info__glosario">
                {c.glosario.map(([termino, definicion]) => (
                  <div><dt>{termino}</dt><dd>{definicion}</dd></div>
                ))}
              </dl>
            )}
          </Disclosure>
        </li>
      ))}
    </ul>
  </section>

  <Bloque id="preguntas" titulo={T.hPreguntas}>
    <div class="preguntas">
      <ul class="preguntas__lista">
        {preguntas.map((q) => (
          <li class="pregunta" id={`pregunta-${q.id}`}>
            <h3 class="pregunta__titulo">{q.pregunta}</h3>
            {/* El correo no cabe a 320 sin cortarse: <wbr> detrás de la arroba (§4). */}
            <p>{q.corta.split('@').map((t, i) => <>{i > 0 && <>@<wbr /></>}{t}</>)}</p>
            <Disclosure id={`pregunta-${q.id}-detalle`} contexto={q.pregunta} lang={lang}>
              {q.detalle.map((t) => <p>{t}</p>)}
              {q.enlace && <CtaLink href={hrefDe(q.enlace)}>{q.enlace.texto}</CtaLink>}
            </Disclosure>
          </li>
        ))}
      </ul>
      <p>{ACTUALIZADO[lang]}</p>
    </div>
  </Bloque>

  <script type="application/ld+json" set:html={datosPreguntas} />
</Base>

<script>
  /* El carrusel: un vídeo y su pauta a la vista, los demás con `hidden`.
     Sin JS no se ejecuta y se ve todo, uno debajo de otro. */
  const raiz = document.querySelector<HTMLElement>('[data-carrusel]');
  if (raiz) {
    const videos = [...raiz.querySelectorAll<HTMLElement>('[data-carrusel-video]')];
    const pautas = [...document.querySelectorAll<HTMLElement>('[data-carrusel-pauta]')];
    const nav = raiz.querySelector<HTMLElement>('[data-carrusel-nav]')!;
    const anterior = raiz.querySelector<HTMLButtonElement>('[data-carrusel-anterior]')!;
    const siguiente = raiz.querySelector<HTMLButtonElement>('[data-carrusel-siguiente]')!;
    const actual = raiz.querySelector<HTMLElement>('[data-carrusel-actual]')!;
    const aviso = raiz.querySelector<HTMLElement>('[data-carrusel-aviso]')!;
    let i = Math.max(0, videos.findIndex((v) => `#${v.id}` === location.hash));

    const mostrar = (n: number, anunciar: boolean) => {
      i = n;
      videos.forEach((v, k) => { v.hidden = k !== i; });
      pautas.forEach((p, k) => { p.hidden = k !== i; });
      actual.textContent = String(i + 1);
      anterior.disabled = i === 0;
      siguiente.disabled = i === videos.length - 1;
      if (anunciar) {
        const titulo = pautas[i]?.querySelector('h2')?.textContent ?? '';
        aviso.textContent = `${i + 1} / ${videos.length}: ${titulo}`;
        history.replaceState(null, '', `#${videos[i].id}`);
      }
    };
    anterior.addEventListener('click', () => mostrar(Math.max(0, i - 1), true));
    siguiente.addEventListener('click', () => mostrar(Math.min(videos.length - 1, i + 1), true));
    nav.hidden = false;
    mostrar(i, false);
  }
</script>

