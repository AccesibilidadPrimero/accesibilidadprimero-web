---
import { NAV_LEGAL, path, type Lang } from '../i18n/config';
import { t } from '../i18n/ui';
import { conMarca } from '../i18n/marca';
const { lang } = Astro.props as { lang: Lang };
const ui = t(lang);
---

<footer class="pie">
  <p class="pie__copy" set:html={conMarca(ui.footerCopyright)} />
  <p class="pie__lema" set:html={conMarca(ui.footerTagline)} />
  <!-- Dos <nav> en la misma página: los dos con aria-label, y distintos. -->
  <nav aria-label={ui.footerNavLabel} class="pie__nav">
    <ul class="pie__lista">
      {/* El blog, en el pie (Johnny, 07/11/2026): fuera del menú, pero a la
          vista. La lectura fácil sale del pie: ya está en la cabecera (desde 1160)
          y en el menú (por debajo de 1024). Solo queda aquí entre 1024 y 1159,
          donde no cabe en la cabecera y el menú no se abre. */}
      <li><a href={path('blog', lang)} class="pie__enlace">{ui.nav.blog}</a></li>
      {
        NAV_LEGAL.map((key) => (
          <li><a href={path(key, lang)} class="pie__enlace">{ui.nav[key]}</a></li>
        ))
      }
      <li class="pie__lf"><a href={path('lecturaFacil', lang)} class="pie__enlace">{ui.nav.lecturaFacil}</a></li>
    </ul>
  </nav>
</footer>

<style>
  .pie {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    /* Abajo, el TEXTO a 24 del borde, como en la banda del hero (Johnny,
       09/10). Los enlaces miden 44 con letra de pie (interlineado 20), así que
       llevan 12 de aire debajo del texto: el relleno es 24 − 12. Arriba se
       queda el 32 que separa los créditos del cierre de contacto. */
    padding: var(--space-32) var(--gutter-page) calc(var(--space-24) - (var(--touch-min) - var(--meta-leading)) / 2);
    background: var(--surface-raised);
    /* La tercera talla, y la única fuera de las dos de la escala. Los créditos
       son lo único de la página que puede ser más pequeño sin pedir permiso:
       no se leen, se consultan. */
    font-size: var(--meta-size);
    line-height: var(--meta-leading);
  }

  .pie__lista { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-8); }

  /* El separador «·» del Figma es decorativo: se dibuja con CSS en vez de
     meter un nodo de texto que el lector de pantalla tendría que leer. */
  .pie__lista li + li::before {
    content: '·';
    margin-inline-end: var(--space-8);
  }
  .pie__lista li { display: flex; align-items: center; }
  /* La lectura fácil, solo donde la cabecera no la enseña. */
  .pie__lista .pie__lf { display: none; }
  @media (min-width: 1024px) and (max-width: 1159px) { .pie__lista .pie__lf { display: flex; } }

  /* Como la navegación de la cabecera: sin subrayado en reposo, fino al
     pasar. Son una lista de destinos dentro de un <nav>, no enlaces dentro de
     un párrafo, así que el sitio ya dice lo que son (Johnny, 09/10:
     «demasiadas líneas en los links»). */
  .pie__enlace {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    padding-block: var(--space-12);
    text-decoration: none;
  }
  .pie__enlace:is(:hover, :focus-visible) {
    text-decoration: underline;
    text-decoration-thickness: var(--underline-rest);
  }

  /* Móvil 390 (Figma 2203:679): lema, legales y © en ese orden, con 12 entre
     ellos. El orden se cambia SOLO a la vista (Johnny, 09/10); en el HTML
     sigue ©, lema, legales. No mueve el foco: lo único que lo recibe es la
     lista de legales, y su orden interno no cambia. */
  /* El ritmo separa los créditos del cierre en todos los anchos (10/10): los
     32 de arriba se van. Abajo se conserva la regla de los 24 al texto. */
  .pie { padding-block-start: 0; margin-block-start: var(--ritmo-seccion); }

  /* Tableta (Figma 2201:563): el lema en su fila, y debajo el © a la
     izquierda y los legales a la derecha. Mismo criterio que en móvil: el
     orden cambia solo a la vista y no mueve el foco. */
  @media (min-width: 768px) and (max-width: 1023px) {
    .pie { flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; column-gap: var(--space-48); row-gap: var(--space-16); }
    .pie__lema { order: 1; flex-basis: 100%; }
    .pie__copy { order: 2; }
    .pie__nav { order: 3; }
  }
  /* Centrado en móvil (Johnny, 10/10): las tres filas al eje de la pantalla,
     como la frase de Estudio. Los legales se centran como fila, sin cambiar
     su orden. */
  @media (max-width: 767px) {
    .pie { gap: var(--space-12); align-items: center; text-align: center; }
    .pie__lista { justify-content: center; }
    .pie__lema { order: 1; }
    .pie__nav { order: 2; }
    .pie__copy { order: 3; }
  }
  @media (min-width: 1024px) {
    .pie {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-48);
    }
  }
</style>
