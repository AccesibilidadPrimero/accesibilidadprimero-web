---
/* ---------------------------------------------------------------------------
   Cabecera · logotipo + navegación

   En ESCRITORIO (desde 1024) la navegación va a la vista, como en el Figma
   de 1440: con cuatro destinos caben de sobra y esconderlos detrás de un
   icono reduce lo que la gente explora (Johnny, 09/10). Por debajo, en
   tableta y móvil, el menú modal. El corte está en dos sitios con el mismo
   valor: aquí y en MenuModal.astro (CSS y script).

   Medido el 09/10 con la barra forzada: a 1024 el logotipo acaba en 252 y la
   navegación empieza en 353. Con los tres idiomas activos (05/11/2026),
   medido otra vez a 1024: el logotipo acaba en 216 y la navegación empieza
   en 314 (es), 376 (en) y 380 (ca). Cabe, sin desbordar.
   --------------------------------------------------------------------------- */
import { NAV, path, alternates, type Lang, type RouteKey } from '../i18n/config';
import { t } from '../i18n/ui';
import MenuModal from './MenuModal.astro';

interface Props { lang: Lang; current: RouteKey; slug?: string }
const { lang, current, slug } = Astro.props;
const ui = t(lang);
const langs = alternates(current, slug);
---

<header class="header">
  <a href={path('home', lang)} class="header__logo" aria-label={ui.logoLabel}>
    <span aria-hidden="true">Accesibilidad Primero<sup>®</sup></span>
  </a>

  <div class="header__right">
    <nav aria-label={ui.navLabel} class="header__nav">
      <ul class="header__list">
        {
          NAV.map((key) => (
            <li>
              <a
                href={path(key, lang)}
                class="header__link"
                aria-current={key === current ? 'page' : undefined}
              >
                {ui.nav[key]}{ui.navComplemento[key] && <span class="sr-only">{ui.navComplemento[key]}</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      langs.length > 0 && (
        <div class="header__lang">
          <h2 class="sr-only" id="cabecera-idioma">{ui.langGroupLabel}</h2>
          <ul class="header__lang-list" aria-labelledby="cabecera-idioma">
            {
              langs.map((l) => (
                <li>
                  <a
                    href={l.href}
                    hreflang={l.hreflang}
                    lang={l.hreflang}
                    class="header__lang-link"
                    aria-current={l.lang === lang ? 'true' : undefined}
                  >
                    <span aria-hidden="true">{l.code}</span>
                    <span class="sr-only">{l.name}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      )
    }

    <MenuModal lang={lang} current={current} slug={slug} />
  </div>
</header>

<style>
  .header {
    /* Transparente y por encima: en la Home el hero se sube por debajo de la
       cabecera para que el menta llegue hasta arriba, sin banda clara. En el
       resto de páginas, detrás hay Silk y se comporta igual. */
    position: relative;
    z-index: 1;
    background: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-24);
    min-height: var(--header-height);
    padding-inline: var(--gutter-page);
    /* El texto del logotipo y de la navegación a 24 del borde superior: el
       relleno descuenta el aire de los controles de 44 (tokens.css). */
    padding-block: var(--borde-texto);
  }

  .header__logo {
    /* El logotipo es un enlace a la portada, así que es un objetivo táctil
       como cualquier otro. En el Figma mide 17 px de alto porque allí es un
       dibujo; aquí necesita los 44 px de la regla de AP (2.5.8 pide 24). */
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-min);
    font-size: var(--texto-size);
    line-height: var(--texto-leading);
    text-decoration: none;
    flex: none;
  }
  .header__logo:hover {
    text-decoration: underline;
    text-decoration-thickness: var(--underline-rest);
    text-underline-offset: 5px;
  }
  .header__logo sup { font-size: 0.5em; vertical-align: super; }

  /* Entre «Contacto» y «ES» se ven 96: cuatro veces los 24 que hay entre
     palabra y palabra del menú (Johnny, 11/10/2026). Medido de letra a letra.
     El hueco es 84 porque los otros 12 son el relleno de «ES»; el de
     «Contacto» ya lo devuelve el margen negativo de la lista. En el Figma
     `Header Right` va a 72: allí sí cuentan los 12 de «Contacto». */
  .header__right {
    display: flex;
    align-items: center;
    gap: calc(var(--space-96) - var(--space-12));
  }

  /* La navegación en línea y el selector solo existen en escritorio. Por
     debajo los sustituye el menú modal, que es el mismo contenido. */
  .header__nav, .header__lang { display: none; }

  @media (min-width: 1024px) {
    .header__nav, .header__lang { display: block; }
  }

  /* El margen negativo devuelve los 12 de relleno del último enlace: así el
     TEXTO de «Contacto» acaba en el margen derecho, igual que el logotipo
     empieza en el izquierdo. La zona táctil no cambia. Con margen 24 la
     asimetría se notaba (09/10). */
  /* Sin separación entre enlaces (Johnny, 11/10/2026: «las veo muy
     separadas, deben ser múltiplo de 12»). Lo que se ve entre palabra y
     palabra son los 12 + 12 de relleno de los dos enlaces: 24. Las zonas
     pulsables se tocan, pero cada una sigue midiendo 44 de alto. */
  .header__list { display: flex; gap: 0; margin-inline-end: calc(var(--space-12) * -1); }
  .header__lang-list { display: flex; gap: var(--space-4); }

  .header__link, .header__lang-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-min);
    /* 10 arriba y abajo, no 12: con el tamaño único la interlínea pasó de 24 a
       28 y la cabecera se iba a 100 px cuando el Figma dice 96. Con 10 el
       enlace mide 48 de alto —por encima de los 44 de la regla de AP— y la
       cabecera vuelve a 96. `npm run geometria` lo vigila. */
    padding: 0 var(--space-12);
    font-size: var(--texto-size);
    line-height: var(--texto-leading);
    /* La navegación no va subrayada en reposo. Es la excepción documentada al
       sistema de enlaces; la página actual sí lo lleva. */
    text-decoration: none;
  }
  .header__lang-link { min-width: var(--touch-min); }

  .header__link:hover,
  .header__lang-link:hover {
    text-decoration: underline;
    text-decoration-thickness: var(--underline-rest);
    text-underline-offset: 5px;
  }

  /* La página actual: subrayado + aria-current. Nunca solo color (1.4.1). */
  .header__link[aria-current='page'],
  .header__lang-link[aria-current] {
    text-decoration: underline;
    text-decoration-thickness: var(--underline-rest);
    text-underline-offset: 5px;
  }
</style>
