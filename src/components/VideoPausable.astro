---
/* ---------------------------------------------------------------------------
   Vídeo que se mueve solo, con su control de pausa (29/10/2026).

   Lo usan los casos de proyecto: las grabaciones de la web del cliente
   (portada, modales, flujos). Un archivo por tamaño, si lo hay: escritorio
   desde 1024 y tableta por debajo, también en móvil desde el 03/11/2026.
   Si falta la de tableta, se usa la de escritorio.

   · Debajo va el primer fotograma como imagen fija, con la misma dirección
     de arte, y es ella la que lleva el `alt`: sin JS, con «reducir
     movimiento» o mientras carga, es lo que se ve.
   · El <video> va encima con `aria-hidden` (AGENTS.md §1, ARIA justificada):
     es la misma imagen en movimiento y su descripción ya la da el `alt`. Sin
     él, un lector de pantalla encontraría un vídeo sin nombre al lado de una
     imagen que dice lo mismo.
   · EMPIEZA EN PAUSA (Johnny, 29/10/2026): se ve la imagen fija con el
     icono de reproducir y es la persona quien decide. Nada se descarga
     hasta que pulsa. Cuando arranca, va en bucle y se para sola si sale de
     la pantalla.
   · El control es el mismo
     del slider de la Home: icono en un círculo fino,
     pausa o reproducir según el estado (lo lleva la forma, no el color,
     1.4.1), y la palabra para el lector de pantalla junto con el nombre del
     vídeo, para distinguir los controles de una misma página (2.4.4). El
     dibujo mide 32 y el botón 44.
     Como nada se mueve sin que la persona lo pida, 2.2.2 se cumple de
     sobra; el botón de pausa sigue ahí para pararlo.
   · Sin JS no hay botón, porque no haría nada.
   · `auto` (04/11/2026, hero de Itza): arranca solo, UNA vez y sin bucle,
     y se queda en el último fotograma. Como dura más de 5 s, el botón de
     pausa es obligatorio (2.2.2) y está desde el principio. Con «reducir
     movimiento» no arranca: se queda la imagen fija, que en este caso es el
     ÚLTIMO fotograma, el final de la consulta. Al terminar, el botón vuelve
     a «Reproducir» y la vuelve a empezar.
   `npm run movimiento` lo mide sobre los archivos servidos (§2.9).
   --------------------------------------------------------------------------- */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/config';

interface Fuente { archivo: string; poster: ImageMetadata }
interface Props {
  escritorio: Fuente;
  tableta?: Fuente;
  movil?: Fuente;
  /** Lo que se ve en el vídeo, entero. */
  alt: string;
  /** Para el nombre del botón: «Pausar · <nombre>». */
  nombre: string;
  lang: Lang;
  /** El ancho con que se pinta en cada tamaño, para elegir la imagen. */
  sizes: { escritorio: string; tableta: string; movil: string };
  class?: string;
  /** Arranca solo, una vez (ver arriba). */
  auto?: boolean;
}
const { escritorio, tableta = escritorio, alt, nombre, lang, sizes, class: clase, auto = false } = Astro.props;
/* En móvil, la versión de tableta (Johnny, 03/11/2026): se acepta `movil`
   para no tocar los casos, pero no se usa. */
const movil = tableta;
const ui = t(lang);

/* Los anchos que se generan, sin pasar del original. */
const anchos = (max: number, lista: number[]) => lista.filter((w) => w < max).concat(max);
const fuentes = async (img: ImageMetadata, lista: number[]) => {
  const ws = anchos(img.width, lista);
  const de = async (format: 'avif' | 'webp') => (await Promise.all(ws.map(async (w) =>
    `${(await getImage({ src: img, width: w, format, quality: 'high' })).src} ${w}w`))).join(', ');
  return { avif: await de('avif'), webp: await de('webp'), w: img.width, h: img.height };
};
const pE = await fuentes(escritorio.poster, [480, 860, 1440, 1920]);
const pT = await fuentes(tableta.poster, [360, 720, 1024]);
const pM = await fuentes(movil.poster, [280, 560, 780]);
const respaldo = await getImage({ src: movil.poster, width: Math.min(560, movil.poster.width), format: 'jpg', quality: 'high' });
---

<div class:list={['vp', clase]} data-video-pausable data-parado data-vp-auto={auto ? '' : undefined}
     data-video-escritorio={escritorio.archivo} data-video-tableta={tableta.archivo} data-video-movil={movil.archivo}>
  <div class="vp__marco">
    <picture>
      <source media="(min-width: 1024px)" type="image/avif" srcset={pE.avif} sizes={sizes.escritorio} width={pE.w} height={pE.h} />
      <source media="(min-width: 1024px)" type="image/webp" srcset={pE.webp} sizes={sizes.escritorio} width={pE.w} height={pE.h} />
      <source media="(min-width: 768px)" type="image/avif" srcset={pT.avif} sizes={sizes.tableta} width={pT.w} height={pT.h} />
      <source media="(min-width: 768px)" type="image/webp" srcset={pT.webp} sizes={sizes.tableta} width={pT.w} height={pT.h} />
      <source type="image/avif" srcset={pM.avif} sizes={sizes.movil} width={pM.w} height={pM.h} />
      <source type="image/webp" srcset={pM.webp} sizes={sizes.movil} width={pM.w} height={pM.h} />
      <img src={respaldo.src} width={pM.w} height={pM.h} alt={alt} class="vp__imagen" loading="lazy" decoding="async" />
    </picture>
    <video class="vp__video" aria-hidden="true" muted loop={!auto} playsinline preload="none"></video>
  </div>
  <button type="button" class="vp__control" data-vp-control
          data-label-pausar={ui.carouselPause} data-label-reproducir={ui.carouselPlay}>
    <svg class="vp__icono" aria-hidden="true" focusable="false" viewBox="0 0 10 12" width="10" height="12">
      <g class="vp__pausa"><rect x="0" y="0" width="3" height="12" /><rect x="7" y="0" width="3" height="12" /></g>
      <path class="vp__play" d="M1 0 10 6 1 12z" />
    </svg>
    <span class="sr-only"><span data-vp-label>{ui.carouselPlay}</span> · {nombre}</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-video-pausable]').forEach((raiz) => {
    const video = raiz.querySelector<HTMLVideoElement>('video');
    const control = raiz.querySelector<HTMLButtonElement>('[data-vp-control]');
    const etiqueta = raiz.querySelector<HTMLElement>('[data-vp-label]');
    if (!video || !control || !etiqueta) return;
    const escritorio = window.matchMedia('(min-width: 1024px)');
    const tableta = window.matchMedia('(min-width: 768px)');
    const pausar = control.dataset.labelPausar ?? 'Pausar';
    const reproducir = control.dataset.labelReproducir ?? 'Reproducir';
    // Empieza en pausa y lo arranca la persona, salvo `auto` sin «reducir movimiento».
    let quiere = raiz.hasAttribute('data-vp-auto') && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let visible = false;

    const archivo = () => (escritorio.matches ? raiz.dataset.videoEscritorio
      : tableta.matches ? raiz.dataset.videoTableta : raiz.dataset.videoMovil) ?? '';
    const pintar = () => {
      etiqueta.textContent = quiere ? pausar : reproducir;
      raiz.toggleAttribute('data-parado', !quiere);
    };
    const sincronizar = () => {
      pintar();
      if (!visible || !quiere) { video.pause(); return; }
      const src = archivo();
      if (video.getAttribute('src') !== src) { video.classList.remove('is-listo'); video.src = src; }
      // Si el navegador se niega (ahorro de energía), el botón dice la verdad.
      video.play().catch(() => { quiere = false; pintar(); });
    };

    video.addEventListener('playing', () => video.classList.add('is-listo'));
    video.addEventListener('ended', () => { quiere = false; pintar(); });
    control.addEventListener('click', () => { quiere = !quiere; sincronizar(); });
    // Al cambiar de tamaño se vuelve a la imagen fija hasta que el otro vídeo arranque.
    [escritorio, tableta].forEach((m) => m.addEventListener('change', () => {
      if (video.getAttribute('src') !== archivo()) { video.classList.remove('is-listo'); video.pause(); video.removeAttribute('src'); video.load(); }
      sincronizar();
    }));
    new IntersectionObserver(
      (es) => es.forEach((e) => { visible = e.isIntersecting; sincronizar(); }),
      { threshold: 0.3 },
    ).observe(raiz);
    sincronizar();
  });
</script>

<style>
  /* El ancho lo pone quien lo usa (la clase que recibe). Debajo, el control,
     a la derecha y con el texto del borde a plomo con el vídeo. */
  .vp { display: flex; flex-direction: column; align-items: flex-end; gap: var(--space-8); width: 100%; }
  .vp__marco { position: relative; width: 100%; }
  .vp picture { display: block; width: 100%; }
  .vp__imagen { display: block; width: 100%; height: auto; border-radius: var(--radio); }
  .vp__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radio);
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .vp__video.is-listo { opacity: 1; }

  /* El control del slider de la Home (ProjectSlider.astro): 44 de zona y un
     círculo de 32 dibujado dentro. El margen negativo pone el círculo a
     plomo con el borde del vídeo. */
  .vp__control {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--touch-min);
    height: var(--touch-min);
    margin-inline-end: -6px;
    padding: 0;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
  }
  .vp__control::before {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .vp__control:hover::before { transform: scale(1.1); }
  .vp__icono { fill: currentColor; }
  .vp__play { display: none; }
  [data-parado] .vp__pausa { display: none; }
  [data-parado] .vp__play { display: inline; }
  html:not(.js) .vp__control { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .vp__video, .vp__control::before { transition: none; }
  }
</style>
