---
/* ---------------------------------------------------------------------------
   Divulgación progresiva · «Leer más»

   Es un <button>, no un enlace: no navega, muestra contenido que ya está en la
   página. El panel se oculta con el atributo `hidden`, no con visibility ni
   height:0; si sigue en el árbol de accesibilidad, el lector anuncia contenido
   que el usuario cree cerrado.

   Los tres botones de la Home dicen lo mismo, así que cada uno necesita
   contexto en su nombre accesible (2.4.4). De ahí `contexto`.
   --------------------------------------------------------------------------- */
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/config';

interface Props { id: string; contexto: string; lang: Lang }
const { id, contexto, lang } = Astro.props;
const ui = t(lang);
---

<div class="disclosure" data-disclosure>
  <button
    type="button"
    class="disclosure__boton"
    aria-expanded="false"
    aria-controls={id}
    data-disclosure-trigger
    data-label-abierto={ui.readMore}
    data-label-cerrado={ui.readLess}
  >
    <span data-disclosure-label>{ui.readMore}</span>
    <span class="sr-only"> sobre {contexto}</span>
    {/* Un + que gira 45° y se vuelve ×. Es el signo de «desplegar», distinto
        de las flechas de los enlaces: así se distinguen a simple vista los
        tres gestos de la web —desplegar (+), ir a otra página (→) y salir
        (↗)—. Decorativo: el estado lo dicen `aria-expanded` y la palabra,
        que cambia a «Leer menos». */}
    <svg class="disclosure__signo" aria-hidden="true" focusable="false" viewBox="0 0 12 12" width="12" height="12">
      <path d="M6 0v12M0 6h12" fill="none" stroke="currentColor" stroke-width="1.5" />
    </svg>
  </button>

  <div id={id} hidden data-disclosure-panel class="disclosure__panel">
    <slot />
  </div>
</div>

<style>
  /* Sin JavaScript el panel se queda visible y el botón no se pinta: un botón
     muerto en pantalla es peor que no tener botón (AGENTS.md §5). */
  html:not(.js) .disclosure__boton { display: none; }
  html:not(.js) .disclosure__panel,
  html:not(.js) .disclosure__panel[hidden] { display: block; }

  .disclosure__boton {
    background: none;
    border: 0;
    padding: var(--space-12) var(--space-8);
    margin-inline-start: calc(var(--space-8) * -1);
    min-height: var(--touch-min);
    /* En negro y sin subrayado (Johnny, 09/10). Lo que dice que se pulsa es
       el +, igual que en los enlaces lo dice la flecha. */
    color: var(--text);
    font-size: var(--texto-size);
    line-height: var(--texto-leading);
    cursor: pointer;
    text-decoration: none;
  }
  .disclosure__signo {
    display: inline-block;
    margin-inline-start: var(--space-8);
    vertical-align: 0.05em;
    transition: transform var(--dur-base) var(--ease-out);
  }
  /* Abierto, el + gira 45° y es una ×. Al pasar por encima el signo crece un
     poco y NO gira: un giro pasa por los 45° a mitad de camino y enseña una ×
     («cerrar») cuando todavía está cerrado. */
  .disclosure__boton:is(:hover, :focus-visible) .disclosure__signo { transform: scale(1.2); }
  .disclosure__boton[aria-expanded='true'] .disclosure__signo { transform: rotate(45deg); }
  .disclosure__boton[aria-expanded='true']:is(:hover, :focus-visible) .disclosure__signo { transform: rotate(45deg) scale(1.2); }

  .disclosure__panel { padding-block-start: var(--space-16); }
</style>

<script>
  document.documentElement.classList.add('js');

  document.querySelectorAll<HTMLElement>('[data-disclosure]').forEach((root) => {
    const boton = root.querySelector<HTMLButtonElement>('[data-disclosure-trigger]');
    const panel = root.querySelector<HTMLElement>('[data-disclosure-panel]');
    const label = root.querySelector<HTMLElement>('[data-disclosure-label]');
    if (!boton || !panel || !label) return;

    boton.addEventListener('click', () => {
      const abierto = boton.getAttribute('aria-expanded') === 'true';
      boton.setAttribute('aria-expanded', String(!abierto));
      panel.hidden = abierto;
      label.textContent = abierto
        ? (boton.dataset.labelAbierto ?? 'Leer más')
        : (boton.dataset.labelCerrado ?? 'Leer menos');
      // El foco se queda en el botón. Moverlo solo se justifica en diálogos.
    });
  });
</script>
