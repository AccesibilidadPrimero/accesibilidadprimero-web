---
/* ---------------------------------------------------------------------------
   Bloque de página interior · Contacto y Estudio.

   Estructura copiada de madebyaran.com/about (la estructura, no el estilo):
   el nombre del bloque a la izquierda y el contenido a la derecha. Aquí el
   nombre es un <h2> de verdad, no un div: es lo que permite saltar de bloque
   en bloque con un lector de pantalla.

   · Escritorio (≥ 1024): nombre en 204 y contenido desde 456 del borde de la
     columna (204 + 252 de hueco, sobre 1392). Como proporción, para que a
     1024 el contenido no se quede sin sitio.
   · Tableta y móvil: el nombre arriba y el contenido 64 más abajo
     (`--ritmo-intro`).
   · Entre bloques, 128 (`--ritmo-seccion`), como entre las secciones de la
     Home.
   · `fondo` (Johnny, 30/10/2026: Servicios en rosa y Clientes en gris claro
     en Estudio): el bloque pasa a banda de color de borde a borde, con el
     mismo relleno que la banda de Estudio en la Home (96 arriba y abajo; 64
     en móvil). El texto sigue en Ink: rinde sobre los dos.
   --------------------------------------------------------------------------- */
interface Props {
  id: string;
  titulo: string;
  /** Plegado: el título es un botón que abre el contenido (Servicios,
      Johnny, 03/11/2026). Comportamiento en src/scripts/plegable.ts. */
  desplegable?: boolean;
  /** Desplegable que carga abierto (Diseño y desarrollo, 03/11/2026). */
  abierto?: boolean;
  /** El título solo para el lector de pantalla (Contacto, 03/11/2026). */
  tituloOculto?: boolean;
  /** Desplegable: una frase visible aunque esté cerrado (04/11/2026). */
  resumen?: string;
  /** Banda de color: 'rosa' (Rose AP) o 'gris' (Silk). */
  fondo?: 'rosa' | 'gris';
}
const { id, titulo, fondo, desplegable = false, abierto = false, tituloOculto = false, resumen } = Astro.props;
---

{desplegable ? (
  /* Desde el 05/11/2026 (Johnny: «me gustaba más cómo estaba diseñado
     antes»): el bloque de siempre, con el título en su columna y su ritmo de
     128, el párrafo descriptivo a la vista y, al final del texto, un + que
     despliega el resto. El + es el botón del patrón de la WAI, con
     `aria-expanded` y `aria-controls`. */
  <section class:list={['bloque', 'bloque--masinfo', fondo && `bloque--${fondo}`]} aria-labelledby={id}>
    <h2 id={id} class="bloque__titulo">{titulo}</h2>
    <div class="bloque__contenido">
      <p class="bloque__resumen">{resumen}</p>
      {/* «Leer más +», el mismo gesto que en la Home (Disclosure.astro; Johnny,
          05/11/2026): la palabra cambia a «Leer menos» y el + gira a ×. */}
      <button type="button" class="bloque__mas" aria-expanded={abierto ? 'true' : 'false'} aria-controls={`${id}-panel`} data-plegable-boton data-ancla={id} data-label-abierto="Leer más" data-label-cerrado="Leer menos">
        <span data-plegable-label>{abierto ? 'Leer menos' : 'Leer más'}</span><span class="sr-only"> sobre {titulo.charAt(0).toLowerCase() + titulo.slice(1)}</span>
        <svg class="bloque__signo" aria-hidden="true" focusable="false" viewBox="0 0 12 12" width="12" height="12">
          <path d="M6 0v12M0 6h12" fill="none" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
      <div id={`${id}-panel`} class="bloque__panel" hidden={!abierto} data-mov-propio><slot /></div>
    </div>
  </section>
) : (
  <section class:list={['bloque', fondo && `bloque--${fondo}`]} aria-labelledby={id}>
    <h2 id={id} class:list={['bloque__titulo', tituloOculto && 'sr-only']}>{titulo}</h2>
    <div class="bloque__contenido"><slot /></div>
  </section>
)}

<script>
  import '../scripts/plegable';
</script>

<style>
  .bloque {
    display: flex;
    flex-direction: column;
    gap: var(--ritmo-intro);
    padding: 0 var(--gutter-page);
    margin-block-start: var(--ritmo-seccion);
  }
  .bloque--rosa, .bloque--gris { padding-block: var(--space-64); }
  .bloque--rosa { background: var(--rose-ap); }
  .bloque--gris { background: var(--surface-band); }
  @media (min-width: 768px) { .bloque--rosa, .bloque--gris { padding-block: var(--space-96); } }
  .bloque__titulo { margin: 0; font-size: inherit; line-height: inherit; font-weight: 400; }
  .bloque__contenido { min-width: 0; }

  /* ---- Más información (05/11/2026) ----
     El bloque normal; el párrafo descriptivo a la vista y el + al final del
     texto, en su renglón. El botón mide 44 × 44 (la zona táctil) y se sale
     del renglón por arriba y por abajo con márgenes negativos, para no
     abrirlo. Lo desplegado va a 24 del párrafo, como entre párrafos. */
  /* La medida común de los párrafos (base.css, --measure), como antes. */
  .bloque__resumen { margin: 0; }
  /* Como el botón de Disclosure.astro: texto, + a 8, 44 de alto. */
  .bloque__mas {
    display: block; align-self: flex-start;
    background: none; border: 0; cursor: pointer; text-decoration: none; color: var(--text);
    padding: var(--space-12) var(--space-8);
    margin-inline-start: calc(var(--space-8) * -1);
    margin-block-start: calc(var(--space-16) - var(--space-12));
    min-height: var(--touch-min);
    font-size: var(--texto-size); line-height: var(--texto-leading);
  }
  .bloque__mas .bloque__signo { display: inline-block; margin-inline-start: var(--space-8); vertical-align: 0.05em; }
  .bloque__signo { flex: none; transition: transform var(--dur-base) var(--ease-out); }
  .bloque__mas:hover .bloque__signo, .bloque__mas:focus-visible .bloque__signo { transform: scale(1.2); }
  .bloque__mas[aria-expanded='true'] .bloque__signo { transform: rotate(45deg); }
  .bloque__mas[aria-expanded='true']:is(:hover, :focus-visible) .bloque__signo { transform: rotate(45deg) scale(1.2); }
  .bloque__panel { padding-block-start: var(--space-16); }
  :global(html:not(.js)) .bloque__panel[hidden] { display: block; }
  :global(html:not(.js)) .bloque__mas { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .bloque__panel:not([hidden]) { animation: bloque-despliega var(--dur-despliegue) var(--ease-asentar); }
  }
  /* Reducir no es eliminar (AGENTS.md §2.3): sin desplazamiento, el fundido. */
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .bloque__panel:not([hidden]) { animation: bloque-funde var(--dur-fundido-reducido) linear; }
  }
  @keyframes bloque-despliega { from { opacity: 0; transform: translateY(var(--recorrido-despliegue)); } }
  @keyframes bloque-funde { from { opacity: 0; } }

  @media (min-width: 1024px) {
    .bloque {
      display: grid;
      grid-template-columns: calc(456 / 1392 * 100%) minmax(0, 1fr);
      gap: 0;
    }
    /* El nombre en su columna de 204, aunque sea largo («Organizaciones y
       proyectos» parte en dos renglones, como en el Figma). */
    .bloque__titulo { max-width: 204px; }
  }
  /* Al llegar con un ancla (submenú de Servicios) el título no queda pegado
     al borde de la ventana. */
  .bloque__titulo { scroll-margin-block-start: var(--space-48); }
</style>
