---
/* ---------------------------------------------------------------------------
   Bloque de página interior · Contacto y Estudio.

   Estructura copiada de madebyaran.com/about (la estructura, no el estilo):
   el nombre del bloque a la izquierda y el contenido a la derecha. Aquí el
   nombre es un <h2> de verdad, no un div: es lo que permite saltar de bloque
   en bloque con un lector de pantalla.

   · Escritorio (≥ 1024): nombre en 204 y contenido desde 456 del borde de la
     columna (204 + 252 de hueco, sobre 1392). Como proporción, para que a
     1024 el contenido no se quede sin sitio.
   · Tableta y móvil: el nombre arriba y el contenido 64 más abajo
     (`--ritmo-intro`).
   · Entre bloques, 128 (`--ritmo-seccion`), como entre las secciones de la
     Home.
   · `fondo` (Johnny, 30/10/2026: Servicios en rosa y Clientes en gris claro
     en Estudio): el bloque pasa a banda de color de borde a borde, con el
     mismo relleno que la banda de Estudio en la Home (96 arriba y abajo; 64
     en móvil). El texto sigue en Ink: rinde sobre los dos.
   --------------------------------------------------------------------------- */
interface Props {
  id: string;
  titulo: string;
  /** Plegado: el título es un botón que abre el contenido (Servicios,
      Johnny, 03/11/2026). Comportamiento en src/scripts/plegable.ts. */
  desplegable?: boolean;
  /** Desplegable que carga abierto (Diseño y desarrollo, 03/11/2026). */
  abierto?: boolean;
  /** El título solo para el lector de pantalla (Contacto, 03/11/2026). */
  tituloOculto?: boolean;
  /** Desplegable: una frase visible aunque esté cerrado (04/11/2026). */
  resumen?: string;
  /** Banda de color: 'rosa' (Rose AP) o 'gris' (Silk). */
  fondo?: 'rosa' | 'gris';
}
const { id, titulo, fondo, desplegable = false, abierto = false, tituloOculto = false, resumen } = Astro.props;
---

{desplegable ? (
  <section class:list={['bloque', 'bloque--desplegable', fondo && `bloque--${fondo}`]} aria-labelledby={id}>
    <h2 class="bloque__titulo">
      <button type="button" id={id} class="bloque__boton" aria-expanded={abierto ? 'true' : 'false'} aria-controls={`${id}-panel`} aria-describedby={resumen ? `${id}-resumen` : undefined} data-plegable-boton>
        <span>{titulo}</span>
        {/* El + de Disclosure.astro: el gesto de «desplegar» de la web. */}
        <svg class="bloque__signo" aria-hidden="true" focusable="false" viewBox="0 0 12 12" width="12" height="12">
          <path d="M6 0v12M0 6h12" fill="none" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
    </h2>
    {resumen && <p id={`${id}-resumen`} class="bloque__resumen">{resumen}</p>}
    <div id={`${id}-panel`} class="bloque__contenido" hidden={!abierto} data-mov-propio><slot /></div>
  </section>
) : (
  <section class:list={['bloque', fondo && `bloque--${fondo}`]} aria-labelledby={id}>
    <h2 id={id} class:list={['bloque__titulo', tituloOculto && 'sr-only']}>{titulo}</h2>
    <div class="bloque__contenido"><slot /></div>
  </section>
)}

<script>
  import '../scripts/plegable';
</script>

<style>
  .bloque {
    display: flex;
    flex-direction: column;
    gap: var(--ritmo-intro);
    padding: 0 var(--gutter-page);
    margin-block-start: var(--ritmo-seccion);
  }
  .bloque--rosa, .bloque--gris { padding-block: var(--space-64); }
  .bloque--rosa { background: var(--rose-ap); }
  .bloque--gris { background: var(--surface-band); }
  @media (min-width: 768px) { .bloque--rosa, .bloque--gris { padding-block: var(--space-96); } }
  .bloque__titulo { margin: 0; font-size: inherit; line-height: inherit; font-weight: 400; }
  .bloque__contenido { min-width: 0; }

  /* ---- Desplegable (03/11/2026) ----
     Los bloques plegados van seguidos, separados solo por un filete: con 128
     de aire, una lista de títulos cerrados se deshace. El 128 que los separa
     del hero lo pone la página en el contenedor (servicios.astro): entre dos
     bloques Astro puede dejar un <script>, y un `+` de CSS no lo salta. */
  .bloque--desplegable { gap: 0; margin-block-start: 0; }
  /* El filete va en el título y no en la sección: así respeta los márgenes de
     la página en vez de ir de borde a borde. */
  .bloque--desplegable .bloque__titulo { border-block-start: 1px solid var(--rule); }
  .bloque__boton {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-16);
    inline-size: 100%; min-height: var(--touch-min); padding: var(--space-24) 0;
    background: none; border: 0; color: var(--text); font: inherit; text-align: start; cursor: pointer;
  }
  .bloque__boton:focus-visible { outline: var(--focus-width) solid var(--focus-ring); outline-offset: 2px; }
  .bloque__signo { flex: none; transition: transform var(--dur-base) var(--ease-out); }
  .bloque__boton:is(:hover, :focus-visible) .bloque__signo { transform: scale(1.2); }
  .bloque__boton[aria-expanded='true'] .bloque__signo { transform: rotate(45deg); }
  .bloque--desplegable .bloque__contenido { padding-block-end: var(--space-48); }
  /* El resumen, visible con el bloque cerrado (auditoría de usabilidad,
     04/11/2026): se elige servicio sabiendo qué es cada uno. */
  .bloque__resumen { margin: 0; padding-block-end: var(--space-24); margin-block-start: calc(var(--space-8) - var(--space-24)); }
  :global(html:not(.js)) .bloque--desplegable .bloque__contenido[hidden] { display: block; }
  :global(html:not(.js)) .bloque__signo { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .bloque--desplegable .bloque__contenido:not([hidden]) { animation: bloque-despliega var(--dur-despliegue) var(--ease-asentar); }
  }
  /* Reducir no es eliminar (AGENTS.md §2.3, 04/11/2026): sin desplazamiento,
     el fundido de 300 ms. El panel lleva data-mov-propio, así que la regla
     global no lo deja en 0,01 ms; sin esto, con reducir movimiento se abría
     de golpe. */
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .bloque--desplegable .bloque__contenido:not([hidden]) { animation: bloque-funde var(--dur-fundido-reducido) linear; }
  }
  @keyframes bloque-despliega { from { opacity: 0; transform: translateY(var(--recorrido-despliegue)); } }
  @keyframes bloque-funde { from { opacity: 0; } }

  @media (min-width: 1024px) {
    .bloque {
      display: grid;
      grid-template-columns: calc(456 / 1392 * 100%) minmax(0, 1fr);
      gap: 0;
    }
    /* El nombre en su columna de 204, aunque sea largo («Organizaciones y
       proyectos» parte en dos renglones, como en el Figma). */
    .bloque__titulo { max-width: 204px; }
    /* Plegado, el título ocupa la fila entera: el + a la derecha del todo,
       y el contenido abierto debajo, en su columna. */
    .bloque--desplegable { grid-template-columns: calc(456 / 1392 * 100%) minmax(0, 1fr); }
    .bloque--desplegable .bloque__titulo { grid-column: 1 / -1; max-width: none; }
    .bloque--desplegable .bloque__contenido { grid-column: 2; }
    .bloque--desplegable .bloque__resumen { grid-column: 2; }
  }
  /* Al llegar con un ancla (submenú de Servicios) el título no queda pegado
     al borde de la ventana. */
  .bloque__boton { scroll-margin-block-start: var(--space-48); }
</style>
