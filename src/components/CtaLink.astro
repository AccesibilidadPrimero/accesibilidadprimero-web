---
/* ---------------------------------------------------------------------------
   Enlace suelto del sistema · texto + flecha, SIN subrayado.

   Dos tipos, y la flecha dice cuál es (Johnny, 09/10):

     →  va a otra página de esta web
     ↗  sale de la web (y se abre en otra pestaña)

   La flecha está SIEMPRE visible. Sin subrayado, es lo único que dice «esto se
   pulsa»; esconderla hasta el hover la quitaría en móvil y tableta, donde no
   hay hover, y a quien navega con teclado. Al pasar por encima o al recibir el
   foco, la flecha se desplaza un poco en su dirección: es la respuesta al
   gesto, nunca la única señal.

   Sin subrayado vale porque son enlaces SUELTOS, en su propia línea. Un
   enlace dentro de un párrafo sí lleva subrayado (base.css): ahí el color no
   basta para distinguirlo del texto que lo rodea (1.4.1).

   La flecha es decorativa (aria-hidden): el nombre accesible es el texto.
   --------------------------------------------------------------------------- */
interface Props {
  href: string;
  size?: 'small' | 'default' | 'large';
  external?: boolean;
  class?: string;
}
const { href, size = 'default', external = false, class: className } = Astro.props;
const esExterno = external || /^https?:\/\//.test(href);
---

<a
  href={href}
  class:list={['cta', `cta--${size}`, esExterno ? 'cta--externo' : 'cta--interno', className]}
  {...esExterno ? { rel: 'noopener', target: '_blank' } : {}}
>
  <span><slot /></span>
  {
    esExterno && (
      /* «se abre en una ventana nueva» no es decorativo: cambia lo que va a
         pasar al pulsar, y quien no ve la pestaña necesita saberlo (3.2.5). */
      <span class="sr-only"> (se abre en una ventana nueva)</span>
    )
  }
  {
    esExterno ? (
      <svg class="cta__arrow" aria-hidden="true" focusable="false" viewBox="0 0 14 14" width="14" height="14">
        <path d="M1.5 12.5 12 2M4.5 2H12v7.5" fill="none" stroke="currentColor" stroke-width="1.5" />
      </svg>
    ) : (
      <svg class="cta__arrow" aria-hidden="true" focusable="false" viewBox="0 0 24 14" width="24" height="14">
        <path d="M0 7h21M15 1l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" />
      </svg>
    )
  }
</a>

<style>
  /* `inline-block` y la flecha DENTRO del flujo, no como hermana flex: cuando
     el texto no cabe en una línea, la flecha viaja con la última palabra en
     vez de quedarse sola pegada al borde. El objetivo táctil lo da el relleno:
     interlínea + relleno = 44. `npm run a11y` mide los 44 px en el render. */
  .cta {
    display: inline-block;
    padding-block: calc((var(--touch-min) - var(--texto-leading)) / 2);
    /* Y además un mínimo explícito: con el interlineado fluido, el relleno
       calculado puede dejar el enlace en 43,99 y `npm run a11y` lo caza. */
    min-block-size: var(--touch-min);
    font-size: var(--texto-size);
    line-height: var(--texto-leading);
    text-decoration: none;
  }
  /* Sin banda gruesa en hover (Johnny, 09/10): el subrayado ya no existe en
     reposo y no aparece al pasar. La respuesta es la flecha. */
  .cta:hover, .cta:active { text-decoration: none; }

  /* Ya no hay talla grande ni pequeña: pintan igual. Las clases se quedan
     porque siguen marcando el papel del enlace en la página. */
  .cta--large, .cta--small { font-size: var(--texto-size); line-height: var(--texto-leading); letter-spacing: 0; }

  .cta__arrow {
    display: inline-block;
    vertical-align: -0.05em;
    /* El espacio va aquí y es INSEPARABLE: la flecha no debe quedarse sola al
       principio de una línea. Por eso el margen y no un `gap`. */
    margin-inline-start: var(--space-12);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .cta--externo .cta__arrow { margin-inline-start: var(--space-8); vertical-align: 0; }

  /* La flecha avanza en su dirección: a la derecha la interna, en diagonal
     hacia arriba la externa. Con el foco de teclado hace lo mismo que con el
     ratón. Con movimiento reducido el desplazamiento es instantáneo (base.css):
     el cambio de estado se sigue viendo, solo que sin el camino. */
  .cta--interno:is(:hover, :focus-visible) .cta__arrow { transform: translateX(var(--space-4)); }
  .cta--externo:is(:hover, :focus-visible) .cta__arrow { transform: translate(3px, -3px); }
</style>
