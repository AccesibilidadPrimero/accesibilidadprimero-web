---
/* ---------------------------------------------------------------------------
   Slider de capturas de un proyecto destacado.

   Del Figma (`Content slider`, uno por caso): un campo del color del proyecto,
   la captura centrada encima, y debajo un control VISIBLE de pausa. Desde el
   09/10 es solo un icono en un círculo fino, sin palabra a la vista y sin
   subrayado: más pequeño y más discreto (Johnny). La palabra sigue ahí para
   el lector de pantalla.

   LAS CAPTURAS ENTRAN DE DERECHA A IZQUIERDA. Así está en el Figma: cada
   slider es una tira con las tres pantallas en fila, dentro de un marco que
   recorta, y la tira se desplaza a la izquierda 0,6 s con ease-out. Aquí cada
   lámina espera a la derecha, entra al centro y sale por la izquierda.

   Medidas del documento, por caso:

     ECI       campo 1368 × 900   captura 904 × 568   aire 126   hueco 36
     Foc i Cor campo  664 × 820   captura 400 × 564   aire  88   hueco 36
     Izaskun   campo 1119 × 640   captura 656 × 412   aire  68   hueco 48

   En Móvil 390 (2203:456) los tres son iguales: campo de 342 (no va a
   sangre, respeta el margen de 24), captura VERTICAL de 294 × 640, 48 de aire
   arriba y abajo, 24 a los lados y 32 hasta el control.

   CAPTURAS DE MÓVIL. Por debajo de 768 cada pantalla se sirve en vertical si
   existe `<archivo>-movil` en arte/proyectos/ (588 × 1280, @2x de 294 × 640).
   Es la misma imagen para el lector de pantalla: un <picture> con una
   <source> por ancho y un solo <img> con un solo `alt`. Si falta alguna de
   las tres, el proyecto entero sigue con las de escritorio: mezclar
   proporciones dentro de un carrusel haría saltar el marco.

   El aire es simétrico arriba y abajo en los tres, y la captura va centrada.

   DOS DECISIONES QUE VIENEN DEL HERO Y SE REPITEN AQUÍ A PROPÓSITO

   1. Las tres capturas están SIEMPRE en el árbol de accesibilidad, con su
      `alt`. La rotación es puramente visual. Quien usa lector de pantalla oye
      las tres descripciones seguidas sin tener que pausar nada ni descubrir
      que hay un control: el contenido no depende de la interacción.

   2. `prefers-reduced-motion` no deja el control inservible: se quita el
      avance automático y el fundido, pero cada pulsación sigue pasando a la
      siguiente. Reducir no es eliminar (AGENTS.md §2.3).
   --------------------------------------------------------------------------- */
import type { ImageMetadata } from 'astro';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/config';

interface Props {
  imagenes: { archivo: string; alt: string }[];
  variante: 'eci' | 'foc' | 'izaskun';
  titulo: string;
  lang: Lang;
}
const { imagenes, variante, titulo, lang } = Astro.props;
const ui = t(lang);

/* Las compila `npm run arte` desde arte/proyectos/. El glob tiene que ser
   literal para que Vite lo resuelva en el build. */
const archivos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/proyectos/*.{png,jpg,jpeg,webp}',
  { eager: true },
);
const buscar = (nombre: string) =>
  Object.entries(archivos).find(([ruta]) => ruta.includes(`/${nombre}.`))?.[1]?.default;

/* Una captura que falta rompe el build y lo dice por su nombre. El esquema ya
   exige tres declaradas; esto comprueba que además existen en disco. */
const faltan = imagenes.filter((i) => !buscar(i.archivo)).map((i) => i.archivo);
/* Las verticales son opcionales, pero van las tres o ninguna (ver arriba). */
const conMovil = imagenes.every((i) => buscar(`${i.archivo}-movil`));
if (faltan.length) {
  throw new Error(
    `Faltan capturas de ${titulo} en src/assets/proyectos/: ${faltan.join(', ')}.\n` +
    'Déjalas en arte/proyectos/ y ejecuta `npm run arte`.',
  );
}
---

<div class:list={['slider', `slider--${variante}`, conMovil && 'slider--con-movil']} data-slider>
  <ul class="slider__pila">
    {
      imagenes.map((im, i) => {
        const meta = buscar(im.archivo)!;
        const movil = conMovil ? buscar(`${im.archivo}-movil`)! : null;
        return (
          <li class="slider__lamina" data-indice={i} data-activa={i === 0 ? '' : undefined}>
            {/* width/height REALES: son los que le dan al navegador la
                proporción antes de descargar. La <source> lleva los suyos,
                que son otros: la vertical tiene otra proporción. */}
            <picture>
              {movil && (
                <source media="(max-width: 767px)" srcset={movil.src} width={movil.width} height={movil.height} />
              )}
              <img
                src={meta.src}
                alt={im.alt}
                width={meta.width}
                height={meta.height}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </picture>
          </li>
        );
      })
    }
  </ul>

  {/* Icono dentro de un círculo fino. El nombre accesible es la palabra
      —«Pausar» o «Reproducir»— más el nombre del proyecto, para distinguir
      los tres controles de la página entre sí (2.4.4). Va en `.sr-only`
      porque a la vista basta el icono: pausa y reproducir son de los pocos
      símbolos que se entienden sin palabra. El dibujo mide 32, pero el botón
      mide 44: la zona que se pulsa no encoge con el dibujo (regla de AP). */}
  <button
    type="button"
    class="slider__control"
    data-slider-control
    data-label-pausar={ui.carouselPause}
    data-label-reproducir={ui.carouselPlay}
  >
    <svg class="slider__icono" aria-hidden="true" focusable="false" viewBox="0 0 10 12" width="10" height="12">
      <g class="slider__pausa"><rect x="0" y="0" width="3" height="12" /><rect x="7" y="0" width="3" height="12" /></g>
      <path class="slider__play" d="M1 0 10 6 1 12z" />
    </svg>
    <span class="sr-only"><span data-slider-label>{ui.carouselPause}</span> · {titulo}</span>
  </button>
</div>

<style>
  .slider {
    --dur-desliza: 600ms;     /* la del Figma: SMART_ANIMATE, 0,6 s, ease-out */
    display: grid;
    justify-items: center;
    background: var(--acento);
    color: var(--texto-sobre-acento);
    /* El anillo de foco de este proyecto, declarado en su ficha y validado en
       build contra el acento. */
    --focus-ring: var(--anillo);
    padding-block: var(--aire);
    gap: var(--hueco);
    /* Johnny, 10/10: «curvar levemente los ángulos». El campo y la captura
       que lleva dentro comparten canto, porque son una pieza. */
    border-radius: var(--radio);
  }

  /* El marco que recorta. Las tres capturas comparten celda —así el campo no
     da un salto de alto al cambiar— y se mueven en horizontal dentro de él.
     `clip` y no `hidden`: no crea un contenedor de scroll. */
  .slider__pila {
    display: grid;
    width: 100%;
    max-width: var(--ancho-captura);
    aspect-ratio: var(--ancho-captura) / var(--alto-captura);
    overflow: clip;
  }
  /* Tres posiciones: esperando a la derecha (por defecto), en el centro
     (`data-activa`) y saliendo por la izquierda (`data-saliente`). Solo hay
     transición al entrar y al salir; al volver a la espera la lámina salta
     sin animarse, porque está fuera del marco y nadie la ve. */
  .slider__lamina {
    grid-area: 1 / 1;
    transform: translateX(100%);
  }
  .slider__lamina[data-activa],
  .slider__lamina[data-saliente] {
    transition: transform var(--dur-desliza) var(--ease-out);
  }
  .slider__lamina[data-activa] { transform: none; }
  .slider__lamina[data-saliente] { transform: translateX(-100%); }
  .slider__lamina picture { display: contents; }
  .slider__lamina img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: var(--radio);
  }

  /* 44 × 44 de zona, 32 de círculo dibujado. El círculo y el icono van en el
     color de texto que el proyecto declara sobre su acento, que el esquema
     valida a 4,5:1: de sobra para el 3:1 que pide un control (1.4.11). */
  .slider__control {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--touch-min);
    height: var(--touch-min);
    padding: 0;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
  }
  .slider__control::before {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .slider__control:hover::before { transform: scale(1.1); }
  .slider__icono { fill: currentColor; }
  /* Parado, el icono pasa de «pausa» a «reproducir»: el estado lo lleva la
     forma, no el color (1.4.1), y el nombre accesible cambia con él. */
  .slider__play { display: none; }
  [data-parado] .slider__pausa { display: none; }
  [data-parado] .slider__play { display: inline; }

  /* Sin JavaScript no hay rotación: se ve la primera y el control no se pinta,
     porque no haría nada (AGENTS.md §5). */
  html:not(.js) .slider__control { display: none; }
  html:not(.js) .slider__lamina { transform: none; }
  html:not(.js) .slider__pila { display: block; aspect-ratio: auto; }
  html:not(.js) .slider__lamina + .slider__lamina { margin-block-start: var(--hueco); }

  /* Con movimiento reducido no hay avance automático y el cambio, cuando lo
     pide el control, es instantáneo: la captura nueva aparece en su sitio. */
  @media (prefers-reduced-motion: reduce) {
    .slider__lamina { transition: none; }
  }

  /* Las medidas del Figma, caso por caso. */
  .slider--eci     { --aire: 126px; --hueco: 36px; --ancho-captura: 904px; --alto-captura: 568px; }
  .slider--foc     { --aire:  88px; --hueco: 36px; --ancho-captura: 400px; --alto-captura: 564px; }
  .slider--izaskun { --aire:  68px; --hueco: 48px; --ancho-captura: 656px; --alto-captura: 412px; }

  /* Tableta, medido en el Figma (Home / Tablet 768: 2201:398, 2201:417,
     2201:439): campo de 720, aire de 92 · 80 · 68 y 36 hasta el control. La
     captura de ECI baja a 540 (la misma proporción); Foc i Cor e Izaskun
     caben a su tamaño. Hasta el 10/10 era «la mitad del aire de escritorio»,
     sin medir. */
  @media (max-width: 1023px) {
    .slider { padding-block: var(--aire-tableta); gap: 36px; }
    .slider__pila { max-width: min(var(--ancho-captura), 100%); }
    .slider--eci     { --aire-tableta: 92px; --ancho-captura: 540px; --alto-captura: 339.3px; }
    .slider--foc     { --aire-tableta: 80px; }
    .slider--izaskun { --aire-tableta: 68px; }
  }

  /* Móvil 390, medido en el Figma (2203:514, 2203:533, 2203:555): los tres
     iguales. El ancho de la captura sale solo: 342 − 24 − 24 = 294. */
  @media (max-width: 767px) {
    .slider { padding: var(--space-48) var(--space-24); gap: var(--space-32); }
    .slider--con-movil,
    .slider--eci.slider--con-movil { --ancho-captura: 294px; --alto-captura: 640px; }
  }
</style>

<script>
  document.documentElement.classList.add('js');

  const INTERVALO = 4000;   // 4 s por captura: son páginas, hay que leerlas

  const PAUSA_POR = { usuario: 'usuario', puntero: 'puntero', fuera: 'fuera' } as const;

  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((raiz) => {
    const laminas = Array.from(raiz.querySelectorAll<HTMLElement>('.slider__lamina'));
    const control = raiz.querySelector<HTMLButtonElement>('[data-slider-control]');
    const etiqueta = raiz.querySelector<HTMLElement>('[data-slider-label]');
    if (laminas.length < 2 || !control || !etiqueta) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let indice = 0;
    let temporizador: number | null = null;
    /* Un conjunto de motivos, no un booleano: el puntero no puede reanudar
       algo que se paró con el teclado. Mismo patrón que el hero. */
    const motivos = new Set<string>([PAUSA_POR.fuera]);
    const parado = () => motivos.size > 0;

    /* La que estaba saliendo vuelve a esperar a la derecha (sin animarse: el
       CSS solo anima la entrada y la salida); la activa sale por la izquierda;
       la siguiente entra desde la derecha. */
    function mostrar(i: number) {
      laminas.forEach((l) => l.removeAttribute('data-saliente'));
      laminas[indice]?.removeAttribute('data-activa');
      laminas[indice]?.setAttribute('data-saliente', '');
      indice = (i + laminas.length) % laminas.length;
      laminas[indice].setAttribute('data-activa', '');
    }

    function arrancar() {
      if (temporizador !== null || reduce.matches) return;
      temporizador = window.setInterval(() => mostrar(indice + 1), INTERVALO);
    }
    function detener() {
      if (temporizador === null) return;
      // Pausar para el TEMPORIZADOR, no solo la animación.
      window.clearInterval(temporizador);
      temporizador = null;
    }

    function sincronizar() {
      if (parado()) { detener(); raiz.setAttribute('data-parado', ''); }
      else { raiz.removeAttribute('data-parado'); arrancar(); }
      etiqueta!.textContent = parado()
        ? (control!.dataset.labelReproducir ?? 'Reproducir')
        : (control!.dataset.labelPausar ?? 'Pausar');
    }

    const pausar = (m: string) => { motivos.add(m); sincronizar(); };
    const reanudar = (m: string) => { motivos.delete(m); sincronizar(); };

    control.addEventListener('click', () => {
      /* Con movimiento reducido no hay nada que pausar: cada pulsación pasa a
         la siguiente captura. El contenido sigue siendo alcanzable entero. */
      if (reduce.matches) { mostrar(indice + 1); return; }
      if (motivos.has(PAUSA_POR.usuario)) reanudar(PAUSA_POR.usuario);
      else pausar(PAUSA_POR.usuario);
    });

    /* El puntero escucha sobre las capturas, que es lo que se está mirando, y
       no sobre el campo entero: el campo llega de margen a margen y pararlo
       desde ahí no se entiende (misma regla que el hero, AGENTS.md §4). */
    const pila = raiz.querySelector<HTMLElement>('.slider__pila')!;
    pila.addEventListener('pointerenter', () => pausar(PAUSA_POR.puntero));
    pila.addEventListener('pointerleave', () => reanudar(PAUSA_POR.puntero));
    // Paridad de teclado: enfocar el control hace lo mismo que el puntero.
    control.addEventListener('focus', () => pausar(PAUSA_POR.puntero));
    control.addEventListener('blur', () => reanudar(PAUSA_POR.puntero));

    /* Las capturas 2 y 3 llevan `loading="lazy"`, y el navegador no las pide
       mientras están fuera del marco que recorta: entraban en blanco. En
       cuanto el carrusel se acerca a la pantalla se piden las tres. */
    const precargar = () => raiz.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => { img.loading = 'eager'; });

    // No arranca al cargar: arranca cuando se ve.
    new IntersectionObserver(
      (es) => es.forEach((e) => {
        if (e.isIntersecting) { precargar(); reanudar(PAUSA_POR.fuera); }
        else pausar(PAUSA_POR.fuera);
      }),
      { threshold: 0.3 },
    ).observe(raiz);

    const aplicarReduce = () => { if (reduce.matches) { detener(); raiz.setAttribute('data-parado', ''); } sincronizar(); };
    reduce.addEventListener('change', aplicarReduce);
    aplicarReduce();
  });
</script>
