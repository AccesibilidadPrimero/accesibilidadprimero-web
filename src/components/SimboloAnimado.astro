<style>
  /* Tamaño (Johnny, 13/10/2026): el del símbolo en la Home. Allí es la
     lámina 07 del carrusel y el dibujo ocupa 180 de alto dentro de los 400
     de la ilustración, centrado. Aquí igual: la caja del hero sigue midiendo
     lo que cualquier ilustración (400 · 320 · 240, la pone HeroPagina) y el
     símbolo, centrado dentro, mide 180 · 144 · 108 (el 45 %). */
  .simbolo.apertura__ilustracion {
    inline-size: auto;
    display: grid;
    place-items: center;
  }
  /* Un 15 % más pequeño que el de la Home (Johnny, 13/10/2026, 12:58):
     153 · 122 · 92 en vez de 180 · 144 · 108. */
  .simbolo__marco { position: relative; block-size: 92px; aspect-ratio: 338.4 / 299.43; }
  @media (min-width: 768px) { .simbolo__marco { block-size: 122px; } }
  @media (min-width: 1024px) { .simbolo__marco { block-size: 153px; } }

  /* Centrado en el hero ENTERO, no en lo que queda encima del texto (Johnny,
     13/10/2026): la caja cubre la banda de borde a borde, cabecera incluida, y
     el símbolo queda en el centro de la pantalla. La caja no recibe el
     puntero (el texto y la cabecera siguen siendo clicables a través de
     ella); solo el dibujo, para repetir el chispeo.
     Solo con ventanas de 600 de alto o más: más bajas, el centro caería sobre
     el titular, y el símbolo vuelve a su sitio en el flujo, encima. */
  @media (min-height: 600px) {
    .simbolo.apertura__ilustracion {
      position: absolute;
      inset: 0;
      block-size: auto;
      pointer-events: none;
    }
    .simbolo__marco { pointer-events: auto; }
  }
  .simbolo__dibujo { display: block; inline-size: 100%; block-size: 100%; fill: #231f20; }
  /* Cuadrados que se tocan dejan una línea clara entre ellos por el
     antialiasing: se veía una rejilla a 1440. Ni un trazo de 0,25 ni los
     bordes a píxel entero (crispEdges abría huecos de 1 px) la quitaban.
     Un trazo de 0,6 del mismo color sí: cada cuadrado crece 0,3 por lado
     y los separados siguen separados. */
  .simbolo__trama rect {
    stroke: #231f20;
    stroke-width: 0.6;
    animation: simbolo-chispa var(--c) var(--d) ease-in-out 1 both;
  }
  @keyframes simbolo-chispa {
    0%, 30%, 70%, 100% { opacity: 1; }
    48%, 52% { opacity: 0.08; }
  }


  @media (prefers-reduced-motion: reduce) {
    .simbolo__trama rect { animation: none; }
  }
</style>

<script>
  /* Al pasar el puntero, otra vuelta: solo a las animaciones que ya han
     terminado, para que pasar y repasar no las corte a medias. Con «reducir
     movimiento» no hay animaciones y esto no hace nada. */
  document.querySelectorAll<HTMLElement>('[data-simbolo]').forEach((marco) => {
    marco.addEventListener('pointerenter', () => {
      marco.getAnimations({ subtree: true }).forEach((a) => {
        if (a.playState === 'finished') { a.currentTime = 0; a.play(); }
      });
    });
  });
</script>
