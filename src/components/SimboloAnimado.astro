<style>
  .simbolo { position: relative; aspect-ratio: 338.4 / 299.43; }
  .simbolo__dibujo { display: block; inline-size: 100%; block-size: 100%; fill: #231f20; }
  /* Cuadrados que se tocan dejan una línea clara entre ellos por el
     antialiasing: se veía una rejilla a 1440. Ni un trazo de 0,25 ni los
     bordes a píxel entero (crispEdges abría huecos de 1 px) la quitaban.
     Un trazo de 0,6 del mismo color sí: cada cuadrado crece 0,3 por lado
     y los separados siguen separados. */
  .simbolo__trama rect {
    stroke: #231f20;
    stroke-width: 0.6;
    animation: simbolo-chispa var(--c) var(--d) ease-in-out 1 both;
  }
  .simbolo[data-bucle] .simbolo__trama rect { animation-iteration-count: infinite; }
  .simbolo[data-parado] .simbolo__trama rect { animation-play-state: paused; }
  @keyframes simbolo-chispa {
    0%, 30%, 70%, 100% { opacity: 1; }
    48%, 52% { opacity: 0.08; }
  }

  .simbolo__control {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    display: grid;
    place-items: center;
    inline-size: var(--touch-min);
    block-size: var(--touch-min);
    padding: 0;
    background: none;
    border: 0;
    color: var(--text);
    cursor: pointer;
  }
  .simbolo__control[hidden] { display: none; }
  .simbolo__icono { fill: currentColor; }
  /* Parado, el icono pasa de pausa a reproducir: el estado lo lleva la
     forma, no el color (1.4.1), y el nombre accesible cambia con él. */
  .simbolo__play { display: none; }
  .simbolo[data-parado] .simbolo__pausa { display: none; }
  .simbolo[data-parado] .simbolo__play { display: inline; }

  @media (prefers-reduced-motion: reduce) {
    .simbolo__trama rect { animation: none; }
    .simbolo__control { display: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-simbolo]').forEach((raiz) => {
    const control = raiz.querySelector<HTMLButtonElement>('[data-simbolo-control]');
    const etiqueta = raiz.querySelector<HTMLElement>('[data-simbolo-label]');
    if (!control || !etiqueta) return;
    // Con «reducir movimiento» no hay animación: ni bucle ni botón.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    raiz.setAttribute('data-bucle', '');
    control.hidden = false;
    control.addEventListener('click', () => {
      const parar = !raiz.hasAttribute('data-parado');
      raiz.toggleAttribute('data-parado', parar);
      etiqueta.textContent = parar
        ? (control.dataset.labelReproducir ?? 'Reproducir')
        : (control.dataset.labelPausar ?? 'Pausar');
    });
  });
</script>
