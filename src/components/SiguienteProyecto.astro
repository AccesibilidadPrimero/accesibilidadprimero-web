---
/* ---------------------------------------------------------------------------
   Siguiente proyecto · al final de cada caso (Johnny, 03/11/2026)

   «Ver Foc i Cor →»: con el nombre del proyecto, no «Siguiente», para que el
   enlace diga adónde lleva sin contexto (2.4.4). El orden es el de Proyectos
   (`orden` en el contenido) y da la vuelta: después del último, el primero.
   Usa `nombreCorto` si lo hay: «Ver ECI Conference» (Johnny, 03/11/2026).
   Va en un <nav> con nombre propio para que se pueda saltar a él como región.
   --------------------------------------------------------------------------- */
import { getCollection } from 'astro:content';
import CtaLink from './CtaLink.astro';

interface Props { actual: string }
const { actual } = Astro.props;

const casos = (await getCollection('proyectos'))
  .filter((p) => p.data.casoPublicado)
  .sort((a, b) => a.data.orden - b.data.orden);
const i = casos.findIndex((c) => c.id === actual);
if (i < 0) throw new Error(`SiguienteProyecto: «${actual}» no es un caso publicado.`);
const siguiente = casos[(i + 1) % casos.length];
---

{casos.length > 1 && (
  <nav class="siguiente" aria-label="Siguiente proyecto">
    <CtaLink href={`/proyectos/${siguiente.id}/`} size="large">Ver {siguiente.data.nombreCorto ?? siguiente.data.titulo}</CtaLink>
  </nav>
)}

<style>
  .siguiente {
    padding: var(--ritmo-seccion) var(--gutter-page) 0;
  }
</style>
