---
/* ---------------------------------------------------------------------------
   Tarjeta del listado de Proyectos · Figma «Tarjeta · Proyecto» (3343:535),
   11/10/2026.

   Como las del Blog: la tarjeta entera es un enlace y su nombre accesible es
   el nombre del proyecto (AGENTS.md §3). La superficie lleva el color de
   cada proyecto —su paleta, la misma que en la Home— y encima una captura
   real de su web, entera (`contain`), sin recortes. La captura va `alt=""`:
   el caso la describe; aquí repetirla sería ruido antes del nombre.

   PRODUCTOS (14/10/2026): la misma tarjeta para Itza, Accessible Abstracts y
   A11y Primero. Si el enlace sale de la web, hace lo que CtaLink: la flecha ↗
   detrás del nombre, otra pestaña, y el aviso escrito para quien no la ve
   abrirse (3.2.5). Un enlace interno no lleva flecha, como hasta ahora.
   SOLO EL TÍTULO (Johnny, 30/10/2026): el listado de Proyectos enseña el
   nombre y nada más. `linea` queda opcional por si otra página la quiere.
   --------------------------------------------------------------------------- */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  nombre: string;
  linea?: string;
  captura: ImageMetadata;
  color: string;
  /** La ® de los productos: se ve, pero no se oye (src/i18n/marca.ts). */
  marca?: boolean;
}
const { href, nombre, linea, captura, color, marca = false } = Astro.props;
const externo = /^https?:\/\//.test(href);
---

<a class="tarjeta" href={href} {...externo ? { rel: 'noopener', target: '_blank' } : {}}>
  <span class="tarjeta__superficie" style={`--color: ${color}`}>
    {/* Un SVG (A11y Primero) va tal cual: es vectorial y pesa menos que
        cualquier rasterizado. El resto, en avif/webp a dos anchos. */}
    {captura.format === 'svg' ? (
      <img src={captura.src} width={captura.width} height={captura.height} alt="" loading="lazy" decoding="async" />
    ) : (
      <Picture src={captura} alt="" formats={['avif', 'webp']} widths={[400, 800]} sizes="(min-width: 1024px) 27vw, (min-width: 768px) 41vw, 86vw" loading="lazy" />
    )}
  </span>
  <h2 class="tarjeta__nombre">
    {nombre}{marca && <sup aria-hidden="true">®</sup>}
    {externo && (
      <svg class="tarjeta__flecha" aria-hidden="true" focusable="false" viewBox="0 0 14 14" width="14" height="14"><path d="M1.5 12.5 12 2M4.5 2H12v7.5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
    )}
  </h2>
  {linea && <p class="tarjeta__linea">{linea}</p>}
  {externo && <span class="sr-only"> (se abre en una ventana nueva)</span>}
</a>

<style>
  .tarjeta { display: flex; flex-direction: column; text-decoration: none; color: var(--text); }
  /* 4:3 con 32 de aire alrededor de la captura, como en el Figma. */
  .tarjeta__superficie {
    /* `min-height: 0` y la rejilla de 1fr: sin ellos la captura (alta, en el
       caso de un móvil) estira la caja y el 4:3 deja de serlo. */
    display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); aspect-ratio: 4 / 3; min-height: 0; overflow: hidden;
    padding: var(--space-32);
    border-radius: var(--radio); background: var(--color); margin-block-end: var(--space-16);
  }
  .tarjeta__superficie :global(picture) { display: block; width: 100%; height: 100%; min-height: 0; }
  .tarjeta__superficie :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .tarjeta__nombre, .tarjeta__linea { margin: 0; font-size: var(--texto-size); line-height: var(--texto-leading); font-weight: 400; }
  .tarjeta__nombre sup { font-size: 0.4em; vertical-align: super; line-height: 0; }
  .tarjeta__flecha {
    display: inline-block; margin-inline-start: var(--space-8);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .tarjeta:is(:hover, :focus-visible) .tarjeta__flecha { transform: translate(3px, -3px); }
  /* Al pasar o enfocar, la captura se eleva 6 px dentro de su color, despacio
     y sin rebote: la tarjeta responde sin saltar (14/10/2026). Con reducir
     movimiento no se mueve; queda el subrayado del nombre. */
  @media (prefers-reduced-motion: no-preference) {
    .tarjeta__superficie :global(img) { transition: transform var(--dur-fade) var(--ease-out); }
    .tarjeta:is(:hover, :focus-visible) .tarjeta__superficie :global(img) { transform: translateY(-6px); }
  }
  .tarjeta:hover .tarjeta__nombre {
    text-decoration: underline; text-decoration-thickness: var(--underline-rest); text-underline-offset: var(--underline-offset);
  }
</style>
