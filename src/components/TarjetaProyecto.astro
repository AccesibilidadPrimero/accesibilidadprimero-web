---
/* ---------------------------------------------------------------------------
   Tarjeta del listado de Proyectos · Figma «Tarjeta · Proyecto» (3343:535),
   11/10/2026.

   Como las del Blog: la tarjeta entera es un enlace y su nombre accesible es
   el nombre del proyecto (AGENTS.md §3). La superficie lleva el color de
   cada proyecto —su paleta, la misma que en la Home— y encima una captura
   real de su web, entera (`contain`), sin recortes. La captura va `alt=""`:
   el caso la describe; aquí repetirla sería ruido antes del nombre.
   --------------------------------------------------------------------------- */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  nombre: string;
  linea: string;
  captura: ImageMetadata;
  color: string;
}
const { href, nombre, linea, captura, color } = Astro.props;
---

<a class="tarjeta" href={href}>
  <span class="tarjeta__superficie" style={`--color: ${color}`}>
    <Picture src={captura} alt="" formats={['avif', 'webp']} widths={[400, 800]} sizes="(min-width: 1024px) 27vw, (min-width: 768px) 41vw, 86vw" loading="lazy" />
  </span>
  <h2 class="tarjeta__nombre">{nombre}</h2>
  <p class="tarjeta__linea">{linea}</p>
</a>

<style>
  .tarjeta { display: flex; flex-direction: column; text-decoration: none; color: var(--text); }
  /* 4:3 con 32 de aire alrededor de la captura, como en el Figma. */
  .tarjeta__superficie {
    /* `min-height: 0` y la rejilla de 1fr: sin ellos la captura (alta, en el
       caso de un móvil) estira la caja y el 4:3 deja de serlo. */
    display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); aspect-ratio: 4 / 3; min-height: 0; overflow: hidden;
    padding: var(--space-32);
    border-radius: var(--radio); background: var(--color); margin-block-end: var(--space-16);
  }
  .tarjeta__superficie :global(picture) { display: block; width: 100%; height: 100%; min-height: 0; }
  .tarjeta__superficie :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .tarjeta__nombre, .tarjeta__linea { margin: 0; font-size: var(--texto-size); line-height: var(--texto-leading); font-weight: 400; }
  .tarjeta:hover .tarjeta__nombre {
    text-decoration: underline; text-decoration-thickness: var(--underline-rest); text-underline-offset: var(--underline-offset);
  }
</style>
