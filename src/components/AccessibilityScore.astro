---
/* ---------------------------------------------------------------------------
   Barra de nota del proyecto · «Accessibility Meta Content» del Figma.

   La nota con su punto de estado y el nombre de la herramienta que la mide,
   A11y Primero. Hasta el 03/11/2026 llevaba al lado un segundo bloque con la
   conformidad WCAG y su icono (Figma: 131 y 169 de ancho).

   Tres cosas que el diseño original hacía mal y aquí no se repiten:

   1. El punto era #22c55e sobre Silk: 2,12:1, por debajo del 3:1 de 1.4.11.
      Aquí usa el token de señal (#157a3d, 5,04:1).
   2. El estado iba solo en el color, que es 1.4.1. Aquí el número está
      escrito y el punto solo acompaña, así que no carga información él solo.
   3. El icono de accesibilidad es decorativo y va aria-hidden: lo que dice
      está escrito al lado.

   La nota enlaza a la declaración cuando la hay. Cuando no, se pinta igual
   pero sin enlace: un enlace que lleva a un 404 es peor que no tenerlo.
   --------------------------------------------------------------------------- */
import { idiomaDe } from '../i18n/idioma';
import { t } from '../i18n/ui';
interface Props {
  nota?: { valor: number; medidaEl: Date; declaracion?: string; conformidad?: string };
  proyecto: string;
}
const { nota, proyecto } = Astro.props;
const lang = idiomaDe(Astro.url);
const ui = t(lang);
const fecha = nota
  ? new Intl.DateTimeFormat(ui.locale, { day: 'numeric', month: 'long', year: 'numeric' }).format(nota.medidaEl)
  : '';
const DESCRIBE = {
  es: (p: string, f: string) => `, la puntuación automática de nuestra extensión, para ${p}. Medida el ${f}`,
  ca: (p: string, f: string) => `, la puntuació automàtica de la nostra extensió, per a ${p}. Mesurada el ${f}`,
  en: (p: string, f: string) => `, the automated score from our extension, for ${p}. Measured on ${f}`,
};
const DECLARACION = {
  es: '. Ver la declaración de accesibilidad (se abre en una ventana nueva)',
  ca: '. Veure la declaració d’accessibilitat (s’obre en una finestra nova)',
  en: '. See the accessibility statement (opens in a new window)',
};
---

{
  nota && (
    <div class="meta">
      <p class="meta__nota">
        {nota.declaracion ? (
          /* En pestaña nueva (Johnny, 03/11/2026): la declaración está en la
             web del cliente. Se avisa en el nombre accesible, como en los
             demás enlaces externos de la web (CtaLink, TarjetaProyecto). */
          <a href={nota.declaracion} class="meta__enlace" target="_blank" rel="noopener">
            <span>{nota.valor} / 100 · A11y Primero</span>
            <span class="sr-only">
              {DESCRIBE[lang](proyecto, fecha) + DECLARACION[lang]}
            </span>
          </a>
        ) : (
          <span>
            <span>{nota.valor} / 100 · A11y Primero</span>
            <span class="sr-only">{DESCRIBE[lang](proyecto, fecha)}</span>
          </span>
        )}
        <span class="meta__punto" aria-hidden="true" />
      </p>

      {/* Sin el sello «WCAG 2.2 AA» (Johnny, 03/11/2026): las declaraciones
          dicen conformidad parcial y una puntuación de herramienta propia no
          es una declaración de conformidad. La herramienta se nombra a la
          vista. El desplegable con el detalle está pendiente de diseño en
          Figma (AGENTS.md §1). */}
    </div>
  )
}

<style>
  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-24);
    font-size: var(--texto-size);
    line-height: var(--texto-leading);
    flex: none;
  }

  .meta__nota { display: flex; align-items: center; gap: var(--space-8); }

  /* En negro, como «WCAG 2.2 AA» a su lado, y SIN flecha (Johnny, 09/10,
     tarde): la nota es un dato, y una ↗ más un punto verde eran tres signos
     seguidos. Sigue siendo un enlace a la declaración, pero no se anuncia en
     reposo. Al pasar el ratón o con el foco aparece el subrayado fino, como en
     la navegación: quien explora lo descubre. Para el lector de pantalla es un
     enlace con nombre completo, así que no pierde nada. */
  .meta__nota, .meta__nota a { color: var(--text); }

  /* La nota es un enlace a la declaración, así que es un objetivo táctil como
     cualquier otro: 44 px de alto, la regla de AP. El bloque entero se alinea
     por su centro, así que crecer no descoloca nada. */
  .meta__nota a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--touch-min);
    text-decoration: none;
  }
  .meta__enlace:is(:hover, :focus-visible) {
    text-decoration: underline;
    text-decoration-thickness: var(--underline-rest);
  }

  .meta__punto {
    width: 10px; height: 10px;
    border-radius: 50%;
    /* `Green / Signal` del Figma (Johnny: «su punto verde claro»). Es
       decorativo y va aria-hidden: el estado lo dice el número escrito, así
       que el punto no tiene que cumplir el 3:1 de 1.4.11 por sí solo. */
    background: var(--green-signal);
    flex: none;
  }

  @media (forced-colors: active) {
    .meta__punto { background: CanvasText; }
  }
</style>
