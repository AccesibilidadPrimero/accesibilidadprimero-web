---
import CtaLink from './CtaLink.astro';
/* ---------------------------------------------------------------------------
   «Sobre la mesa» · lo que el estudio tiene entre manos ahora mismo.

   El contenido NO se pide aquí: lo congela `npm run mesa` en
   `src/data/mesa.json`. Así el build es determinista y no se cae porque
   Mastodon esté caído, y —lo que más importa— la sección acaba en `dist/`,
   que es lo que miden geometria, a11y, teclado, tipografia y contraste. Una
   sección inyectada en vivo sería la única de la página que nadie comprueba.

   SI NO HAY NADA RECIENTE, ESTE COMPONENTE NO DEVUELVE NADA. Ni hueco, ni
   «no hay novedades», ni rastro: la Home vuelve a ser la de siempre, porque
   el ritmo de 128 lo declara el contenedor una vez y las secciones se
   recolocan solas. Así «ahora» es verdad por construcción y no puede caducar.
   --------------------------------------------------------------------------- */
import type { ImageMetadata } from 'astro';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/config';
import datos from '../data/mesa.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ui = t(lang);

/* Las baja `npm run mesa`. El glob tiene que ser literal para Vite. */
const archivos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/mesa/*.{png,jpg,jpeg,webp,avif}', { eager: true },
);
const medio = (n: string) => Object.entries(archivos).find(([r]) => r.endsWith(`/${n}`))?.[1]?.default;

/* La fecha de cada publicación, visible (auditoría de usabilidad, 04/11/2026):
   sin ella, una convocatoria ya pasada se leía como algo de ahora. */
const fecha = (iso: string) => new Intl.DateTimeFormat(ui.locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Madrid' }).format(new Date(iso));

/* Las TRES últimas, en una rejilla quieta (Johnny, 05/11/2026): con cuatro, la
   tira se desplazaba y aparecía la barra del navegador. Lo demás, en Mastodon. */
const notas = datos.visible ? datos.notas.filter((n) => medio(n.imagen.archivo)).slice(0, 3) : [];
const MASTODON = 'https://mastodon.social/@accesibilidadprimero';
---

{notas.length > 0 && (
  <section class="mesa" aria-labelledby="mesa-titulo">
    <div class="mesa__intro">
      <h2 id="mesa-titulo" class="mesa__titulo">{ui.mesaTitulo}</h2>
    </div>

    {/* Sin desplazamiento desde el 05/11/2026: ya no hace falta `tabindex` en
        la lista. */}
    <ul class="mesa__lista" aria-label={ui.mesaRegion}>
      {notas.map((n) => {
        const img = medio(n.imagen.archivo)!;
        return (
          <li class="mesa__nota">
            {/* La tarjeta ENTERA es un enlace, y su nombre accesible es el
                titular: distinto en cada una, así que no hay cuatro enlaces
                llamados igual (2.4.4). La imagen va `alt=""` porque su
                descripción se anuncia aparte, debajo: si la llevara el enlace
                se oiría el titular y la alternativa pegados en una sola
                parrafada. */}
            {/* La alternativa de la imagen va ANTES del enlace y fuera de él: antes,
                porque visualmente la imagen es lo primero de la tarjeta y así el
                orden de lectura coincide con el de la vista; y fuera, porque
                dentro haría que el nombre accesible del enlace fuesen 400
                caracteres de descripción más el titular, en una sola parrafada. */}
            <p class="sr-only" data-alt lang={n.idioma === lang ? undefined : n.idioma}>{n.imagen.alt}</p>
            <a class="mesa__enlace" href={n.url} rel="noopener" target="_blank">
              <img src={img.src} alt="" width={img.width} height={img.height} loading="lazy" decoding="async" />
              {/* `lang` solo cuando el post está en otro idioma que la página:
                  marcarlo siempre sería ruido (3.1.2). */}
              <time class="mesa__fecha" datetime={n.fecha}>{fecha(n.fecha)}</time>
              <p class="mesa__texto" lang={n.idioma === lang ? undefined : n.idioma}>{n.titular}</p>
              {/* Lo que la vista no dice: que la tarjeta lleva a Mastodon. Desde
                  el 10/10 ya no hay enlace «Ir a Mastodon» debajo de la tira
                  (Johnny: la sección es para quedarse en la web, no para salir
                  de ella), así que esta es la única pista del destino. */}
              <span class="sr-only"> · {ui.mesaCta}</span>
            </a>
          </li>
        );
      })}
    </ul>
    <div class="mesa__mas"><CtaLink href={MASTODON}>{ui.mesaMas}</CtaLink></div>
  </section>
)}

<style>
  .mesa { padding-inline: var(--gutter-page); display: flex; flex-direction: column; }
  .mesa__intro { display: flex; flex-direction: column; gap: var(--space-8); padding-block: 0 var(--ritmo-intro); }
  /* El rótulo NO crece: va a cuerpo de texto, como el título de un proyecto.
     Lo que destaca es el contenido, y aquí eso lo hacen las imágenes. */
  .mesa__titulo { font-size: var(--texto-size); line-height: var(--texto-leading); }

  /* Una rejilla quieta (05/11/2026): una columna en móvil y tres desde
     tableta, como los productos de encima. */
  .mesa__lista { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-48) var(--space-24); align-items: start; min-width: 0; margin: 0; padding: 0; list-style: none; }
  @media (min-width: 768px) { .mesa__lista { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .mesa__mas { padding-block-start: var(--space-48); }
  /* `position: relative`: el `.sr-only` de la alternativa se coloca respecto a
     la tarjeta y no a la página. */
  .mesa__nota { position: relative; }
  .mesa__enlace { display: flex; flex-direction: column; gap: var(--space-16); text-decoration: none; }
  /* 16:9 porque es lo que se sube: el material real llega a 1920 × 1080. */
  .mesa__enlace img {
    width: 100%; aspect-ratio: 16 / 9; object-fit: cover;
    border-radius: var(--radio); background: var(--silk);
  }
  /* En negro, como todo. Sin fecha a la vista (Johnny, 10/10): la tarjeta es
     imagen y frase, nada más.

     OJO con lo que eso implica: el argumento para subir la puerta de 30 a 60
     días fue que la fecha de cada tarjeta dejaba juzgar al lector. Sin fecha,
     la puerta es lo ÚNICO que impide que algo viejo parezca de hoy. Y la
     fecha tampoco se esconde con `sr-only`: dársela a quien escucha y no a
     quien mira son dos contenidos distintos para dos personas. */
  .mesa__fecha { font-size: var(--texto-size); line-height: var(--texto-leading); color: var(--text); margin-block-end: calc(var(--space-8) - var(--space-16)); }
  .mesa__texto { font-size: var(--texto-size); line-height: var(--texto-leading); color: var(--text); }
  .mesa__enlace:hover .mesa__texto { text-decoration: underline; text-decoration-thickness: var(--underline-rest); text-underline-offset: var(--underline-offset); }

  /* El ritmo, en todos los anchos (10/10). */
  .mesa { margin-block-start: var(--ritmo-seccion); }
</style>
