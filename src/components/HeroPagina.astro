---
/* ---------------------------------------------------------------------------
   Hero de página interior · todas las páginas menos la Home (Figma
   `Hero · Apertura · pantalla entera`, 13/10/2026).

   TODOS LOS HEROS, LOS MISMOS MÁRGENES (Johnny, 13/10/2026): la banda ocupa
   la pantalla entera, como el hero de la Home, y el titular y su texto van
   abajo, con 24 hasta el borde. La cabecera queda DENTRO del color. Si hay
   ilustración, se centra en lo que sobra; si no, ese espacio queda en color.
   Entre la ilustración y el titular, 64 como mínimo; entre titular y texto, 32.

   El titular es el único texto de la página en `--display`. El texto de
   apertura llega en líneas: cada una va en un <span> en bloque, no con
   <br>, para que el lector de pantalla lo lea como una frase seguida.

   `golpes` (Estudio, 13/10/2026): el titular entra por partes, cada una
   subiendo desde su línea, y después el texto. El <h1> está entero en el
   HTML desde el principio: lo que se anima es el dibujo de las palabras, y
   el lector de pantalla lo lee de una vez. Sin JS no se anima nada (la clase
   `js` la pone Base.astro antes de pintar); con «reducir movimiento», fundido
   sin desplazamiento. Todo acaba antes de 2 s.

   `foto` (casos de proyecto, 23/10/2026): la banda lleva la foto del
   proyecto debajo, con el velo del Figma `Archivo · Caso Foc i Cor` (Ink al
   55 % y, arriba, Ink al 40 % que se apaga al 26 % para la cabecera). El
   texto, en el mismo sitio que en el resto de heros, pasa a Silk: sobre la
   foto el negro no se leería. Es la única excepción de color de la web, y
   la cabecera la acompaña mientras está encima de la foto.
   --------------------------------------------------------------------------- */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  ilustracion?: ImageMetadata;
  /** Lo que la ilustración aporta, no lo que es («ilustración de…» no). */
  alt?: string;
  titulo: string;
  /** Una o más líneas del texto de apertura. */
  texto: string[];
  /** Una línea más, aparte: la fecha de actualización de las legales. */
  nota?: string;
  /** Enlace de vuelta encima del titular (los artículos del Blog). */
  volver?: { href: string; texto: string };
  /** El color de la banda en vez del menta: la de cada caso es la de su
      proyecto (paleta en src/content/proyectos/). El build ya ha comprobado
      que `foco` y el texto rinden encima. */
  superficie?: { fondo: string; foco: string };
  /** El titular, partido en los golpes con los que entra. Unidos con un
      espacio tienen que dar exactamente `titulo` (el build lo comprueba). */
  golpes?: string[];
  /** Foto de ambiente debajo del texto (casos). Va con alt="": el titular
      está encima y la foto no añade información. */
  foto?: ImageMetadata;
  /** Cada golpe en su línea, en todos los anchos (Estudio, 30/10/2026). */
  enLineas?: boolean;
  /** Cada línea del texto en su propio párrafo, con aire entre ellos
      (Estudio, 30/10/2026). Sin esto, las líneas forman una sola frase. */
  enParrafos?: boolean;
}
const { ilustracion, alt = '', titulo, texto, nota, volver, superficie, golpes, foto, enLineas = false, enParrafos = false } = Astro.props;
/* Los anchos que se generan, sin pasar del original: ampliar no añade detalle. */
const anchosFoto = foto ? [640, 1024, 1440, 2048, 2880].filter((w) => w < foto.width).concat(foto.width) : [];
if (golpes && golpes.join(' ') !== titulo) {
  throw new Error(`HeroPagina: los golpes “${golpes.join(' ')}” no son el titular “${titulo}”.`);
}
/* En vez de una imagen, un dibujo en línea (el símbolo animado de Estudio,
   13/10/2026). Lleva la clase `apertura__ilustracion` y mide lo mismo. */
const conDibujo = Astro.slots.has('ilustracion');
const estilo = superficie ? `--surface-accent: ${superficie.fondo}; --focus-ring: ${superficie.foco};` : undefined;
---

<div class:list={['apertura', golpes && 'apertura--golpes', foto && 'apertura--foto']} style={estilo}>
  {
    foto && (
      <Picture
        src={foto}
        alt=""
        formats={['avif', 'webp']}
        widths={anchosFoto}
        sizes="100vw"
        quality="high"
        class="apertura__foto"
        loading="eager"
        fetchpriority="high"
      />
    )
  }
  {/* Lo que sobra de la pantalla. Con ilustración, la centra; sin ella, es
      el espacio en color que empuja el texto abajo. */}
  <div class="apertura__escena">
    <slot name="ilustracion" />
    {
      ilustracion && (
        <img
          class="apertura__ilustracion"
          src={ilustracion.src}
          width={ilustracion.width}
          height={ilustracion.height}
          alt={alt}
        />
      )
    }
  </div>
  <div class="apertura__texto-grupo">
    {
      /* Antes del titular en el Figma (Blog · Artículo, 11/10/2026). Va en su
         propia línea y mide 44 de alto, como cualquier enlace de la web. */
      volver && (
        <a class="apertura__volver" href={volver.href}>
          <span aria-hidden="true">← </span>{volver.texto}
        </a>
      )
    }
    {
      golpes ? (
        <h1 class:list={['apertura__titulo', enLineas && 'apertura__titulo--lineas']}>
          {golpes.map((g, i) => <>{i > 0 && ' '}<span class="golpe"><span class="golpe__dentro" style={`--i:${i}`} data-mov-propio>{g}</span></span></>)}
        </h1>
      ) : (
        <h1 class="apertura__titulo">{titulo}</h1>
      )
    }
    {/* data-mov-propio: con «reducir movimiento» trae su propio fundido de
        300 ms, y base.css no debe dejarlo en 0,01 ms (modo de fallo n.º 3). */}
    {
      enParrafos ? (
        <div class="apertura__texto apertura__parrafos" data-mov-propio={golpes ? '' : undefined}>
          {texto.map((l) => <p>{l}</p>)}
        </div>
      ) : (
        <p class="apertura__texto" data-mov-propio={golpes ? '' : undefined}>
          {texto.map((l, i) => <>{i > 0 && ' '}<span class="linea">{l}</span></>)}
        </p>
      )
    }
    {nota && <p class="apertura__texto">{nota}</p>}
  </div>
</div>

<style>
  /* Pantalla entera, como la Home (HeroCarousel): 100svh, y 100lvh donde se
     sepa, para que en el iPhone el color llegue al borde bajo la barra del
     navegador. Se sube por debajo de la cabecera (transparente) y le devuelve
     el hueco como relleno. Abajo, 24 hasta el texto; en el iPhone se le suma
     lo que mide la barra, para que no lo tape al cargar. */
  .apertura {
    position: relative;   /* para lo que se centra en la banda entera (el símbolo de Estudio) */
    display: flex;
    flex-direction: column;
    gap: var(--ritmo-intro);
    min-height: 100svh;
    margin-block-start: calc(var(--header-height) * -1);
    padding: var(--header-height) var(--gutter-page) var(--space-24);
    background: var(--surface-accent);
    /* Menta se comporta como papel claro: Blue AP rinde 4,65:1 encima. */
    --focus-ring: var(--blue-ap);
  }
  @supports (height: 100lvh) {
    .apertura {
      min-height: 100lvh;
      padding-block-end: calc(var(--space-24) + 100lvh - 100svh);
    }
  }
  .apertura__escena { flex: 1 0 auto; display: grid; place-items: center; }

  /* ---- Con foto ---- */
  .apertura--foto {
    isolation: isolate;
    background: var(--ink);
    color: var(--silk);
    --text: var(--silk);
    --link: var(--silk);
    --focus-ring: var(--silk);
  }
  .apertura--foto .apertura__titulo { color: inherit; }
  .apertura :global(.apertura__foto) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }
  .apertura--foto::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    /* El velo del Figma más uno abajo, donde va el texto: con el del Figma
       solo, «Caso de estudio» se quedaba en 3,86:1 sobre el blanco del plato
       (23/10/2026). Hacía falta un 13 % más de Ink detrás del texto; este da
       un 20 % a la altura del texto pequeño. */
    background:
      linear-gradient(to bottom, rgb(23 23 23 / 0.4), rgb(23 23 23 / 0) 26%),
      linear-gradient(to top, rgb(23 23 23 / 0.4), rgb(23 23 23 / 0) 60%),
      rgb(23 23 23 / 0.55);
  }
  /* La cabecera, encima de la foto: en Silk. Solo lo que se ve sobre la foto;
     el panel del menú móvil es blanco y conserva sus colores (es hermano del
     botón, las variables no le llegan). */
  :global(body:has(.apertura--foto) :is(.header__logo, .header__nav, .header__lang, .menu__trigger)) {
    --link: var(--silk);
    --text: var(--silk);
    --focus-ring: var(--silk);
  }

  .apertura__texto-grupo { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-32); }
  .apertura__texto-grupo > :not(a) { align-self: stretch; }
  .apertura__volver {
    display: inline-flex; align-items: center; min-height: var(--touch-min);
    margin-block: calc((var(--touch-min) - var(--texto-leading)) / -2);
  }

  /* 240 · 320 · 400 de alto (Figma Móvil, Tableta, Escritorio); el ancho sale
     de su proporción. Nunca más ancho que la columna. */
  .apertura :global(.apertura__ilustracion) {
    block-size: 240px;
    inline-size: auto;
    max-inline-size: 100%;
    object-fit: contain;
  }
  @media (min-width: 768px) { .apertura :global(.apertura__ilustracion) { block-size: 320px; } }
  @media (min-width: 1024px) { .apertura :global(.apertura__ilustracion) { block-size: 400px; } }

  .apertura__titulo {
    margin: 0;
    font-size: var(--display-size);
    line-height: var(--display-leading);
    letter-spacing: var(--display-track);
    font-weight: 400;
  }
  /* 930 en el Figma de escritorio. Como tope: por debajo ocupa lo que haya. */
  .apertura__texto { margin: 0; max-width: 930px; }
  .apertura__texto .linea { display: block; }
  /* Párrafos separados: 16 entre ellos, el hueco mínimo que se distingue del
     interlineado (AGENTS.md §4, «Título y texto al mismo cuerpo»). */
  .apertura__parrafos { display: flex; flex-direction: column; gap: var(--space-16); }
  .apertura__parrafos p { margin: 0; max-width: none; }
  /* Un golpe por línea: el espacio entre ellos sigue en el HTML, así que el
     lector de pantalla lee el titular de corrido. */
  .apertura__titulo--lineas .golpe { display: block; inline-size: fit-content; }

  /* ---- Entrada en golpes (Estudio) ----
     Cada golpe es una ventana del alto de su línea, con un poco de aire
     arriba y abajo para que no se coman la tilde de la ñ ni el rabo de la g
     (el margen negativo lo devuelve: la línea no cambia de alto). Dentro, la
     palabra sube desde debajo, como los renglones de la Home pero más
     marcada: 250 ms entre golpes en vez de 90. */
  .golpe {
    display: inline-block;
    overflow: hidden;
    padding-block: 0.12em 0.2em;
    margin-block: -0.12em -0.2em;
    vertical-align: bottom;
  }
  .golpe__dentro { display: inline-block; }
  :global(html.js) .apertura--golpes .golpe__dentro {
    animation: apertura-golpe var(--dur-renglon) var(--ease-asentar) both;
    animation-delay: calc(var(--i, 0) * 250ms);
  }
  /* El texto de debajo, cuando el titular ya está casi asentado. */
  :global(html.js) .apertura--golpes .apertura__texto {
    animation: apertura-funde var(--dur-fade) ease-out 1000ms both;
  }
  /* 150 % y no 110 %: la ventana baja 0,2 em por debajo de la línea para el
     rabo de la g, y con 110 % asomaban los puntos de la palabra que espera. */
  @keyframes apertura-golpe { from { transform: translateY(150%); } }
  @keyframes apertura-funde { from { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .apertura--golpes .golpe__dentro {
      animation: apertura-funde var(--dur-fundido-reducido) ease-out both;
      animation-delay: calc(var(--i, 0) * 250ms);
    }
    :global(html.js) .apertura--golpes .apertura__texto {
      animation: apertura-funde var(--dur-fundido-reducido) ease-out 750ms both;
    }
  }
</style>
