---
/* ---------------------------------------------------------------------------
   Listado del Blog · Figma `Producción · Blog` (3334:199): Desktop 3334:201 ·
   Tablet 3334:445 · Móvil 3334:673. Lo usan /blog/ y cada categoría.

   Los filtros son ENLACES, no botones: cada categoría es una página propia,
   /blog/categoria/<nombre>/. Funciona sin JavaScript, se puede compartir y
   guardar, y recoge las /category/ de WordPress (public/_redirects). La
   página actual lleva aria-current y subrayado, como el menú.
   --------------------------------------------------------------------------- */
import Base from '../layouts/Base.astro';
import HeroPagina from './HeroPagina.astro';
import TarjetaArticulo from './TarjetaArticulo.astro';
/* La ilustración del hero (Johnny, 30/10/2026). La compila `npm run arte`
   desde arte/blog/hero.svg. */
import ilustracionBlog from '../assets/blog/hero.svg';
import { getCollection, type CollectionEntry } from 'astro:content';
import { LANGS, path, type Lang } from '../i18n/config';
import { CATEGORIAS, NOMBRE_CATEGORIA, SEG_CATEGORIA, UI_BLOG, articulosDe, hrefArticulo, hrefCategoria, type Categoria } from '../data/blog';
import '../styles/listados.css';

interface Props {
  lang: Lang;
  articulos: CollectionEntry<'blog'>[];
  /** La categoría de esta página; sin ella, «Todos». */
  categoria?: Categoria;
}
const { lang, articulos, categoria } = Astro.props;
const ui = UI_BLOG[lang];

/* Solo se ofrecen las categorías que tienen artículos en este idioma, y el
   selector de idioma de una categoría solo lleva a los idiomas donde existe. */
const todos = await getCollection('blog');
const conArticulos = (l: Lang) => new Set(articulosDe(todos, l).flatMap((a) => a.data.categorias));
const aqui = conArticulos(lang);
const filtros = [
  { href: path('blog', lang), texto: ui.todos, actual: !categoria },
  ...(Object.keys(CATEGORIAS) as Categoria[]).filter((c) => aqui.has(c)).map((clave) => ({
    href: hrefCategoria(clave, lang), texto: NOMBRE_CATEGORIA[lang][clave], actual: clave === categoria,
  })),
];
const slug = categoria
  ? Object.fromEntries(LANGS.filter((l) => conArticulos(l).has(categoria)).map((l) => [l, `${SEG_CATEGORIA[l]}/${categoria}`]))
  : undefined;
const nombre = categoria ? NOMBRE_CATEGORIA[lang][categoria] : null;
---

<Base
  lang={lang}
  current="blog"
  slug={slug}
  title={nombre ? `Blog · ${nombre} · Accesibilidad Primero` : 'Blog · Accesibilidad Primero'}
  description={ui.description}
>
  <HeroPagina
    ilustracion={ilustracionBlog}
    alt={ui.altHero}
    ilustracionComoHome
    titulo={nombre ? `Blog · ${nombre}` : ui.titulo}
    texto={[ui.entrada]}
  />

  <div class="listado">
    {/* Segundo <nav> de la página: lleva su propio nombre, distinto del menú
        principal (AGENTS.md §3). */}
    <nav class="filtros" aria-label={ui.categorias}>
      <ul class="filtros__lista">
        {filtros.map((f) => (
          <li><a class="filtros__enlace" href={f.href} aria-current={f.actual ? 'page' : undefined}>{f.texto}</a></li>
        ))}
      </ul>
    </nav>

    {/* `tarjetas`: entrada y cambio de categoría (src/styles/listados.css). */}
    <ul class="rejilla tarjetas">
      {articulos.map((a, n) => (
        <li data-mov-propio style={`--i: ${Math.min(n, 5)}; view-transition-name: t-${a.id.replace('/', '-')}`}>
          <TarjetaArticulo href={hrefArticulo(a)} titulo={a.data.titulo} fecha={a.data.fecha} imagen={a.data.imagen} />
        </li>
      ))}
    </ul>
  </div>
</Base>

<script>
  import '../scripts/tarjetas';
</script>

<style>
  .listado {
    display: flex; flex-direction: column; gap: var(--ritmo-intro);
    padding: var(--ritmo-seccion) var(--gutter-page) 0;
  }
  ul { margin: 0; padding: 0; list-style: none; }

  /* Como el menú: 12 de relleno a cada lado (24 entre palabras) y la lista a
     -12 para que el texto de «Todos» empiece en el margen. Si se parte en dos
     líneas, la segunda también empieza en el margen. */
  .filtros__lista { display: flex; flex-wrap: wrap; margin-inline-start: calc(var(--space-12) * -1); }
  .filtros__enlace {
    display: inline-flex; align-items: center; min-height: var(--touch-min);
    padding: 0 var(--space-12); text-decoration: none;
  }
  .filtros__enlace:hover,
  .filtros__enlace[aria-current] {
    text-decoration: underline; text-decoration-thickness: var(--underline-rest); text-underline-offset: var(--underline-offset);
  }

  .rejilla { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-64) var(--space-24); }
  @media (min-width: 768px) { .rejilla { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .rejilla { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
