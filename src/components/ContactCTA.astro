---
/* Bloque de cierre, igual en todas las páginas. Por eso su título lleva el
   mismo nivel en todas: h2. */
import { t } from '../i18n/ui';
import { path, type Lang } from '../i18n/config';
import CtaLink from './CtaLink.astro';
/* `titulo`: cada caso puede cerrar con su propia frase (Figma de Foc i Cor).
   Sin él, la de siempre. */
const { lang, titulo } = Astro.props as { lang: Lang; titulo?: string };
const ui = t(lang);
/* El titular va en dos líneas fijas, cortado después de la primera frase
   (Figma: la caja mide dos renglones a 962 de ancho, y sin corte cabría en
   uno). Cada línea es un <span> en bloque y no un <br>: para el lector de
   pantalla sigue siendo una sola frase seguida, y el espacio entre las dos
   se conserva si algún día la línea deja de ir en bloque. */
const lineas = (titulo ?? ui.ctaHeading).split('\n');
---

<section class="contacto" aria-labelledby="cta-contacto">
  <h2 id="cta-contacto" class="contacto__titulo">
    {lineas.map((l, i) => <>{i > 0 && ' '}<span class="linea">{l}</span></>)}
  </h2>
  <CtaLink href={path('contacto', lang)} size="large">{ui.ctaAction}</CtaLink>
</section>

<style>
  .contacto {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
    /* Sin fondo visible (`--surface-raised` es blanco): se ciñe a su tinta y
       el aire lo pone el ritmo, en todos los anchos desde el 10/10. */
    padding: 0 var(--gutter-page);
    margin-block-start: var(--ritmo-seccion);
    background: var(--surface-raised);
  }
  /* En fila desde tableta, como en escritorio y como el Figma de Tablet
     (2201:560). Aquí el titular toma lo que le deja el enlace: la medida de
     962 es de escritorio. */
  @media (min-width: 768px) and (max-width: 1023px) {
    .contacto { flex-direction: row; align-items: center; justify-content: space-between; gap: var(--space-48); }
    .contacto__titulo { flex: 1 1 auto; }
  }
  .contacto__titulo .linea { display: block; }
  .contacto__titulo {
    font-size: var(--texto-size);
    line-height: var(--texto-leading);
    font-weight: 400;
    /* 962 px del Figma, no una medida en ch: el ancho de este párrafo es una
       decisión de diseño tomada, no una consecuencia del cuerpo de letra.
       Va aquí y no en home.css por la especificidad del scope de Astro —ver el
       comentario largo en HeroCarousel.astro. */
    max-width: 962px;
  }
  @media (min-width: 1024px) {
    .contacto {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-48);
    }
    /* El Figma da 962 px al titular dentro de una fila de contenido de 1344.
       Como proporción y no como píxel fijo: a 1440 sale exactamente 962, y por
       debajo encoge con el contenedor en vez de empujar al CTA fuera.
       Un max-width solo no bastaba: en una fila flex el titular se quedaba con
       lo que le dejaba el reparto (661 px), no con su medida. */
    .contacto__titulo {
      flex: 0 0 auto;
      width: calc(962 / 1344 * 100%);
      max-width: 962px;
    }
  }
</style>
