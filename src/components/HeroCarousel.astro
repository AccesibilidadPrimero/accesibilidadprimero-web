---
/* ---------------------------------------------------------------------------
   Hero · carrusel de ilustraciones

   Especificación: claude/hero-carrusel-home-figma.md (30/09/2026).
     · 8 ilustraciones. La 1 (girasol) es el estado base y el de
       prefers-reduced-motion.
     · 1,5 s por imagen, fundido de 0,6 s, en bucle.
     · Cursor o dedo encima: se para la rotación y aparece la frase de esa
       imagen. Al salir, vuelve a rotar.
     · La frase aparece palabra a palabra: sube 6 px y funde, 40 ms entre
       palabras, 500 ms por palabra, sin rebote.

   Decisiones de accesibilidad que conviene no deshacer:

   1. El h1 de la página es el mensaje base y NO lo sustituye la frase de la
      ilustración. La frase vive en una región aparte.
   2. Esa región solo anuncia cuando el carrusel está PARADO. Un aria-live
      que dispare cada 1,5 s convierte el lector de pantalla en una
      ametralladora y hace la página inutilizable. Mientras rota, la región
      está vacía a propósito.
   3. El hover revela la frase, pero el teclado tiene la misma puerta: el
      botón Pausar hace exactamente lo mismo, y enfocar dentro del escenario
      también para. Ninguna información depende del puntero.
   4. «Pausar» detiene el TEMPORIZADOR, no solo la animación. Mientras esté
      parado por el motivo que sea, la etiqueta es «Reproducir».
   5. Las ilustraciones son decorativas: alt="". La información la lleva el
      texto, no la imagen.
   --------------------------------------------------------------------------- */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/config';
import CtaLink from './CtaLink.astro';
import { path } from '../i18n/config';

interface Props { lang: Lang; titular: string }
const { lang, titular } = Astro.props;
const ui = t(lang);

/* El orden es el de `Documentación · Hero carrusel` (3095:901). */
const ilustraciones = [
  { id: 1, nombre: 'girasol',      frase: 'Estimen les diferències.', fraseLang: 'ca' },
  { id: 2, nombre: 'globos',       frase: 'La forma en la que comunicamos construye realidades.' },
  { id: 3, nombre: 'megáfono',     frase: 'Construimos narrativas que ayuden a romper estereotipos.' },
  { id: 4, nombre: 'construcción', frase: 'La comunicación debe representar, respetar y dar espacio a la diversidad.' },
  { id: 5, nombre: 'planta',       frase: 'Hacia el diseño universal y la tecnología semántica.' },
  { id: 6, nombre: 'diálogo',      frase: 'Proyectos con propósito.' },
  { id: 7, nombre: 'lápiz',        frase: 'Accesibilidad primero. Siempre.' },
  { id: 8, nombre: 'escalada',     frase: 'Amamos las diferencias.' },
];
const n = (i: number) => String(i).padStart(2, '0');

/* Los PNG viven en src/assets/, no en public/: así pasan por el pipeline de
   Astro y salen en AVIF y WebP con el PNG como respaldo. Un PNG de 185 KB
   pesa ~18 KB en AVIF. Lo que hay en public/ Astro no lo toca.
   El glob tiene que ser literal para que Vite lo resuelva en el build. */
const archivos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/hero/*.png',
  { eager: true },
);
const lamina = (id: number) => archivos[`../assets/hero/hero-${n(id)}.png`].default;
---

<section class="hero" aria-labelledby="hero-titular">
  <div class="hero__escenario" data-carrusel>
    <ul class="hero__pila">
      {
        ilustraciones.map((il, i) => (
          <li
            class="hero__lamina"
            data-indice={i}
            data-activa={i === 0 ? '' : undefined}
            data-frase={il.frase}
            data-frase-lang={il.fraseLang ?? lang}
          >
            {/* Decorativa: alt="". Lo que significa está escrito debajo. */}
            <Picture
              src={lamina(il.id)}
              formats={['avif', 'webp']}
              widths={[693, 1386]}
              sizes="(min-width: 768px) 693px, 100vw"
              alt=""
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </li>
        ))
      }
    </ul>

    <p class="hero__frase" data-carrusel-frase aria-live="polite" aria-atomic="true"></p>

    <button type="button" class="hero__control" data-carrusel-control
            data-label-pausar={ui.carouselPause} data-label-reproducir={ui.carouselPlay}>
      <span class="hero__icono" aria-hidden="true" data-carrusel-icono>&#9612;&#9612;</span>
      <span data-carrusel-control-label>{ui.carouselPause}</span>
    </button>
  </div>

  <div class="hero__banda">
    {/* El h1 va al pie del hero y en el mismo cuerpo que las frases del
        carrusel, por decisión de Johnny: no es un display gigante, es la
        frase que explica el estudio puesta al nivel de las demás. */}
    <h1 id="hero-titular" class="hero__titular">{titular}</h1>
    <CtaLink href={path('contacto', lang)} size="small">{ui.ctaAction}</CtaLink>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    /* La ilustración ocupa el centro y la banda se queda pegada abajo. */
    justify-content: space-between;
    gap: var(--space-32);
    min-height: 100svh;
    /* La cabecera va DENTRO del menta: no hay banda clara arriba. El hero se
       sube por debajo de ella y le devuelve el hueco como padding. svh y no
       vh porque en móvil la barra del navegador falsea vh. */
    margin-block-start: calc(var(--header-height) * -1);
    padding-block: calc(var(--header-height) + var(--space-24)) var(--space-32);
    padding-inline: var(--gutter-page);
    background: var(--surface-accent);
    /* Menta se comporta como papel claro: Blue AP rinde 4,65:1 encima. */
    --focus-ring: var(--blue-ap);
  }

  .hero__escenario {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-16);
  }

  .hero__pila {
    position: relative;
    width: min(100%, 640px);
    aspect-ratio: 13 / 10;
    /* En móvil la ilustración se queda con parte de la ventana para que la
       banda de abajo entre entera en el primer viewport. */
    max-height: 42svh;
  }
  .hero__lamina {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--dur-fade) var(--ease-out);
  }
  .hero__lamina[data-activa] { opacity: 1; }
  .hero__lamina :global(picture),
  .hero__lamina :global(img) { display: block; width: 100%; height: 100%; object-fit: contain; }

  .hero__frase {
    /* Se reserva una línea para que el control no baile al aparecer la frase
       corta, que son casi todas. Las dos largas sí desplazan el control, y es
       aceptable: ocurre como respuesta a una acción del propio usuario. */
    min-height: 1lh;
    max-width: 44ch;
    text-align: center;
    font-size: var(--body-sm-size);
    line-height: var(--body-sm-leading);
  }

  /* Cada palabra entra subiendo 6 px. El retardo lo pone el script en --i;
     aquí solo vive la forma. Sin rebote, por decisión. */
  .hero__frase :global(.palabra) {
    display: inline-block;
    opacity: 0;
    transform: translateY(6px);
    animation: entrada 500ms var(--ease-out) forwards;
    animation-delay: calc(var(--i) * 40ms);
  }
  @keyframes entrada { to { opacity: 1; transform: none; } }

  /* Reducir no es eliminar: la frase sigue apareciendo, pero de golpe. */
  @media (prefers-reduced-motion: reduce) {
    .hero__frase :global(.palabra) { animation: none; opacity: 1; transform: none; }
    .hero__lamina { transition: none; }
  }

  .hero__control {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-height: var(--touch-min);
    padding: var(--space-12) var(--space-16);
    background: none;
    border: 0;
    color: var(--link);
    font-size: var(--body-sm-size);
    line-height: var(--body-sm-leading);
    cursor: pointer;
    text-decoration: underline;
    text-decoration-thickness: var(--underline-rest);
    text-underline-offset: var(--underline-offset);
  }
  .hero__control:hover { text-decoration-thickness: var(--underline-hover); }
  /* El icono acompaña a la palabra, nunca va solo. */
  .hero__icono { font-size: 0.7em; }

  /* Sin JavaScript no hay rotación: queda la ilustración 1 y su frase, y el
     control no se pinta. */
  html:not(.js) .hero__control { display: none; }

  .hero__banda {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-16);
  }

  /* El titular NO es un display: va en el mismo cuerpo que las frases del
     carrusel. El nivel semántico y el tamaño visual son independientes —es
     un h1 aunque no sea el texto más grande de la página. */
  .hero__titular {
    font-size: var(--body-sm-size);
    line-height: var(--body-sm-leading);
    letter-spacing: 0;
    font-weight: 400;
    max-width: 70ch;
  }

  @media (min-width: 768px) {
    .hero { padding-block-end: var(--space-48); }
    .hero__pila { max-height: none; }
    .hero__banda {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      /* Hero Band en el Figma: gap 24. */
      gap: var(--space-24);
    }
  }

  /* Geometría del Figma (Home/Desktop 1440, 145:972): la ilustración es
     693 × 400 fija.

     Esto vive AQUÍ y no en home.css a propósito. Los estilos de un componente
     Astro salen con un atributo de scope —.hero__pila[data-astro-cid-…]— que
     tiene más especificidad que la misma clase suelta en una hoja aparte. Un
     ancho escrito en home.css para esta clase NO se aplica nunca: se queda ahí
     pareciendo que manda. Pasó el 07/10/2026 con esta misma regla, y la web
     salió a producción con 640 px en vez de 693. */
  @media (min-width: 1024px) {
    .hero__pila {
      width: 693px;
      max-width: none;
      aspect-ratio: 693 / 400;
    }
  }
</style>

<script>
  document.documentElement.classList.add('js');

  const INTERVALO = 1500;   // 1,5 s por imagen
  const PAUSA_POR = { usuario: 'usuario', puntero: 'puntero', foco: 'foco', fuera: 'fuera' } as const;

  document.querySelectorAll<HTMLElement>('[data-carrusel]').forEach((raiz) => {
    const laminas = Array.from(raiz.querySelectorAll<HTMLElement>('.hero__lamina'));
    const frase = raiz.querySelector<HTMLElement>('[data-carrusel-frase]');
    const control = raiz.querySelector<HTMLButtonElement>('[data-carrusel-control]');
    const etiqueta = raiz.querySelector<HTMLElement>('[data-carrusel-control-label]');
    const icono = raiz.querySelector<HTMLElement>('[data-carrusel-icono]');
    if (!laminas.length || !frase || !control || !etiqueta || !icono) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let indice = 0;
    let temporizador: number | null = null;
    /* Un conjunto de motivos, no un booleano: el puntero no puede reanudar
       algo que el usuario paró con el botón. */
    const motivos = new Set<string>([PAUSA_POR.fuera]);

    const parado = () => motivos.size > 0;

    function pintarFrase() {
      const activa = laminas[indice];
      const texto = activa.dataset.frase ?? '';
      const idioma = activa.dataset.fraseLang ?? document.documentElement.lang;
      frase!.textContent = '';
      // Fragmento en otro idioma: lang explícito o el lector lo pronuncia mal (3.1.2).
      if (idioma !== document.documentElement.lang) frase!.setAttribute('lang', idioma);
      else frase!.removeAttribute('lang');
      texto.split(' ').forEach((palabra, i) => {
        const span = document.createElement('span');
        span.className = 'palabra';
        span.style.setProperty('--i', String(i));
        span.textContent = palabra;
        frase!.append(span, document.createTextNode(' '));
      });
    }

    function limpiarFrase() {
      /* Vacía mientras rota: un aria-live disparando cada 1,5 s hace la
         página inutilizable con lector de pantalla. */
      frase!.textContent = '';
      frase!.removeAttribute('lang');
    }

    function mostrar(i: number) {
      laminas[indice]?.removeAttribute('data-activa');
      indice = (i + laminas.length) % laminas.length;
      laminas[indice].setAttribute('data-activa', '');
    }

    function arrancar() {
      if (temporizador !== null || reduce.matches) return;
      temporizador = window.setInterval(() => mostrar(indice + 1), INTERVALO);
    }

    function detener() {
      if (temporizador === null) return;
      // Pausar para el TEMPORIZADOR, no solo la animación.
      window.clearInterval(temporizador);
      temporizador = null;
    }

    function sincronizar() {
      if (parado()) {
        detener();
        pintarFrase();
      } else {
        limpiarFrase();
        arrancar();
      }
      // Mientras esté parado por cualquier motivo, la etiqueta es «Reproducir».
      const pausarTxt = control!.dataset.labelPausar ?? 'Pausar';
      const reproducirTxt = control!.dataset.labelReproducir ?? 'Reproducir';
      etiqueta!.textContent = parado() ? reproducirTxt : pausarTxt;
      icono!.textContent = parado() ? '▶' : '▌▌';
    }

    function pausar(motivo: string) { motivos.add(motivo); sincronizar(); }
    function reanudar(motivo: string) { motivos.delete(motivo); sincronizar(); }

    control.addEventListener('click', () => {
      if (motivos.has(PAUSA_POR.usuario)) reanudar(PAUSA_POR.usuario);
      else pausar(PAUSA_POR.usuario);
    });

    raiz.addEventListener('pointerenter', () => pausar(PAUSA_POR.puntero));
    raiz.addEventListener('pointerleave', () => reanudar(PAUSA_POR.puntero));
    // Paridad de teclado: enfocar dentro hace lo mismo que el puntero.
    raiz.addEventListener('focusin', () => pausar(PAUSA_POR.foco));
    raiz.addEventListener('focusout', (e) => {
      if (!raiz.contains(e.relatedTarget as Node)) reanudar(PAUSA_POR.foco);
    });

    // No arranca al cargar: arranca cuando se ve.
    const observador = new IntersectionObserver(
      (entradas) => entradas.forEach((e) => (e.isIntersecting ? reanudar(PAUSA_POR.fuera) : pausar(PAUSA_POR.fuera))),
      { threshold: 0.3 },
    );
    observador.observe(raiz);

    /* prefers-reduced-motion: ilustración 1 fija y sin autoavance. No basta
       con apagar la transición. */
    const aplicarReduce = () => {
      if (reduce.matches) { detener(); mostrar(0); pintarFrase(); }
      sincronizar();
    };
    reduce.addEventListener('change', aplicarReduce);
    aplicarReduce();
  });
</script>
