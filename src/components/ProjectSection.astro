---
/* ---------------------------------------------------------------------------
   Un proyecto destacado en la Home.

   La Home no sabe de qué proyecto se trata: la identidad visual viene del
   propio proyecto (`paleta` en su ficha). Cambiar de destacado es editar un
   campo, no rediseñar la portada.
   --------------------------------------------------------------------------- */
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/config';
import AccessibilityScore from './AccessibilityScore.astro';
import Disclosure from './Disclosure.astro';
import CtaLink from './CtaLink.astro';
import ProjectSlider from './ProjectSlider.astro';

interface Props { proyecto: CollectionEntry<'proyectos'>; lang: Lang }
const { proyecto, lang } = Astro.props;
const d = proyecto.data;
const id = `proyecto-${proyecto.id}`;
/* Cada caso tiene su composición en el Figma, no es el mismo bloque tres
   veces: Foc i Cor va en horizontal y los otros dos en vertical. */
const variante = proyecto.id.includes('foc') ? 'foc'
  : proyecto.id.includes('izaskun') ? 'izaskun' : 'eci';
/* Dónde va el enlace «Ir a …» en el ORDEN DEL DOCUMENTO. En ECI va antes de
   las capturas; en Foc i Cor e Izaskun, después. Así lo dibuja el Figma de
   Móvil 390, y en móvil el orden visual es el del DOM: si se reordenara con
   CSS, el tabulador iría del enlace a la pausa mientras la vista va de la
   pausa al enlace (2.4.3). En escritorio cada composición lo coloca con su
   área de rejilla, y el orden sigue teniendo sentido: en Izaskun el enlace
   está debajo del slider; en Foc i Cor se lee la columna de texto y luego
   las capturas. */
/* Desde el 04/11/2026 también en ECI va debajo del slider (Johnny): en los
   tres proyectos el enlace al caso cierra el bloque. */
const ctaAlFinal = true;
/* El enlace lleva al CASO, dentro de la web (Johnny, 03/11/2026); antes,
   «Ir a …» abría la web del cliente en otra pestaña. La web del cliente
   sigue enlazada desde la ficha del caso. Si el caso no está publicado,
   queda el enlace externo de antes. */
const enlaceCaso = d.casoPublicado ? `/proyectos/${proyecto.id}/` : null;
const destino = enlaceCaso ?? d.web;
const textoCta = enlaceCaso ? `Ver ${d.nombreCorto ?? d.titulo}` : `Ir a ${d.nombreCorto ?? d.titulo}`;
---

<section
  class:list={["proyecto", `proyecto--${variante}`]}
  aria-labelledby={`${id}-titulo`}
  style={`--acento: ${d.paleta.acento}; --texto-sobre-acento: ${d.paleta.textoSobreAcento}; --anillo: ${d.paleta.anilloFoco};`}
>
  <div class="proyecto__intro">
    <h2 id={`${id}-titulo`} class="proyecto__titulo">{d.titulo}</h2>
    <AccessibilityScore nota={d.nota} proyecto={d.titulo} />
  </div>

  <div class="proyecto__cuerpo">
    {/* El resumen admite cortes de línea fijos (un salto en la ficha). Cada
        línea es un <span>; en escritorio va en bloque y por debajo de 1024
        vuelve a fluir, porque un corte pensado para 660 de ancho deja
        renglones cojos en un móvil. El lector de pantalla oye un párrafo
        seguido en los dos casos. */}
    <p class="proyecto__resumen measure">
      {d.resumen.split('\n').map((l, i) => <>{i > 0 && ' '}<span class="linea">{l}</span></>)}
    </p>

    <Disclosure id={`${id}-mas`} contexto={d.titulo} lang={lang}>
      <div class="proyecto__ampliacion measure"><slot /></div>
    </Disclosure>

  </div>

  {/* El CTA es hijo DIRECTO de la sección, no del cuerpo: en Izaskun el
      documento lo coloca en la segunda columna, debajo del slider, y desde
      dentro del cuerpo no hay forma de llevarlo ahí sin romper el orden del
      DOM. Fuera, cada composición lo coloca con su área de rejilla. Va antes
      o después del slider según `ctaAlFinal` (arriba). */}
  {!ctaAlFinal && destino && (
    <div class="proyecto__cta">
      <CtaLink href={destino} external={!enlaceCaso}>{textoCta}</CtaLink>
    </div>
  )}

  {
    d.imagenes && d.imagenes.length > 0 && (
      <ProjectSlider imagenes={d.imagenes} variante={variante} titulo={d.titulo} lang={lang} />
    )
  }

  {ctaAlFinal && destino && (
    <div class="proyecto__cta">
      <CtaLink href={destino} external={!enlaceCaso}>{textoCta}</CtaLink>
    </div>
  )}
</section>

<style>
  /* ------------------------------------------------------------------------
     LAS TRES COMPOSICIONES, leídas del Figma `Producción · Home` (2239:573).

     No es el mismo bloque tres veces, y ese fue mi error del 09/10: medí los
     `Content slider` sueltos y di por hecho que los tres proyectos los
     colocaban igual. No. Cada caso tiene su maquetación y hay que respetarla.

     Coordenadas del documento a 1440, dentro de la columna de 1344 (márgenes
     de 48). El eje X va en % de 1344 para que escale con la ventana; el eje Y
     va en píxeles porque el documento los fija así.

       ECI · 145:976        apilado, todo a ancho completo
         copia   y 64              CTA y 300        slider y 401, 1344 × 900
       FOC · 2088:472       dos columnas, 680 | 664
         izquierda: copia y 380, CTA y 831
         derecha:   slider y 64, 664 × 820
       IZASKUN · 2094:510   texto en la columna derecha, slider estrecho, CTA a la derecha
         texto: resumen, «Leer más» y ampliación en x 684 w 660
         slider y 792, 1119 × 640      CTA alineado con la segunda columna
     ------------------------------------------------------------------------ */
  .proyecto {
    padding-inline: var(--gutter-page);
    display: flex;
    flex-direction: column;
  }

  .proyecto__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    /* Sin regla bajo el título: en el Figma no existe. El nombre va a la
       izquierda y el bloque de nota a la derecha, en la misma fila. */
  }

  /* Sin `font-weight`: hereda el 400 del sistema. Lo que separa el título del
     resumen no es el grosor, es el color. */
  .proyecto__titulo { font-size: var(--texto-size); line-height: var(--texto-leading); }

  /* El hueco entre las piezas del cuerpo es una variable porque el margen
     negativo del «Leer más» tiene que valer EXACTAMENTE lo mismo, con signo
     cambiado. Con un número a mano los dos se desincronizan: en Foc i Cor el
     hueco era 24 y el margen −48, y la palabra se montaba encima del último
     renglón del párrafo. */
  .proyecto__cuerpo {
    display: flex;
    flex-direction: column;
    --hueco-cuerpo: var(--space-48);
    gap: var(--hueco-cuerpo);
  }
  .proyecto--foc .proyecto__cuerpo { --hueco-cuerpo: var(--space-24); }

  /* «Leer más» pegado al párrafo, no flotando a 61 px (Johnny, 08/10). El
     botón conserva su relleno y sus 44 px de alto —el objetivo táctil no se
     toca—; lo que se retira es el hueco ÓPTICO.

     `:global` es obligatorio: `.disclosure` la declara OTRO componente, así que
     lleva el hash de scope de Disclosure.astro y no el de este archivo. Sin
     `:global`, Astro escribe `.disclosure[data-astro-cid-DE-ESTE]` y la regla
     se sirve al navegador sin aplicarse nunca (AGENTS.md §6). */
  .proyecto__cuerpo > :global(.disclosure) { margin-block-start: calc(var(--hueco-cuerpo) * -1); }

  /* En negro, como todo (Johnny, 09/10: «los textos en gris no aportan
     valor»). Lo que separa el título del resumen es el sitio: el título va en
     su propia fila, con la nota, y el resumen empieza 64 más abajo. */
  .proyecto__resumen,
  .proyecto__ampliacion {
    font-size: var(--texto-size);
    line-height: var(--texto-leading);
    /* Evita la palabra sola en el último renglón («obra.»). Donde el
       navegador no lo entiende, se ignora y el texto corta como siempre. */
    text-wrap: pretty;
  }
  /* Una línea en blanco entre párrafos: el hueco es el interlineado, no un
     número aparte, así que crece y encoge con el cuerpo de letra. */
  .proyecto__ampliacion :global(p + p) { margin-block-start: var(--texto-leading); }

  /* El 128 que separa este bloque del anterior, en todos los anchos. No hay
     relleno inferior: el aire de abajo es el 128 del bloque siguiente,
     declarado una vez. El hueco hasta el cuerpo lo pone el intro
     (--ritmo-intro, home.css); entre las piezas apiladas, 48. */
  .proyecto { margin-block-start: var(--ritmo-seccion); }
  .proyecto--eci .proyecto__cta,
  .proyecto--eci > :global(.slider) { margin-block-start: 48px; }

  /* Título a la izquierda y nota a la derecha desde tableta, como en
     escritorio: a 768 caben de sobra (308 + 298 en el Figma de Tablet). */
  @media (min-width: 768px) {
    .proyecto__intro {
      flex-direction: row;
      align-items: center;      /* SPACE_BETWEEN | CENTER en el Figma */
      justify-content: space-between;
      gap: var(--space-32);
    }
  }

  @media (min-width: 1024px) {
    .proyecto__resumen .linea { display: block; }

    /* ---- Foc i Cor · copia a la izquierda, slider a la derecha ---------- */
    .proyecto--foc {
      display: grid;
      /* 680 | 664 sobre 1344. El slider arranca en x=728, o sea a 680 del
         margen izquierdo. */
      grid-template-columns: calc(680 / 1344 * 100%) 1fr;
      grid-template-areas:
        "intro  intro"
        "cuerpo slider"
        "cta    slider";
      grid-template-rows: auto auto 1fr;
    }
    .proyecto--foc .proyecto__intro { grid-area: intro; }
    .proyecto--foc .proyecto__cuerpo {
      grid-area: cuerpo;
      /* La copia no está arriba: está a media altura del slider que tiene al
         lado. Eran 380 cuando el slider bajaba 64 por su propio margen; al
         quitárselo, la copia baja lo mismo para conservar la relación. */
      padding-block-start: 316px;
      /* El ancho de la copia es 579 de los 680 de la columna. */
      max-width: calc(579 / 680 * 100%);
    }
    /* El CTA se queda abajo del todo, terminando a la misma altura que el
       slider (y=884 en el documento). */
    .proyecto--foc .proyecto__cta { grid-area: cta; align-self: end; }
    .proyecto--foc :global(.slider) { grid-area: slider; }

    /* ---- Izaskun · texto a la derecha, slider estrecho, CTA a la derecha - */
    .proyecto--izaskun {
      display: grid;
      /* 684 | 660 sobre 1344. */
      grid-template-columns: calc(684 / 1344 * 100%) 1fr;
      grid-template-areas:
        "intro   intro"
        "cuerpo  ampliacion"
        "slider  slider"
        ".       cta";
      align-items: start;
      /* El margen negativo del «Leer más» es para la composición apilada; aquí
         el botón es un ítem de rejilla y lo descolocaría. */
    }
    .proyecto--izaskun .proyecto__intro { grid-area: intro; }
    /* Todo el texto en la SEGUNDA columna, de arriba abajo: resumen, «Leer
       más» y ampliación. La primera columna se queda vacía. Así está en el
       Figma (2094:525: el `Copy Inner` de la izquierda está vacío y la copia
       entera vive en x 684, 660 de ancho) y en la muestra de Johnny del
       09/10. Hasta hoy el resumen iba a la izquierda y la ampliación a la
       derecha.

       Dentro, el cuerpo se apila igual que en ECI y Foc i Cor, con el «Leer
       más» pegado al resumen por el margen negativo de arriba. */
    .proyecto--izaskun .proyecto__cuerpo {
      grid-column: 2;
      grid-row: 2;
      --hueco-cuerpo: var(--space-24);
    }
    /* El campo de Izaskun NO llega al margen derecho: mide 1119 de los 1344 y
       se alinea a la izquierda. Es lo que le da el desequilibrio que tiene en
       el documento. */
    .proyecto--izaskun :global(.slider) {
      grid-area: slider;
      justify-self: start;
      width: calc(1119 / 1344 * 100%);
      margin-block-start: 48px;
    }
    /* El CTA se alinea con la segunda columna de texto (x=732 en el documento,
       o sea 684 desde el margen). */
    .proyecto--izaskun .proyecto__cta { grid-area: cta; margin-block-start: 48px; }
  }

  /* Por debajo de 1024 los tres se apilan, con la copia encima del slider:
     el mismo ritmo que escritorio (10/10). Entre el intro y la copia, 64 (el
     relleno del intro); entre copia, enlace y campo de color, 48, igual que
     ECI e Izaskun en escritorio. El «Leer más» sigue pegado al resumen.

     En móvil el título y la nota van apilados, sin hueco: en una fila no
     caben. */
  @media (max-width: 1023px) {
    .proyecto__cta,
    .proyecto > :global(.slider) { margin-block-start: 48px; }
  }
  @media (max-width: 767px) {
    .proyecto__intro { gap: 0; }
  }
</style>
