---
/* ---------------------------------------------------------------------------
   Carcasa común. Header, footer, CTA y sistema de foco son lo que mantiene
   como una sola web tres tipos de contenido con reglas distintas.
   --------------------------------------------------------------------------- */
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/home.css';
import SkipLink from '../components/SkipLink.astro';
import Header from '../components/Header.astro';
import ContactCTA from '../components/ContactCTA.astro';
import GuiaCierre from '../components/GuiaCierre.astro';
import Footer from '../components/Footer.astro';
import { type Lang, type RouteKey } from '../i18n/config';
import { idiomaDe } from '../i18n/idioma';
import { CF_WEB_ANALYTICS_TOKEN } from '../data/analitica';
import { INDEXABLE } from '../data/sitio';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  current: RouteKey;
  slug?: string;
  /** El bloque de contacto se repite en todas las páginas menos en Contacto. */
  conCta?: boolean;
  /** Titular propio del cierre de Contacto (los casos). */
  ctaTitulo?: string;
}
const {
  title,
  description,
  lang = idiomaDe(Astro.url),
  current,
  slug,
  conCta = true,
  ctaTitulo,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- Sin user-scalable=no ni maximum-scale: el zoom es un derecho (1.4.4). -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Mientras la web viva en el .eu provisional (src/data/sitio.ts): noindex
        y SIN canonical. Juntos mandan señales contrarias a Google, y el
        canonical apuntaría a páginas del .com que hoy son el WordPress. */}
    {INDEXABLE ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light" />
    <!-- Favicon: el símbolo de AP SIN la marca CC del corazón, que a 16 px
         sería un punto (Johnny, 10/10). Sale de arte/estudio/icono.svg con el
         lienzo cuadrado. Tres archivos en public/ porque necesitan URL fija:
         el SVG para los navegadores actuales (en negro, y en Silk cuando la
         pestaña es oscura: con negro sobre una barra oscura no se veía); el
         .ico de 16/32/48 para los que no leen SVG y para quien pide
         /favicon.ico a ciegas; y el de iPhone, de 180 sobre blanco, porque
         iOS no admite transparencia en el icono de la pantalla de inicio.
         `sizes="32x32"` en el .ico para que Chrome prefiera el SVG. -->
    <!-- La clase `js` antes de pintar: lo que solo se anima con JavaScript
         (la entrada del titular de Estudio) no puede pintarse quieto y
         saltar después. Los scripts de los componentes la siguen poniendo
         también; repetirla no hace nada. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    {/* Si se llega por una transición de vista (cambiar de filtro en los
        listados), las tarjetas ya vienen moviéndose: su entrada no se repite
        (src/styles/listados.css). Tiene que estar aquí, antes de pintar:
        `pagereveal` salta con el primer fotograma. */}
    <script is:inline>addEventListener('pagereveal', (e) => { if (e.viewTransition) document.documentElement.dataset.llegada = 'transicion'; });</script>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- La tipografía latina se precarga: es la que pinta el primer texto que
         se ve, así que esperar a que el CSS la descubra cuesta un parpadeo. -->
    <link rel="preload" href="/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Cloudflare Web Analytics (Johnny, 11/10/2026): sin cookies, sin
         almacenamiento local y sin huella, así que no necesita banner. Solo
         se pinta si hay token (src/data/analitica.ts). Lo nombran
         Privacidad y Cookies. -->
    {
      CF_WEB_ANALYTICS_TOKEN && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: CF_WEB_ANALYTICS_TOKEN })}
        />
      )
    }
  </head>

  <body>
    <SkipLink lang={lang} />
    <Header lang={lang} current={current} slug={slug} />

    <!-- tabindex="-1": sin él el skip link mueve el foco a un elemento que no
         puede recibirlo y el salto no ocurre. Modo de fallo conocido n.º 4. -->
    <main id="contenido" tabindex="-1">
      <slot />
    </main>

    {/* La guía en vídeo antes del cierre, en todas menos en la suya (05/11/2026). */}
    {current !== 'guia' && <GuiaCierre lang={lang} />}
    {conCta && <ContactCTA lang={lang} titulo={ctaTitulo} />}
    <Footer lang={lang} />

    <script>
      import '../scripts/aparicion';
    </script>

    <style is:global>
      /* El destino del skip link no debe mostrar anillo de foco: el usuario no
         ha enfocado un control, solo ha aterrizado en la región. */
      main:focus { outline: none; }
    </style>
  </body>
</html>
